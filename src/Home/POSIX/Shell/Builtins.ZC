// Builtins.ZC - POSIX Shell Builtin Commands for ZealOS
// Part of ZealOS POSIX compatibility layer

// ============================================================================
// BASIC BUILTINS
// ============================================================================

// true - always succeed
I64 ShellBuiltinTrue(CShellState *sh, I64 argc, U8 **argv)
{
	return 0;
}

// false - always fail
I64 ShellBuiltinFalse(CShellState *sh, I64 argc, U8 **argv)
{
	return 1;
}

// : (colon) - no-op
I64 ShellBuiltinColon(CShellState *sh, I64 argc, U8 **argv)
{
	return 0;
}

// ============================================================================
// DIRECTORY BUILTINS
// ============================================================================

// cd - change directory
I64 ShellBuiltinCd(CShellState *sh, I64 argc, U8 **argv)
{
	U8 *dir;
	U8 *oldpwd;

	if (argc < 2) {
		// cd with no args goes to HOME
		dir = ShellGetVar(sh, "HOME");
		if (!dir) {
			"cd: HOME not set\n";
			return 1;
		}
	} else if (!StrCmp(argv[1], "-")) {
		// cd - goes to OLDPWD
		dir = ShellGetVar(sh, "OLDPWD");
		if (!dir) {
			"cd: OLDPWD not set\n";
			return 1;
		}
		"%s\n", dir;
	} else {
		dir = argv[1];
	}

	// Save current directory as OLDPWD
	oldpwd = ShellGetVar(sh, "PWD");
	if (oldpwd)
		ShellSetVar(sh, "OLDPWD", oldpwd);

	// Change directory
	if (PosixChdir(dir) < 0) {
		"cd: %s: %s\n", dir, PosixStrerror(posix_errno);
		return 1;
	}

	// Update PWD
	U8 cwd[1024];
	if (PosixGetcwd(cwd, sizeof(cwd)))
		ShellSetVar(sh, "PWD", cwd);

	return 0;
}

// pwd - print working directory
I64 ShellBuiltinPwd(CShellState *sh, I64 argc, U8 **argv)
{
	U8 cwd[1024];

	if (PosixGetcwd(cwd, sizeof(cwd))) {
		"%s\n", cwd;
		return 0;
	}

	"pwd: %s\n", PosixStrerror(posix_errno);
	return 1;
}

// ============================================================================
// ECHO
// ============================================================================

I64 ShellBuiltinEcho(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i = 1;
	Bool newline = TRUE;
	Bool interpret_escapes = FALSE;

	// Handle options
	while (i < argc && argv[i][0] == '-') {
		U8 *opt = argv[i] + 1;
		Bool valid = TRUE;
		while (*opt) {
			if (*opt == 'n')
				newline = FALSE;
			else if (*opt == 'e')
				interpret_escapes = TRUE;
			else if (*opt == 'E')
				interpret_escapes = FALSE;
			else {
				valid = FALSE;
				break;
			}
			opt++;
		}
		if (!valid)
			break;
		i++;
	}

	// Print arguments
	for (; i < argc; i++) {
		if (i > 1)
			" ";

		if (interpret_escapes) {
			U8 *p = argv[i];
			while (*p) {
				if (*p == '\\' && p[1]) {
					p++;
					switch (*p) {
						case 'n': "\n"; break;
						case 't': "\t"; break;
						case 'r': "\r"; break;
						case 'a': "\a"; break;
						case 'b': "\b"; break;
						case 'f': "\f"; break;
						case 'v': "\v"; break;
						case '\\': "\\"; break;
						case 'c': goto done;  // Stop output
						case '0': {
							// Octal
							I64 val = 0;
							I64 j;
							p++;
							for (j = 0; j < 3 && *p >= '0' && *p <= '7'; j++) {
								val = val * 8 + (*p - '0');
								p++;
							}
							p--;
							"%c", val;
							break;
						}
						default:
							"\\%c", *p;
					}
				} else {
					"%c", *p;
				}
				p++;
			}
		} else {
			"%s", argv[i];
		}
	}

done:
	if (newline)
		"\n";

	return 0;
}

// ============================================================================
// VARIABLE BUILTINS
// ============================================================================

// export - export variables
I64 ShellBuiltinExport(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;
	U8 *eq;

	if (argc < 2) {
		// List exported variables
		CShellVariable *var;
		for (var = sh->variables; var; var = var->next) {
			if (var->exported)
				"export %s=\"%s\"\n", var->name, var->value;
		}
		return 0;
	}

	for (i = 1; i < argc; i++) {
		eq = StrFirstOcc(argv[i], "=");
		if (eq) {
			// export VAR=value
			*eq = 0;
			ShellSetVar(sh, argv[i], eq + 1);
			ShellExportVar(sh, argv[i]);
			*eq = '=';
		} else {
			// export VAR
			ShellExportVar(sh, argv[i]);
		}
	}

	return 0;
}

// unset - unset variables or functions
I64 ShellBuiltinUnset(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;
	Bool unset_funcs = FALSE;
	Bool unset_vars = TRUE;

	// Parse options
	for (i = 1; i < argc; i++) {
		if (argv[i][0] != '-')
			break;
		if (!StrCmp(argv[i], "-v")) {
			unset_vars = TRUE;
			unset_funcs = FALSE;
		} else if (!StrCmp(argv[i], "-f")) {
			unset_funcs = TRUE;
			unset_vars = FALSE;
		}
	}

	for (; i < argc; i++) {
		if (unset_funcs)
			ShellUndefFunc(sh, argv[i]);
		if (unset_vars)
			ShellUnsetVar(sh, argv[i]);
	}

	return 0;
}

// set - set shell options or positional parameters
I64 ShellBuiltinSet(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;

	if (argc < 2) {
		// List all variables
		CShellVariable *var;
		for (var = sh->variables; var; var = var->next) {
			"%s=%s\n", var->name, var->value;
		}
		return 0;
	}

	// Parse options
	for (i = 1; i < argc; i++) {
		if (!StrCmp(argv[i], "--")) {
			i++;
			break;
		}
		if (argv[i][0] != '-' && argv[i][0] != '+')
			break;

		Bool enable = (argv[i][0] == '-');
		U8 *opt = argv[i] + 1;

		while (*opt) {
			switch (*opt) {
				case 'e': sh->errexit = enable; break;
				case 'u': sh->nounset = enable; break;
				case 'x': sh->xtrace = enable; break;
				case 'n': sh->noexec = enable; break;
				case 'C': sh->noclobber = enable; break;
				case 'a': sh->allexport = enable; break;
				default:
					"set: invalid option: -%c\n", *opt;
					return 1;
			}
			opt++;
		}
	}

	// Set positional parameters if any remaining args
	if (i < argc) {
		// Free old positional params
		if (sh->positional) {
			for (I64 j = 0; j < sh->positional_count; j++)
				if (sh->positional[j])
					Free(sh->positional[j]);
			Free(sh->positional);
		}

		sh->positional_count = argc - i;
		sh->positional = MAlloc(sh->positional_count * sizeof(U8*));
		for (I64 j = 0; j < sh->positional_count; j++)
			sh->positional[j] = StrNew(argv[i + j]);
	}

	return 0;
}

// shift - shift positional parameters
I64 ShellBuiltinShift(CShellState *sh, I64 argc, U8 **argv)
{
	I64 n = 1;

	if (argc > 1)
		n = Str2I64(argv[1]);

	if (n < 0 || n > sh->positional_count) {
		"shift: can't shift that many\n";
		return 1;
	}

	// Free shifted parameters
	for (I64 i = 0; i < n; i++)
		if (sh->positional[i])
			Free(sh->positional[i]);

	// Move remaining parameters
	for (I64 i = 0; i < sh->positional_count - n; i++)
		sh->positional[i] = sh->positional[i + n];

	sh->positional_count -= n;

	return 0;
}

// ============================================================================
// READ
// ============================================================================

I64 ShellBuiltinRead(CShellState *sh, I64 argc, U8 **argv)
{
	U8 line[4096];
	U8 *p, *start;
	I64 i;
	U8 *ifs;

	if (argc < 2) {
		"read: missing variable name\n";
		return 1;
	}

	// Read a line
	if (!GetS(line, sizeof(line)))
		return 1;

	// Get IFS
	ifs = ShellGetVar(sh, "IFS");
	if (!ifs)
		ifs = " \t\n";

	// Parse into variables
	p = line;
	for (i = 1; i < argc; i++) {
		// Skip leading IFS
		while (*p && StrFirstOcc(ifs, p))
			p++;

		start = p;

		if (i == argc - 1) {
			// Last variable gets rest of line
			ShellSetVar(sh, argv[i], start);
		} else {
			// Find end of word
			while (*p && !StrFirstOcc(ifs, p))
				p++;

			if (*p) {
				*p = 0;
				p++;
			}

			ShellSetVar(sh, argv[i], start);
		}
	}

	return 0;
}

// ============================================================================
// TEST / [
// ============================================================================

I64 ShellBuiltinTest(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i = 1;
	Bool result = FALSE;

	// Handle [ command requiring ]
	if (!StrCmp(argv[0], "[")) {
		if (argc < 2 || StrCmp(argv[argc - 1], "]")) {
			"[: missing ]\n";
			return 2;
		}
		argc--;  // Don't process ]
	}

	if (argc < 2)
		return 1;  // Empty test is false

	// Single argument - true if non-empty string
	if (argc == 2) {
		return argv[1][0] ? 0 : 1;
	}

	// Unary operators
	if (argc == 3) {
		if (!StrCmp(argv[1], "-n"))
			return argv[2][0] ? 0 : 1;
		if (!StrCmp(argv[1], "-z"))
			return argv[2][0] ? 1 : 0;
		if (!StrCmp(argv[1], "!"))
			return argv[2][0] ? 1 : 0;

		// File tests
		if (!StrCmp(argv[1], "-e") || !StrCmp(argv[1], "-a"))
			return PosixAccess(argv[2], F_OK) == 0 ? 0 : 1;
		if (!StrCmp(argv[1], "-f")) {
			CPosixStat st;
			if (PosixStat(argv[2], &st) < 0)
				return 1;
			return S_ISREG(st.st_mode) ? 0 : 1;
		}
		if (!StrCmp(argv[1], "-d")) {
			CPosixStat st;
			if (PosixStat(argv[2], &st) < 0)
				return 1;
			return S_ISDIR(st.st_mode) ? 0 : 1;
		}
		if (!StrCmp(argv[1], "-r"))
			return PosixAccess(argv[2], R_OK) == 0 ? 0 : 1;
		if (!StrCmp(argv[1], "-w"))
			return PosixAccess(argv[2], W_OK) == 0 ? 0 : 1;
		if (!StrCmp(argv[1], "-x"))
			return PosixAccess(argv[2], X_OK) == 0 ? 0 : 1;
		if (!StrCmp(argv[1], "-s")) {
			CPosixStat st;
			if (PosixStat(argv[2], &st) < 0)
				return 1;
			return st.st_size > 0 ? 0 : 1;
		}
	}

	// Binary operators
	if (argc == 4) {
		if (!StrCmp(argv[2], "=") || !StrCmp(argv[2], "=="))
			return !StrCmp(argv[1], argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "!="))
			return StrCmp(argv[1], argv[3]) ? 0 : 1;

		// Numeric comparisons
		if (!StrCmp(argv[2], "-eq"))
			return Str2I64(argv[1]) == Str2I64(argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "-ne"))
			return Str2I64(argv[1]) != Str2I64(argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "-lt"))
			return Str2I64(argv[1]) < Str2I64(argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "-le"))
			return Str2I64(argv[1]) <= Str2I64(argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "-gt"))
			return Str2I64(argv[1]) > Str2I64(argv[3]) ? 0 : 1;
		if (!StrCmp(argv[2], "-ge"))
			return Str2I64(argv[1]) >= Str2I64(argv[3]) ? 0 : 1;
	}

	"test: too many arguments\n";
	return 2;
}

// ============================================================================
// SOURCE / .
// ============================================================================

I64 ShellBuiltinSource(CShellState *sh, I64 argc, U8 **argv)
{
	if (argc < 2) {
		"source: missing filename\n";
		return 1;
	}

	return ShellRunFile(sh, argv[1]);
}

// ============================================================================
// EXEC
// ============================================================================

I64 ShellBuiltinExec(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;

	if (argc < 2)
		return 0;

	// Handle redirections only (exec with no command but redirections)
	// TODO: implement exec redirections

	// Execute command replacing shell
	return PosixExecvp(argv[1], &argv[1]);
}

// ============================================================================
// EVAL
// ============================================================================

I64 ShellBuiltinEval(CShellState *sh, I64 argc, U8 **argv)
{
	U8 *cmd;
	I64 len = 0;
	I64 i;
	I64 status;

	if (argc < 2)
		return 0;

	// Calculate total length
	for (i = 1; i < argc; i++)
		len += StrLen(argv[i]) + 1;

	// Build command string
	cmd = MAlloc(len + 1);
	cmd[0] = 0;
	for (i = 1; i < argc; i++) {
		if (i > 1)
			StrCat(cmd, " ");
		StrCat(cmd, argv[i]);
	}

	// Execute
	status = ShellRun(sh, cmd);
	Free(cmd);

	return status;
}

// ============================================================================
// EXIT
// ============================================================================

I64 ShellBuiltinExit(CShellState *sh, I64 argc, U8 **argv)
{
	I64 status = sh->last_status;

	if (argc > 1)
		status = Str2I64(argv[1]);

	PosixExit(status);
	return status;  // Won't reach here
}

// ============================================================================
// WAIT
// ============================================================================

I64 ShellBuiltinWait(CShellState *sh, I64 argc, U8 **argv)
{
	I64 status;
	I64 pid;

	if (argc > 1) {
		pid = Str2I64(argv[1]);
		PosixWaitpid(pid, &status, 0);
	} else {
		// Wait for all children
		while (PosixWait(&status) > 0)
			;
	}

	return status;
}

// ============================================================================
// KILL
// ============================================================================

I64 ShellBuiltinKill(CShellState *sh, I64 argc, U8 **argv)
{
	I64 sig = SIGTERM;
	I64 i = 1;

	if (argc < 2) {
		"kill: usage: kill [-signal] pid...\n";
		return 1;
	}

	// Check for signal specification
	if (argv[1][0] == '-') {
		if (argv[1][1] >= '0' && argv[1][1] <= '9') {
			sig = Str2I64(argv[1] + 1);
		} else {
			// Signal name
			U8 *name = argv[1] + 1;
			if (!StrICmp(name, "HUP")) sig = SIGHUP;
			else if (!StrICmp(name, "INT")) sig = SIGINT;
			else if (!StrICmp(name, "QUIT")) sig = SIGQUIT;
			else if (!StrICmp(name, "KILL")) sig = SIGKILL;
			else if (!StrICmp(name, "TERM")) sig = SIGTERM;
			else if (!StrICmp(name, "STOP")) sig = SIGSTOP;
			else if (!StrICmp(name, "CONT")) sig = SIGCONT;
			else if (!StrICmp(name, "USR1")) sig = SIGUSR1;
			else if (!StrICmp(name, "USR2")) sig = SIGUSR2;
			else {
				"kill: unknown signal: %s\n", name;
				return 1;
			}
		}
		i++;
	}

	for (; i < argc; i++) {
		I64 pid = Str2I64(argv[i]);
		if (PosixKill(pid, sig) < 0) {
			"kill: (%d) - %s\n", pid, PosixStrerror(posix_errno);
			return 1;
		}
	}

	return 0;
}

