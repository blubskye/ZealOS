// ============================================================================
// TYPE
// ============================================================================

I64 ShellBuiltinType(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;
	I64 status = 0;

	for (i = 1; i < argc; i++) {
		U8 *name = argv[i];

		// Check builtin
		if (ShellFindBuiltin(name)) {
			"%s is a shell builtin\n", name;
			continue;
		}

		// Check function
		if (ShellGetFunc(sh, name)) {
			"%s is a function\n", name;
			continue;
		}

		// Check alias
		U8 *alias = ShellGetAlias(sh, name);
		if (alias) {
			"%s is aliased to '%s'\n", name, alias;
			continue;
		}

		// Check PATH
		U8 *path = ShellGetVar(sh, "PATH");
		if (path) {
			U8 pathbuf[1024];
			U8 fullpath[1024];
			StrCpy(pathbuf, path);

			U8 *dir = pathbuf;
			while (*dir) {
				U8 *next = StrFirstOcc(dir, ":");
				if (next)
					*next = 0;

				StrPrint(fullpath, "%s/%s", dir, name);
				if (PosixAccess(fullpath, X_OK) == 0) {
					"%s is %s\n", name, fullpath;
					goto next_arg;
				}

				if (next)
					dir = next + 1;
				else
					break;
			}
		}

		"%s not found\n", name;
		status = 1;

next_arg:
		;
	}

	return status;
}

// ============================================================================
// ALIAS / UNALIAS
// ============================================================================

I64 ShellBuiltinAlias(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;

	if (argc < 2) {
		// List all aliases
		CShellAlias *alias;
		for (alias = sh->aliases; alias; alias = alias->next) {
			"alias %s='%s'\n", alias->name, alias->value;
		}
		return 0;
	}

	for (i = 1; i < argc; i++) {
		U8 *eq = StrFirstOcc(argv[i], "=");
		if (eq) {
			*eq = 0;
			ShellSetAlias(sh, argv[i], eq + 1);
			*eq = '=';
		} else {
			U8 *val = ShellGetAlias(sh, argv[i]);
			if (val)
				"alias %s='%s'\n", argv[i], val;
			else
				"alias: %s not found\n", argv[i];
		}
	}

	return 0;
}

I64 ShellBuiltinUnalias(CShellState *sh, I64 argc, U8 **argv)
{
	I64 i;
	I64 status = 0;

	if (argc < 2) {
		"unalias: usage: unalias name...\n";
		return 1;
	}

	// Check for -a (remove all)
	if (!StrCmp(argv[1], "-a")) {
		while (sh->aliases) {
			CShellAlias *next = sh->aliases->next;
			if (sh->aliases->name) Free(sh->aliases->name);
			if (sh->aliases->value) Free(sh->aliases->value);
			Free(sh->aliases);
			sh->aliases = next;
		}
		return 0;
	}

	for (i = 1; i < argc; i++) {
		if (ShellUnsetAlias(sh, argv[i]) < 0) {
			"unalias: %s not found\n", argv[i];
			status = 1;
		}
	}

	return status;
}

// ============================================================================
// JOB CONTROL
// ============================================================================

I64 ShellBuiltinJobs(CShellState *sh, I64 argc, U8 **argv)
{
	CShellJob *job;

	for (job = sh->jobs; job; job = job->next) {
		U8 *state;
		switch (job->status) {
			case JOB_RUNNING: state = "Running"; break;
			case JOB_STOPPED: state = "Stopped"; break;
			case JOB_DONE:    state = "Done"; break;
			default:          state = "Unknown"; break;
		}
		"[%d] %s\t%s\n", job->id, state, job->command;
	}

	return 0;
}

I64 ShellBuiltinFg(CShellState *sh, I64 argc, U8 **argv)
{
	CShellJob *job;
	I64 job_id;

	if (argc > 1) {
		// Parse %N or N
		U8 *arg = argv[1];
		if (arg[0] == '%')
			arg++;
		job_id = Str2I64(arg);
	} else {
		// Use most recent job
		job_id = sh->next_job_id - 1;
	}

	// Find job
	for (job = sh->jobs; job; job = job->next) {
		if (job->id == job_id) {
			// Resume job
			if (job->status == JOB_STOPPED) {
				PosixKill(-job->pgid, SIGCONT);
			}

			// Wait for it
			I64 status;
			for (I64 i = 0; i < job->pid_count; i++) {
				PosixWaitpid(job->pids[i], &status, 0);
			}

			return status;
		}
	}

	"fg: %d: no such job\n", job_id;
	return 1;
}

I64 ShellBuiltinBg(CShellState *sh, I64 argc, U8 **argv)
{
	CShellJob *job;
	I64 job_id;

	if (argc > 1) {
		U8 *arg = argv[1];
		if (arg[0] == '%')
			arg++;
		job_id = Str2I64(arg);
	} else {
		job_id = sh->next_job_id - 1;
	}

	// Find job
	for (job = sh->jobs; job; job = job->next) {
		if (job->id == job_id) {
			if (job->status == JOB_STOPPED) {
				PosixKill(-job->pgid, SIGCONT);
				job->status = JOB_RUNNING;
				"[%d] %s &\n", job->id, job->command;
			}
			return 0;
		}
	}

	"bg: %d: no such job\n", job_id;
	return 1;
}
