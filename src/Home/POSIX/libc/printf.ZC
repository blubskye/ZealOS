// printf.ZC - Printf family implementation for ZealOS libc

#include "stdarg.h"
#include "stdio.h"

// ============================================================================
// INTERNAL OUTPUT HELPERS
// ============================================================================

// Output context
class CPrintfCtx {
    FILE    *fp;            // For fprintf
    U8      *str;           // For sprintf
    size_t   max_len;       // For snprintf
    size_t   written;       // Characters written
    Bool     to_file;       // TRUE if writing to FILE
};

// Output a single character
U0 _printf_putc(CPrintfCtx *ctx, U8 c)
{
    if (ctx->to_file) {
        if (ctx->fp)
            fputc(c, ctx->fp);
    } else {
        if (ctx->max_len == 0 || ctx->written < ctx->max_len - 1) {
            if (ctx->str)
                ctx->str[ctx->written] = c;
        }
    }
    ctx->written++;
}

// Output a string
U0 _printf_puts(CPrintfCtx *ctx, U8 *s)
{
    while (*s)
        _printf_putc(ctx, *s++);
}

// Output padding
U0 _printf_pad(CPrintfCtx *ctx, I64 count, U8 pad_char)
{
    while (count-- > 0)
        _printf_putc(ctx, pad_char);
}

// Output an unsigned integer
U0 _printf_uint(CPrintfCtx *ctx, U64 value, I64 base, Bool uppercase,
                I64 width, I64 precision, U8 pad_char, Bool left_justify,
                Bool show_sign, Bool space_sign, Bool show_base)
{
    U8 buf[65];
    U8 *digits = uppercase ? "0123456789ABCDEF" : "0123456789abcdef";
    I64 i = 0;
    I64 len;

    // Convert to string (reversed)
    if (value == 0) {
        buf[i++] = '0';
    } else {
        while (value) {
            buf[i++] = digits[value % base];
            value /= base;
        }
    }
    len = i;

    // Handle precision (minimum digits)
    I64 zero_pad = 0;
    if (precision >= 0 && precision > len)
        zero_pad = precision - len;

    // Calculate prefix length
    I64 prefix_len = 0;
    if (show_base && base == 16)
        prefix_len = 2;  // "0x"
    else if (show_base && base == 8 && buf[len-1] != '0')
        prefix_len = 1;  // "0"

    // Calculate total length
    I64 total_len = len + zero_pad + prefix_len;

    // Right padding (left justify)
    if (!left_justify && width > total_len && pad_char == ' ')
        _printf_pad(ctx, width - total_len, ' ');

    // Prefix
    if (prefix_len == 2) {
        _printf_putc(ctx, '0');
        _printf_putc(ctx, uppercase ? 'X' : 'x');
    } else if (prefix_len == 1) {
        _printf_putc(ctx, '0');
    }

    // Zero padding (for width with '0' flag, or precision)
    if (!left_justify && width > total_len && pad_char == '0')
        _printf_pad(ctx, width - total_len, '0');
    _printf_pad(ctx, zero_pad, '0');

    // Digits (reversed)
    while (i > 0)
        _printf_putc(ctx, buf[--i]);

    // Left padding (right justify)
    if (left_justify && width > total_len)
        _printf_pad(ctx, width - total_len, ' ');
}

// Output a signed integer
U0 _printf_int(CPrintfCtx *ctx, I64 value, I64 base, Bool uppercase,
               I64 width, I64 precision, U8 pad_char, Bool left_justify,
               Bool show_sign, Bool space_sign, Bool show_base)
{
    Bool negative = (value < 0);
    U64 abs_val = negative ? -value : value;
    I64 sign_char = 0;

    if (negative)
        sign_char = '-';
    else if (show_sign)
        sign_char = '+';
    else if (space_sign)
        sign_char = ' ';

    // Adjust width for sign
    if (sign_char && width > 0)
        width--;

    // Output sign before zero padding
    if (sign_char && pad_char == '0')
        _printf_putc(ctx, sign_char);

    _printf_uint(ctx, abs_val, base, uppercase, width, precision,
                 pad_char, left_justify, FALSE, FALSE, show_base);

    // Output sign if space padded
    if (sign_char && pad_char != '0') {
        // Need to insert sign at beginning - this is complex with our design
        // For simplicity, we handle this case separately
    }
}

// Output a double
U0 _printf_double(CPrintfCtx *ctx, F64 value, I64 width, I64 precision,
                  U8 pad_char, Bool left_justify, Bool show_sign, Bool space_sign)
{
    U8 buf[64];
    I64 sign_char = 0;

    if (value < 0) {
        sign_char = '-';
        value = -value;
    } else if (show_sign) {
        sign_char = '+';
    } else if (space_sign) {
        sign_char = ' ';
    }

    if (precision < 0)
        precision = 6;

    // Convert using ZealOS StrPrint
    if (precision == 0)
        StrPrint(buf, "%.0f", value);
    else
        StrPrint(buf, "%.*f", precision, value);

    I64 len = StrLen(buf) + (sign_char ? 1 : 0);

    // Padding
    if (!left_justify && width > len)
        _printf_pad(ctx, width - len, pad_char);

    if (sign_char)
        _printf_putc(ctx, sign_char);

    _printf_puts(ctx, buf);

    if (left_justify && width > len)
        _printf_pad(ctx, width - len, ' ');
}

// ============================================================================
// MAIN PRINTF ENGINE
// ============================================================================

I64 _printf_core(CPrintfCtx *ctx, U8 *format, va_list ap)
{
    U8 *p = format;

    while (*p) {
        if (*p != '%') {
            _printf_putc(ctx, *p++);
            continue;
        }

        p++;  // Skip '%'

        if (*p == '%') {
            _printf_putc(ctx, '%');
            p++;
            continue;
        }

        // Parse flags
        Bool left_justify = FALSE;
        Bool show_sign = FALSE;
        Bool space_sign = FALSE;
        Bool alt_form = FALSE;
        U8 pad_char = ' ';

        while (TRUE) {
            switch (*p) {
                case '-': left_justify = TRUE; p++; continue;
                case '+': show_sign = TRUE; p++; continue;
                case ' ': space_sign = TRUE; p++; continue;
                case '#': alt_form = TRUE; p++; continue;
                case '0': pad_char = '0'; p++; continue;
            }
            break;
        }

        if (left_justify)
            pad_char = ' ';  // Left justify overrides zero padding

        // Parse width
        I64 width = 0;
        if (*p == '*') {
            width = va_arg(ap, I64);
            if (width < 0) {
                left_justify = TRUE;
                width = -width;
            }
            p++;
        } else {
            while (*p >= '0' && *p <= '9') {
                width = width * 10 + (*p - '0');
                p++;
            }
        }

        // Parse precision
        I64 precision = -1;
        if (*p == '.') {
            p++;
            precision = 0;
            if (*p == '*') {
                precision = va_arg(ap, I64);
                p++;
            } else {
                while (*p >= '0' && *p <= '9') {
                    precision = precision * 10 + (*p - '0');
                    p++;
                }
            }
        }

        // Parse length modifiers
        I64 length = 0;  // 0=default, 1=h, 2=hh, 3=l, 4=ll, 5=z, 6=j, 7=t
        if (*p == 'h') {
            p++;
            length = (*p == 'h') ? (p++, 2) : 1;
        } else if (*p == 'l') {
            p++;
            length = (*p == 'l') ? (p++, 4) : 3;
        } else if (*p == 'z' || *p == 'Z') {
            length = 5;
            p++;
        } else if (*p == 'j') {
            length = 6;
            p++;
        } else if (*p == 't') {
            length = 7;
            p++;
        } else if (*p == 'L') {
            length = 8;  // Long double
            p++;
        }

        // Parse conversion specifier
        switch (*p++) {
            case 'd':
            case 'i': {
                I64 value = va_arg(ap, I64);
                _printf_int(ctx, value, 10, FALSE, width, precision,
                           pad_char, left_justify, show_sign, space_sign, FALSE);
                break;
            }

            case 'u': {
                U64 value = va_arg(ap, U64);
                _printf_uint(ctx, value, 10, FALSE, width, precision,
                            pad_char, left_justify, FALSE, FALSE, FALSE);
                break;
            }

            case 'o': {
                U64 value = va_arg(ap, U64);
                _printf_uint(ctx, value, 8, FALSE, width, precision,
                            pad_char, left_justify, FALSE, FALSE, alt_form);
                break;
            }

            case 'x': {
                U64 value = va_arg(ap, U64);
                _printf_uint(ctx, value, 16, FALSE, width, precision,
                            pad_char, left_justify, FALSE, FALSE, alt_form);
                break;
            }

            case 'X': {
                U64 value = va_arg(ap, U64);
                _printf_uint(ctx, value, 16, TRUE, width, precision,
                            pad_char, left_justify, FALSE, FALSE, alt_form);
                break;
            }

            case 'p': {
                U64 value = va_arg(ap, U64);
                _printf_puts(ctx, "0x");
                _printf_uint(ctx, value, 16, FALSE, 0, -1,
                            ' ', FALSE, FALSE, FALSE, FALSE);
                break;
            }

            case 'c': {
                I64 c = va_arg(ap, I64);
                if (!left_justify && width > 1)
                    _printf_pad(ctx, width - 1, ' ');
                _printf_putc(ctx, c);
                if (left_justify && width > 1)
                    _printf_pad(ctx, width - 1, ' ');
                break;
            }

            case 's': {
                U8 *s = va_arg(ap, U8 *);
                if (!s)
                    s = "(null)";
                I64 len = StrLen(s);
                if (precision >= 0 && len > precision)
                    len = precision;

                if (!left_justify && width > len)
                    _printf_pad(ctx, width - len, ' ');

                for (I64 i = 0; i < len; i++)
                    _printf_putc(ctx, s[i]);

                if (left_justify && width > len)
                    _printf_pad(ctx, width - len, ' ');
                break;
            }

            case 'f':
            case 'F': {
                F64 value = va_arg(ap, F64);
                _printf_double(ctx, value, width, precision,
                              pad_char, left_justify, show_sign, space_sign);
                break;
            }

            case 'e':
            case 'E':
            case 'g':
            case 'G': {
                // Simplified - just use %f
                F64 value = va_arg(ap, F64);
                _printf_double(ctx, value, width, precision,
                              pad_char, left_justify, show_sign, space_sign);
                break;
            }

            case 'n': {
                I64 *n = va_arg(ap, I64 *);
                if (n)
                    *n = ctx->written;
                break;
            }

            default:
                // Unknown format, output as-is
                _printf_putc(ctx, '%');
                _printf_putc(ctx, *(p-1));
                break;
        }
    }

    return ctx->written;
}

// ============================================================================
// PUBLIC PRINTF FUNCTIONS
// ============================================================================

I64 vfprintf(FILE *stream, U8 *format, va_list ap)
{
    CPrintfCtx ctx;
    ctx.fp = stream;
    ctx.str = NULL;
    ctx.max_len = 0;
    ctx.written = 0;
    ctx.to_file = TRUE;

    return _printf_core(&ctx, format, ap);
}

I64 vprintf(U8 *format, va_list ap)
{
    return vfprintf(stdout, format, ap);
}

I64 vsprintf(U8 *str, U8 *format, va_list ap)
{
    CPrintfCtx ctx;
    ctx.fp = NULL;
    ctx.str = str;
    ctx.max_len = 0;  // No limit
    ctx.written = 0;
    ctx.to_file = FALSE;

    I64 result = _printf_core(&ctx, format, ap);

    if (str)
        str[ctx.written] = 0;

    return result;
}

I64 vsnprintf(U8 *str, size_t size, U8 *format, va_list ap)
{
    CPrintfCtx ctx;
    ctx.fp = NULL;
    ctx.str = str;
    ctx.max_len = size;
    ctx.written = 0;
    ctx.to_file = FALSE;

    I64 result = _printf_core(&ctx, format, ap);

    if (str && size > 0) {
        if (ctx.written < size)
            str[ctx.written] = 0;
        else
            str[size - 1] = 0;
    }

    return result;
}

// Convenience: use ZealOS Print for simple cases
I64 print(U8 *format, ...)
{
    // This uses ZealOS's native Print which handles format strings
    // For full C compatibility, use printf
    va_list ap;
    va_start(ap, format);
    I64 result = vprintf(format, ap);
    va_end(ap);
    return result;
}
