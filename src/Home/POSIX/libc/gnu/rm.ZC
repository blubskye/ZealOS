// rm.ZC - GNU coreutils 'rm' implementation
// Remove files or directories

// C-style main function
I64 rm_main(I64 argc, U8 **argv)
{
    Bool force = FALSE;         // -f
    Bool interactive = FALSE;   // -i
    Bool recursive = FALSE;     // -r/-R
    Bool verbose = FALSE;       // -v
    Bool dir = FALSE;           // -d (remove empty dirs)
    I64 start = 1;

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: rm [OPTION]... [FILE]...\n");
            printf("Remove (unlink) the FILE(s).\n\n");
            printf("  -f, --force           ignore nonexistent files, never prompt\n");
            printf("  -i                    prompt before every removal\n");
            printf("  -r, -R, --recursive   remove directories and their contents recursively\n");
            printf("  -d, --dir             remove empty directories\n");
            printf("  -v, --verbose         explain what is being done\n");
            printf("      --help            display this help and exit\n");
            printf("      --version         output version information and exit\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("rm (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-f") == 0 || strcmp(arg, "--force") == 0) {
            force = TRUE;
            interactive = FALSE;
            start++;
            continue;
        }

        if (strcmp(arg, "-i") == 0) {
            interactive = TRUE;
            force = FALSE;
            start++;
            continue;
        }

        if (strcmp(arg, "-r") == 0 || strcmp(arg, "-R") == 0 ||
            strcmp(arg, "--recursive") == 0) {
            recursive = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-d") == 0 || strcmp(arg, "--dir") == 0) {
            dir = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-v") == 0 || strcmp(arg, "--verbose") == 0) {
            verbose = TRUE;
            start++;
            continue;
        }

        // Combined short options
        if (arg[0] == '-' && arg[1] != '-') {
            for (I64 i = 1; arg[i]; i++) {
                switch (arg[i]) {
                    case 'f': force = TRUE; interactive = FALSE; break;
                    case 'i': interactive = TRUE; force = FALSE; break;
                    case 'r':
                    case 'R': recursive = TRUE; break;
                    case 'd': dir = TRUE; break;
                    case 'v': verbose = TRUE; break;
                    default:
                        fprintf(stderr, "rm: invalid option -- '%c'\n", arg[i]);
                        return 1;
                }
            }
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        break;
    }

    if (start >= argc) {
        if (!force) {
            fprintf(stderr, "rm: missing operand\n");
            return 1;
        }
        return 0;
    }

    I64 exit_status = 0;

    // Forward declaration for recursive removal
    I64 rm_recursive(U8 *path, Bool force, Bool verbose);

    // Remove a single file or directory
    auto rm_one = [&exit_status](U8 *path, Bool force, Bool interactive,
                                  Bool recursive, Bool dir, Bool verbose) -> I64 {
        CPosixStat st;

        // Check if path exists
        if (PosixStat(path, &st) < 0) {
            if (!force) {
                fprintf(stderr, "rm: cannot remove '%s': %s\n", path, strerror(errno));
                return -1;
            }
            return 0;
        }

        // Interactive prompt
        if (interactive) {
            printf("rm: remove '%s'? ", path);
            I64 c = getchar();
            I64 response = c;
            while (c != '\n' && c != EOF)
                c = getchar();
            if (response != 'y' && response != 'Y')
                return 0;
        }

        // Check if it's a directory
        if (S_ISDIR(st.st_mode)) {
            if (!recursive && !dir) {
                fprintf(stderr, "rm: cannot remove '%s': Is a directory\n", path);
                return -1;
            }

            if (recursive) {
                return rm_recursive(path, force, verbose);
            } else {
                // Just try to remove empty directory
                if (PosixRmdir(path) < 0) {
                    if (!force) {
                        fprintf(stderr, "rm: cannot remove '%s': %s\n", path, strerror(errno));
                        return -1;
                    }
                } else if (verbose) {
                    printf("removed directory '%s'\n", path);
                }
            }
        } else {
            // Regular file
            if (PosixUnlink(path) < 0) {
                if (!force) {
                    fprintf(stderr, "rm: cannot remove '%s': %s\n", path, strerror(errno));
                    return -1;
                }
            } else if (verbose) {
                printf("removed '%s'\n", path);
            }
        }

        return 0;
    };

    // Recursive removal
    rm_recursive = [&rm_one](U8 *path, Bool force, Bool verbose) -> I64 {
        I64 dir_fd = PosixOpenDir(path);
        if (dir_fd < 0) {
            if (!force) {
                fprintf(stderr, "rm: cannot open directory '%s': %s\n", path, strerror(errno));
                return -1;
            }
            return 0;
        }

        CPosixDirent *entry;
        U8 child_path[PATH_MAX];

        while ((entry = PosixReadDir(dir_fd)) != NULL) {
            if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0)
                continue;

            snprintf(child_path, PATH_MAX, "%s/%s", path, entry->d_name);

            CPosixStat st;
            if (PosixStat(child_path, &st) < 0)
                continue;

            if (S_ISDIR(st.st_mode)) {
                rm_recursive(child_path, force, verbose);
            } else {
                if (PosixUnlink(child_path) < 0) {
                    if (!force) {
                        fprintf(stderr, "rm: cannot remove '%s': %s\n", child_path, strerror(errno));
                    }
                } else if (verbose) {
                    printf("removed '%s'\n", child_path);
                }
            }
        }

        PosixCloseDir(dir_fd);

        // Now remove the directory itself
        if (PosixRmdir(path) < 0) {
            if (!force) {
                fprintf(stderr, "rm: cannot remove '%s': %s\n", path, strerror(errno));
                return -1;
            }
        } else if (verbose) {
            printf("removed directory '%s'\n", path);
        }

        return 0;
    };

    for (I64 i = start; i < argc; i++) {
        if (rm_one(argv[i], force, interactive, recursive, dir, verbose) < 0)
            exit_status = 1;
    }

    return exit_status;
}

U0 GnuRmRegister()
{
    "GNU 'rm' utility loaded.\n";
}
