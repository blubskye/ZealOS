// expr.ZC - GNU coreutils 'expr' implementation
// Evaluate expressions

// C-style main function
I64 expr_main(I64 argc, U8 **argv)
{
    if (argc < 2) {
        fprintf(stderr, "expr: missing operand\n");
        return 2;
    }

    if (strcmp(argv[1], "--help") == 0) {
        printf("Usage: expr EXPRESSION\n");
        printf("  or:  expr OPTION\n");
        printf("Print the value of EXPRESSION to standard output.\n\n");
        printf("  --help      display this help and exit\n");
        printf("  --version   output version information and exit\n");
        printf("\nOperators (in order of increasing precedence):\n");
        printf("  ARG1 | ARG2       ARG1 if it is non-null and non-zero, else ARG2\n");
        printf("  ARG1 & ARG2       ARG1 if neither is null or 0, else 0\n");
        printf("  ARG1 < ARG2       ARG1 is less than ARG2\n");
        printf("  ARG1 <= ARG2      ARG1 is less than or equal to ARG2\n");
        printf("  ARG1 = ARG2       ARG1 is equal to ARG2\n");
        printf("  ARG1 != ARG2      ARG1 is unequal to ARG2\n");
        printf("  ARG1 >= ARG2      ARG1 is greater than or equal to ARG2\n");
        printf("  ARG1 > ARG2       ARG1 is greater than ARG2\n");
        printf("  ARG1 + ARG2       arithmetic sum of ARG1 and ARG2\n");
        printf("  ARG1 - ARG2       arithmetic difference of ARG1 and ARG2\n");
        printf("  ARG1 * ARG2       arithmetic product of ARG1 and ARG2\n");
        printf("  ARG1 / ARG2       arithmetic quotient of ARG1 divided by ARG2\n");
        printf("  ARG1 %% ARG2       arithmetic remainder of ARG1 divided by ARG2\n");
        printf("  STRING : REGEXP   anchored pattern match of REGEXP in STRING\n");
        printf("  match STRING REGEXP  same as STRING : REGEXP\n");
        printf("  substr STRING POS LENGTH  substring of STRING, POS counted from 1\n");
        printf("  index STRING CHARS  index in STRING where any CHARS is found, or 0\n");
        printf("  length STRING   length of STRING\n");
        return 0;
    }

    if (strcmp(argv[1], "--version") == 0) {
        printf("expr (ZealOS coreutils) 1.0\n");
        return 0;
    }

    // Simple recursive descent parser
    I64 pos = 1;

    // Check if string is a number
    auto is_number = [](U8 *s) -> Bool {
        if (!*s) return FALSE;
        if (*s == '-') s++;
        if (!*s) return FALSE;
        while (*s) {
            if (!isdigit(*s)) return FALSE;
            s++;
        }
        return TRUE;
    };

    // Forward declarations
    U8 *eval_or();
    U8 *eval_and();
    U8 *eval_compare();
    U8 *eval_add();
    U8 *eval_mul();
    U8 *eval_primary();

    // OR expression
    eval_or = [&]() -> U8* {
        U8 *left = eval_and();

        while (pos < argc && strcmp(argv[pos], "|") == 0) {
            pos++;
            U8 *right = eval_and();

            // Return left if non-null and non-zero
            if (left && *left && strcmp(left, "0") != 0) {
                if (right) Free(right);
            } else {
                if (left) Free(left);
                left = right;
            }
        }

        return left;
    };

    // AND expression
    eval_and = [&]() -> U8* {
        U8 *left = eval_compare();

        while (pos < argc && strcmp(argv[pos], "&") == 0) {
            pos++;
            U8 *right = eval_compare();

            Bool left_true = (left && *left && strcmp(left, "0") != 0);
            Bool right_true = (right && *right && strcmp(right, "0") != 0);

            if (right) Free(right);

            if (!left_true || !right_true) {
                if (left) Free(left);
                left = StrNew("0");
            }
        }

        return left;
    };

    // Comparison
    eval_compare = [&]() -> U8* {
        U8 *left = eval_add();

        while (pos < argc) {
            U8 *op = argv[pos];
            I64 cmp_type = 0;

            if (strcmp(op, "<") == 0) cmp_type = 1;
            else if (strcmp(op, "<=") == 0) cmp_type = 2;
            else if (strcmp(op, "=") == 0) cmp_type = 3;
            else if (strcmp(op, "!=") == 0) cmp_type = 4;
            else if (strcmp(op, ">=") == 0) cmp_type = 5;
            else if (strcmp(op, ">") == 0) cmp_type = 6;
            else break;

            pos++;
            U8 *right = eval_add();

            Bool result;
            if (is_number(left) && is_number(right)) {
                I64 l = atol(left);
                I64 r = atol(right);
                switch (cmp_type) {
                    case 1: result = (l < r); break;
                    case 2: result = (l <= r); break;
                    case 3: result = (l == r); break;
                    case 4: result = (l != r); break;
                    case 5: result = (l >= r); break;
                    case 6: result = (l > r); break;
                }
            } else {
                I64 cmp = strcmp(left, right);
                switch (cmp_type) {
                    case 1: result = (cmp < 0); break;
                    case 2: result = (cmp <= 0); break;
                    case 3: result = (cmp == 0); break;
                    case 4: result = (cmp != 0); break;
                    case 5: result = (cmp >= 0); break;
                    case 6: result = (cmp > 0); break;
                }
            }

            if (left) Free(left);
            if (right) Free(right);
            left = StrNew(result ? "1" : "0");
        }

        return left;
    };

    // Addition/Subtraction
    eval_add = [&]() -> U8* {
        U8 *left = eval_mul();

        while (pos < argc) {
            U8 *op = argv[pos];
            Bool is_add = (strcmp(op, "+") == 0);
            Bool is_sub = (strcmp(op, "-") == 0);

            if (!is_add && !is_sub) break;

            pos++;
            U8 *right = eval_mul();

            if (!is_number(left) || !is_number(right)) {
                fprintf(stderr, "expr: non-integer argument\n");
                if (left) Free(left);
                if (right) Free(right);
                return StrNew("");
            }

            I64 l = atol(left);
            I64 r = atol(right);
            I64 result = is_add ? (l + r) : (l - r);

            if (left) Free(left);
            if (right) Free(right);

            U8 buf[32];
            snprintf(buf, sizeof(buf), "%ld", result);
            left = StrNew(buf);
        }

        return left;
    };

    // Multiplication/Division/Modulo
    eval_mul = [&]() -> U8* {
        U8 *left = eval_primary();

        while (pos < argc) {
            U8 *op = argv[pos];
            I64 op_type = 0;

            if (strcmp(op, "*") == 0) op_type = 1;
            else if (strcmp(op, "/") == 0) op_type = 2;
            else if (strcmp(op, "%") == 0) op_type = 3;
            else break;

            pos++;
            U8 *right = eval_primary();

            if (!is_number(left) || !is_number(right)) {
                fprintf(stderr, "expr: non-integer argument\n");
                if (left) Free(left);
                if (right) Free(right);
                return StrNew("");
            }

            I64 l = atol(left);
            I64 r = atol(right);

            if ((op_type == 2 || op_type == 3) && r == 0) {
                fprintf(stderr, "expr: division by zero\n");
                if (left) Free(left);
                if (right) Free(right);
                return StrNew("");
            }

            I64 result;
            switch (op_type) {
                case 1: result = l * r; break;
                case 2: result = l / r; break;
                case 3: result = l % r; break;
            }

            if (left) Free(left);
            if (right) Free(right);

            U8 buf[32];
            snprintf(buf, sizeof(buf), "%ld", result);
            left = StrNew(buf);
        }

        return left;
    };

    // Primary expression
    eval_primary = [&]() -> U8* {
        if (pos >= argc) {
            fprintf(stderr, "expr: syntax error\n");
            return StrNew("");
        }

        U8 *token = argv[pos];

        // Parenthesized expression
        if (strcmp(token, "(") == 0) {
            pos++;
            U8 *result = eval_or();
            if (pos < argc && strcmp(argv[pos], ")") == 0) {
                pos++;
            }
            return result;
        }

        // Built-in functions
        if (strcmp(token, "length") == 0) {
            pos++;
            if (pos >= argc) {
                fprintf(stderr, "expr: syntax error\n");
                return StrNew("");
            }
            U8 buf[32];
            snprintf(buf, sizeof(buf), "%ld", strlen(argv[pos]));
            pos++;
            return StrNew(buf);
        }

        if (strcmp(token, "substr") == 0) {
            pos++;
            if (pos + 2 >= argc) {
                fprintf(stderr, "expr: syntax error\n");
                return StrNew("");
            }
            U8 *str = argv[pos++];
            I64 start = atol(argv[pos++]);
            I64 len = atol(argv[pos++]);

            I64 str_len = strlen(str);
            if (start < 1 || start > str_len) {
                return StrNew("");
            }

            U8 *result = MAlloc(len + 1);
            I64 i;
            for (i = 0; i < len && (start - 1 + i) < str_len; i++) {
                result[i] = str[start - 1 + i];
            }
            result[i] = 0;
            return result;
        }

        if (strcmp(token, "index") == 0) {
            pos++;
            if (pos + 1 >= argc) {
                fprintf(stderr, "expr: syntax error\n");
                return StrNew("");
            }
            U8 *str = argv[pos++];
            U8 *chars = argv[pos++];

            for (I64 i = 0; str[i]; i++) {
                for (I64 j = 0; chars[j]; j++) {
                    if (str[i] == chars[j]) {
                        U8 buf[32];
                        snprintf(buf, sizeof(buf), "%ld", i + 1);
                        return StrNew(buf);
                    }
                }
            }
            return StrNew("0");
        }

        // Regular token (number or string)
        pos++;
        return StrNew(token);
    };

    U8 *result = eval_or();

    if (result) {
        printf("%s\n", result);

        // Exit status: 0 if result is non-null and non-zero
        Bool success = (*result && strcmp(result, "0") != 0);
        Free(result);
        return success ? 0 : 1;
    }

    return 2;  // Error
}

U0 GnuExprRegister()
{
    "GNU 'expr' utility loaded.\n";
}
