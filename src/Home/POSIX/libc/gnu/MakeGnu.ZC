// ============================================================================
// UTILITY REGISTRY
// ============================================================================

class CGnuUtil {
    U8      *name;
    I64     (*main_func)(I64, U8 **);
    U8      *description;
};

CGnuUtil gnu_utils[] = {
    // Trivial utilities
    {"true",     &true_main,     "Exit with success status"},
    {"false",    &false_main,    "Exit with failure status"},
    {"yes",      &yes_main,      "Output string repeatedly"},

    // Text output
    {"echo",     &echo_main,     "Display line of text"},

    // File display
    {"cat",      &cat_main,      "Concatenate and display files"},
    {"head",     &head_main,     "Output first part of files"},
    {"tail",     &tail_main,     "Output last part of files"},
    {"wc",       &wc_main,       "Print line, word, byte counts"},
    {"tee",      &tee_main,      "Copy stdin to files and stdout"},

    // Path manipulation
    {"basename", &basename_main, "Strip directory from filename"},
    {"dirname",  &dirname_main,  "Strip filename from path"},

    // File operations
    {"touch",    &touch_main,    "Change file timestamps"},
    {"mkdir",    &mkdir_main,    "Create directories"},
    {"rmdir",    &rmdir_main,    "Remove empty directories"},
    {"cp",       &cp_main,       "Copy files and directories"},
    {"mv",       &mv_main,       "Move/rename files"},
    {"rm",       &rm_main,       "Remove files or directories"},
    {"ln",       &ln_main,       "Create links between files"},
    {"ls",       &ls_main,       "List directory contents"},

    // Text processing
    {"sort",     &sort_main,     "Sort lines of text files"},
    {"uniq",     &uniq_main,     "Report or omit repeated lines"},
    {"cut",      &cut_main,      "Remove sections from lines"},
    {"tr",       &tr_main,       "Translate or delete characters"},
    {"paste",    &paste_main,    "Merge lines of files"},
    {"grep",     &grep_main,     "Print lines matching pattern"},

    // System info
    {"date",     &date_main,     "Display or set date and time"},
    {"uname",    &uname_main,    "Print system information"},
    {"whoami",   &whoami_main,   "Print effective user name"},
    {"id",       &id_main,       "Print user and group IDs"},
    {"env",      &env_main,      "Run command in modified environment"},

    // Advanced utilities
    {"expr",     &expr_main,     "Evaluate expressions"},
    {"test",     &test_main,     "Check file types and compare values"},
    {"[",        &test_main,     "Check file types (bracket form)"},
    {"seq",      &seq_main,      "Print sequence of numbers"},
    {"sleep",    &sleep_main,    "Delay for specified time"},
    {"printf",   &printf_main,   "Format and print data"},

    // Toolchain infrastructure
    {"sh",       &sh_main,       "POSIX shell"},
    {"sed",      &sed_main,      "Stream editor"},
    {"awk",      &awk_main,      "Pattern scanning and processing"},
    {"find",     &find_main,     "Search for files in directory hierarchy"},
    {"xargs",    &xargs_main,    "Build and execute command lines from stdin"},
    {"make",     &make_main,     "GNU make build utility"},
    {"install",  &install_main,  "Copy files and set attributes"},

    // Compression tools
    {"gzip",     &gzip_main,     "Compress files with DEFLATE"},
    {"gunzip",   &gunzip_main,   "Decompress gzip files"},
    {"zcat",     &zcat_main,     "Decompress gzip to stdout"},
    {"tar",      &tar_main,      "Tape archive utility"},
    {"bzip2",    &bzip2_main,    "Block-sorting file compressor"},
    {"bunzip2",  &bunzip2_main,  "Decompress bzip2 files"},
    {"bzcat",    &bzcat_main,    "Decompress bzip2 to stdout"},

    {NULL, NULL, NULL}
};

// Find a utility by name
CGnuUtil *GnuUtilFind(U8 *name)
{
    for (I64 i = 0; gnu_utils[i].name; i++) {
        if (strcmp(gnu_utils[i].name, name) == 0)
            return &gnu_utils[i];
    }
    return NULL;
}

// Run a GNU utility by name
I64 GnuRun(U8 *cmdline)
{
    // Parse command name from cmdline
    U8 name[256];
    U8 *p = cmdline;
    I64 i = 0;

    while (*p && *p != ' ' && *p != '\t' && i < 255)
        name[i++] = *p++;
    name[i] = 0;

    CGnuUtil *util = GnuUtilFind(name);
    if (!util) {
        fprintf(stderr, "%s: command not found\n", name);
        return 127;
    }

    return CRun(util->main_func, cmdline);
}

// List all available utilities
U0 GnuList()
{
    printf("Available GNU coreutils:\n\n");

    printf("Trivial:\n");
    printf("  true, false, yes\n\n");

    printf("Text Output:\n");
    printf("  echo\n\n");

    printf("File Display:\n");
    printf("  cat, head, tail, wc, tee\n\n");

    printf("Path Manipulation:\n");
    printf("  basename, dirname\n\n");

    printf("File Operations:\n");
    printf("  touch, mkdir, rmdir, cp, mv, rm, ln, ls\n\n");

    printf("Text Processing:\n");
    printf("  sort, uniq, cut, tr, paste, grep\n\n");

    printf("System Info:\n");
    printf("  date, uname, whoami, id, env\n\n");

    printf("Advanced:\n");
    printf("  expr, test, [, seq, sleep, printf\n\n");

    printf("Toolchain Infrastructure:\n");
    printf("  sh, sed, awk, find, xargs, make, install\n\n");

    printf("Compression Tools:\n");
    printf("  gzip, gunzip, zcat, tar, bzip2, bunzip2, bzcat\n\n");

    printf("Usage: GnuRun(\"command args...\");\n");
    printf("Example: GnuRun(\"ls -la /Home\");\n");
}

// Count utilities
I64 GnuCount()
{
    I64 count = 0;
    for (I64 i = 0; gnu_utils[i].name; i++) count++;
    return count;
}

