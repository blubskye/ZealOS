"\n";
"========================================\n";
"ZealOS GNU Coreutils\n";
"========================================\n";
"\n";
"Loaded %d utilities:\n", GnuCount();
"\n";
"  Trivial:         true, false, yes\n";
"  Text Output:     echo\n";
"  File Display:    cat, head, tail, wc, tee\n";
"  Path:            basename, dirname\n";
"  File Ops:        touch, mkdir, rmdir, cp, mv, rm, ln, ls\n";
"  Text Process:    sort, uniq, cut, tr, paste, grep\n";
"  System Info:     date, uname, whoami, id, env\n";
"  Advanced:        expr, test, [, seq, sleep, printf\n";
"  Toolchain:       sh, sed, awk, find, xargs, make, install\n";
"  Compression:     gzip, gunzip, zcat, tar, bzip2, bunzip2, bzcat\n";
"\n";
"Commands:\n";
"  GnuList();                    - List all utilities\n";
"  GnuRun(\"ls -la /Home\");       - Run a utility\n";
"  CRun(&ls_main, \"ls -la\");     - Run directly\n";
"\n";
