// rmdir.ZC - GNU coreutils 'rmdir' implementation
// Remove empty directories

// C-style main function
I64 rmdir_main(I64 argc, U8 **argv)
{
    Bool parents = FALSE;           // -p
    Bool ignore_nonempty = FALSE;   // --ignore-fail-on-non-empty
    Bool verbose = FALSE;           // -v
    I64 start = 1;

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: rmdir [OPTION]... DIRECTORY...\n");
            printf("Remove the DIRECTORY(ies), if they are empty.\n\n");
            printf("      --ignore-fail-on-non-empty\n");
            printf("                  ignore each failure that is solely because a directory\n");
            printf("                  is non-empty\n");
            printf("  -p, --parents   remove DIRECTORY and its ancestors\n");
            printf("  -v, --verbose   output a diagnostic for every directory processed\n");
            printf("      --help      display this help and exit\n");
            printf("      --version   output version information and exit\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("rmdir (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-p") == 0 || strcmp(arg, "--parents") == 0) {
            parents = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-v") == 0 || strcmp(arg, "--verbose") == 0) {
            verbose = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "--ignore-fail-on-non-empty") == 0) {
            ignore_nonempty = TRUE;
            start++;
            continue;
        }

        // Short options
        if (arg[0] == '-' && arg[1] != '-') {
            for (I64 i = 1; arg[i]; i++) {
                switch (arg[i]) {
                    case 'p': parents = TRUE; break;
                    case 'v': verbose = TRUE; break;
                    default:
                        fprintf(stderr, "rmdir: invalid option -- '%c'\n", arg[i]);
                        return 1;
                }
            }
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        break;
    }

    if (start >= argc) {
        fprintf(stderr, "rmdir: missing operand\n");
        return 1;
    }

    I64 exit_status = 0;

    // Remove directory and optionally parents
    auto rmdir_with_parents = [](U8 *path, Bool verbose) -> I64 {
        U8 tmp[PATH_MAX];
        strncpy(tmp, path, PATH_MAX - 1);
        tmp[PATH_MAX - 1] = 0;

        // Remove trailing slashes
        I64 len = strlen(tmp);
        while (len > 1 && tmp[len - 1] == '/') {
            tmp[--len] = 0;
        }

        while (len > 0) {
            if (PosixRmdir(tmp) < 0) {
                return -1;
            }
            if (verbose) {
                printf("rmdir: removing directory, '%s'\n", tmp);
            }

            // Find parent
            U8 *slash = strrchr(tmp, '/');
            if (!slash || slash == tmp)
                break;
            *slash = 0;
            len = strlen(tmp);
        }

        return 0;
    };

    for (I64 i = start; i < argc; i++) {
        U8 *path = argv[i];

        if (parents) {
            if (rmdir_with_parents(path, verbose) < 0) {
                if (!ignore_nonempty || errno != ENOTEMPTY) {
                    fprintf(stderr, "rmdir: failed to remove '%s': %s\n",
                            path, strerror(errno));
                    exit_status = 1;
                }
            }
        } else {
            if (verbose) {
                printf("rmdir: removing directory, '%s'\n", path);
            }
            if (PosixRmdir(path) < 0) {
                if (!ignore_nonempty || errno != ENOTEMPTY) {
                    fprintf(stderr, "rmdir: failed to remove '%s': %s\n",
                            path, strerror(errno));
                    exit_status = 1;
                }
            }
        }
    }

    return exit_status;
}

U0 GnuRmdirRegister()
{
    "GNU 'rmdir' utility loaded.\n";
}
