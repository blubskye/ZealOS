// env.ZC - GNU coreutils 'env' implementation
// Run a program in a modified environment

#define ENV_MAX_VARS 256

// Simple environment storage for ZealOS
U8 *g_environ[ENV_MAX_VARS];
I64 g_environ_count = 0;

// Initialize default environment
U0 InitDefaultEnv()
{
    if (g_environ_count > 0) return;  // Already initialized

    g_environ[g_environ_count++] = StrNew("PATH=/bin:/usr/bin");
    g_environ[g_environ_count++] = StrNew("HOME=/Home");
    g_environ[g_environ_count++] = StrNew("USER=user");
    g_environ[g_environ_count++] = StrNew("SHELL=/bin/sh");
    g_environ[g_environ_count++] = StrNew("TERM=zealos");
    g_environ[g_environ_count++] = StrNew("PWD=/");
}

// Get environment variable
U8 *EnvGet(U8 *name)
{
    I64 name_len = strlen(name);

    for (I64 i = 0; i < g_environ_count; i++) {
        if (strncmp(g_environ[i], name, name_len) == 0 &&
            g_environ[i][name_len] == '=') {
            return &g_environ[i][name_len + 1];
        }
    }
    return NULL;
}

// Set environment variable
I64 EnvSet(U8 *name, U8 *value)
{
    I64 name_len = strlen(name);

    // Check if already exists
    for (I64 i = 0; i < g_environ_count; i++) {
        if (strncmp(g_environ[i], name, name_len) == 0 &&
            g_environ[i][name_len] == '=') {
            Free(g_environ[i]);
            g_environ[i] = MAlloc(name_len + strlen(value) + 2);
            sprintf(g_environ[i], "%s=%s", name, value);
            return 0;
        }
    }

    // Add new
    if (g_environ_count >= ENV_MAX_VARS - 1)
        return -1;

    g_environ[g_environ_count] = MAlloc(name_len + strlen(value) + 2);
    sprintf(g_environ[g_environ_count], "%s=%s", name, value);
    g_environ_count++;
    return 0;
}

// Unset environment variable
I64 EnvUnset(U8 *name)
{
    I64 name_len = strlen(name);

    for (I64 i = 0; i < g_environ_count; i++) {
        if (strncmp(g_environ[i], name, name_len) == 0 &&
            g_environ[i][name_len] == '=') {
            Free(g_environ[i]);
            // Shift remaining
            for (I64 j = i; j < g_environ_count - 1; j++) {
                g_environ[j] = g_environ[j + 1];
            }
            g_environ_count--;
            return 0;
        }
    }
    return -1;
}

// C-style main function
I64 env_main(I64 argc, U8 **argv)
{
    Bool ignore_env = FALSE;      // -i
    Bool null_delim = FALSE;      // -0
    U8 *chdir_path = NULL;        // -C
    I64 start = 1;

    InitDefaultEnv();

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]\n");
            printf("Set each NAME to VALUE in the environment and run COMMAND.\n\n");
            printf("  -i, --ignore-environment  start with an empty environment\n");
            printf("  -0, --null                end each output line with NUL, not newline\n");
            printf("  -u, --unset=NAME          remove variable from the environment\n");
            printf("  -C, --chdir=DIR           change working directory to DIR\n");
            printf("      --help                display this help and exit\n");
            printf("      --version             output version information and exit\n");
            printf("\nA mere - implies -i.  If no COMMAND, print the environment.\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("env (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-i") == 0 || strcmp(arg, "--ignore-environment") == 0) {
            ignore_env = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-") == 0) {
            ignore_env = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-0") == 0 || strcmp(arg, "--null") == 0) {
            null_delim = TRUE;
            start++;
            continue;
        }

        if (strncmp(arg, "-u", 2) == 0) {
            U8 *name;
            if (arg[2]) name = &arg[2];
            else if (start + 1 < argc) { start++; name = argv[start]; }
            else { fprintf(stderr, "env: option requires an argument -- 'u'\n"); return 125; }
            EnvUnset(name);
            start++;
            continue;
        }

        if (strncmp(arg, "--unset=", 8) == 0) {
            EnvUnset(&arg[8]);
            start++;
            continue;
        }

        if (strncmp(arg, "-C", 2) == 0) {
            if (arg[2]) chdir_path = &arg[2];
            else if (start + 1 < argc) { start++; chdir_path = argv[start]; }
            else { fprintf(stderr, "env: option requires an argument -- 'C'\n"); return 125; }
            start++;
            continue;
        }

        if (strncmp(arg, "--chdir=", 8) == 0) {
            chdir_path = &arg[8];
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        if (arg[0] == '-') {
            fprintf(stderr, "env: invalid option -- '%s'\n", arg);
            return 125;
        }

        break;
    }

    // Clear environment if -i
    if (ignore_env) {
        for (I64 i = 0; i < g_environ_count; i++) {
            Free(g_environ[i]);
        }
        g_environ_count = 0;
    }

    // Process NAME=VALUE arguments
    while (start < argc) {
        U8 *eq = strchr(argv[start], '=');
        if (!eq) break;  // No more env vars

        // Extract name and value
        I64 name_len = eq - argv[start];
        U8 *name = MAlloc(name_len + 1);
        strncpy(name, argv[start], name_len);
        name[name_len] = 0;

        EnvSet(name, eq + 1);
        Free(name);
        start++;
    }

    // Change directory if requested
    if (chdir_path) {
        if (PosixChdir(chdir_path) < 0) {
            fprintf(stderr, "env: cannot change directory to '%s': %s\n",
                    chdir_path, strerror(errno));
            return 125;
        }
    }

    // If no command, print environment
    if (start >= argc) {
        U8 delim = null_delim ? 0 : '\n';
        for (I64 i = 0; i < g_environ_count; i++) {
            printf("%s%c", g_environ[i], delim);
        }
        return 0;
    }

    // Execute command
    // In ZealOS, we'd need to implement exec() properly
    // For now, just print what we would execute
    fprintf(stderr, "env: cannot execute '%s': not implemented\n", argv[start]);
    return 126;
}

// Compatibility functions
U8 *getenv(U8 *name)
{
    return EnvGet(name);
}

I64 setenv(U8 *name, U8 *value, I64 overwrite)
{
    if (!overwrite && EnvGet(name))
        return 0;
    return EnvSet(name, value);
}

I64 unsetenv(U8 *name)
{
    return EnvUnset(name);
}

U0 GnuEnvRegister()
{
    InitDefaultEnv();
    "GNU 'env' utility loaded.\n";
}
