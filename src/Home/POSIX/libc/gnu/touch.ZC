// touch.ZC - GNU coreutils 'touch' implementation
// Change file timestamps or create empty files

// C-style main function
I64 touch_main(I64 argc, U8 **argv)
{
    Bool no_create = FALSE;     // -c
    Bool no_deref = FALSE;      // -h (not implemented - no symlinks)
    I64 start = 1;

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: touch [OPTION]... FILE...\n");
            printf("Update the access and modification times of each FILE to the current time.\n");
            printf("A FILE argument that does not exist is created empty.\n\n");
            printf("  -a                     change only the access time\n");
            printf("  -c, --no-create        do not create any files\n");
            printf("  -m                     change only the modification time\n");
            printf("  -r, --reference=FILE   use this file's times instead of current time\n");
            printf("  -t STAMP               use [[CC]YY]MMDDhhmm[.ss] instead of current time\n");
            printf("      --help             display this help and exit\n");
            printf("      --version          output version information and exit\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("touch (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-c") == 0 || strcmp(arg, "--no-create") == 0) {
            no_create = TRUE;
            start++;
            continue;
        }

        // Short options
        if (arg[0] == '-' && arg[1] != '-') {
            for (I64 i = 1; arg[i]; i++) {
                switch (arg[i]) {
                    case 'a': break;  // Access time only (simplified - we update both)
                    case 'c': no_create = TRUE; break;
                    case 'm': break;  // Modification time only
                    case 'h': no_deref = TRUE; break;
                    default:
                        fprintf(stderr, "touch: invalid option -- '%c'\n", arg[i]);
                        return 1;
                }
            }
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        break;
    }

    if (start >= argc) {
        fprintf(stderr, "touch: missing file operand\n");
        return 1;
    }

    I64 exit_status = 0;

    for (I64 i = start; i < argc; i++) {
        U8 *path = argv[i];

        // Check if file exists
        I64 fd = PosixOpen(path, O_RDONLY, 0);
        if (fd >= 0) {
            // File exists - just close it (timestamp update not fully supported)
            PosixClose(fd);
        } else {
            // File doesn't exist
            if (no_create) {
                // Don't create, just skip
                continue;
            }

            // Create empty file
            fd = PosixOpen(path, O_WRONLY | O_CREAT | O_EXCL, 0666);
            if (fd < 0) {
                fprintf(stderr, "touch: cannot touch '%s': %s\n", path, strerror(errno));
                exit_status = 1;
                continue;
            }
            PosixClose(fd);
        }
    }

    return exit_status;
}

U0 GnuTouchRegister()
{
    "GNU 'touch' utility loaded.\n";
}
