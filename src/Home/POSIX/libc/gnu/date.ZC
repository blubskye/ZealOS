// date.ZC - GNU coreutils 'date' implementation
// Print or set the system date and time

// C-style main function
I64 date_main(I64 argc, U8 **argv)
{
    U8 *format = NULL;
    Bool utc = FALSE;            // -u
    U8 *date_str = NULL;         // -d
    U8 *reference = NULL;        // -r
    I64 start = 1;

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: date [OPTION]... [+FORMAT]\n");
            printf("  or:  date [-u|--utc|--universal] [MMDDhhmm[[CC]YY][.ss]]\n");
            printf("Display the current time in the given FORMAT, or set the system date.\n\n");
            printf("  -d, --date=STRING     display time described by STRING, not 'now'\n");
            printf("  -r, --reference=FILE  display the last modification time of FILE\n");
            printf("  -u, --utc, --universal print Coordinated Universal Time (UTC)\n");
            printf("      --help            display this help and exit\n");
            printf("      --version         output version information and exit\n");
            printf("\nFORMAT controls the output. Common sequences:\n");
            printf("  %%%%   a literal %%\n");
            printf("  %%a   abbreviated weekday name (Sun..Sat)\n");
            printf("  %%A   full weekday name (Sunday..Saturday)\n");
            printf("  %%b   abbreviated month name (Jan..Dec)\n");
            printf("  %%B   full month name (January..December)\n");
            printf("  %%d   day of month (01..31)\n");
            printf("  %%D   date; same as %%m/%%d/%%y\n");
            printf("  %%H   hour (00..23)\n");
            printf("  %%I   hour (01..12)\n");
            printf("  %%m   month (01..12)\n");
            printf("  %%M   minute (00..59)\n");
            printf("  %%p   AM or PM\n");
            printf("  %%S   second (00..60)\n");
            printf("  %%T   time; same as %%H:%%M:%%S\n");
            printf("  %%Y   year\n");
            printf("  %%Z   timezone name\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("date (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-u") == 0 || strcmp(arg, "--utc") == 0 ||
            strcmp(arg, "--universal") == 0) {
            utc = TRUE;
            start++;
            continue;
        }

        if (strncmp(arg, "-d", 2) == 0) {
            if (arg[2]) date_str = &arg[2];
            else if (start + 1 < argc) { start++; date_str = argv[start]; }
            start++;
            continue;
        }

        if (strncmp(arg, "--date=", 7) == 0) {
            date_str = &arg[7];
            start++;
            continue;
        }

        if (strncmp(arg, "-r", 2) == 0) {
            if (arg[2]) reference = &arg[2];
            else if (start + 1 < argc) { start++; reference = argv[start]; }
            start++;
            continue;
        }

        if (strncmp(arg, "--reference=", 12) == 0) {
            reference = &arg[12];
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        break;
    }

    // Check for format string
    if (start < argc && argv[start][0] == '+') {
        format = &argv[start][1];
    }

    // Get the time
    U64 timestamp;
    if (reference) {
        CPosixStat st;
        if (PosixStat(reference, &st) < 0) {
            fprintf(stderr, "date: cannot stat '%s': %s\n", reference, strerror(errno));
            return 1;
        }
        timestamp = st.st_mtime;
    } else if (date_str) {
        // Parse date string - simplified, just use current time
        // A full implementation would parse various date formats
        timestamp = time(NULL);
    } else {
        timestamp = time(NULL);
    }

    // Convert timestamp to broken-down time
    // Simplified calculation - just for demonstration
    U64 t = timestamp;

    // Days since epoch
    I64 days = t / 86400;
    I64 secs = t % 86400;

    I64 hour = secs / 3600;
    I64 min = (secs % 3600) / 60;
    I64 sec = secs % 60;

    // Calculate year, month, day (simplified - doesn't handle all edge cases)
    I64 year = 1970;
    I64 remaining_days = days;

    while (1) {
        I64 days_in_year = 365;
        if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)
            days_in_year = 366;
        if (remaining_days < days_in_year) break;
        remaining_days -= days_in_year;
        year++;
    }

    I64 month_days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)
        month_days[1] = 29;

    I64 month = 0;
    while (month < 12 && remaining_days >= month_days[month]) {
        remaining_days -= month_days[month];
        month++;
    }
    month++;  // 1-based
    I64 day = remaining_days + 1;

    // Calculate day of week
    // Jan 1, 1970 was Thursday (4)
    I64 weekday = (days + 4) % 7;

    U8 *weekday_short[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
    U8 *weekday_long[] = {"Sunday", "Monday", "Tuesday", "Wednesday",
                          "Thursday", "Friday", "Saturday"};
    U8 *month_short[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun",
                         "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};
    U8 *month_long[] = {"January", "February", "March", "April", "May", "June",
                        "July", "August", "September", "October", "November", "December"};

    if (format) {
        // Process format string
        U8 *p = format;
        while (*p) {
            if (*p == '%' && *(p+1)) {
                p++;
                switch (*p) {
                    case '%': putchar('%'); break;
                    case 'a': printf("%s", weekday_short[weekday]); break;
                    case 'A': printf("%s", weekday_long[weekday]); break;
                    case 'b':
                    case 'h': printf("%s", month_short[month-1]); break;
                    case 'B': printf("%s", month_long[month-1]); break;
                    case 'd': printf("%02ld", day); break;
                    case 'D': printf("%02ld/%02ld/%02ld", month, day, year % 100); break;
                    case 'e': printf("%2ld", day); break;
                    case 'F': printf("%04ld-%02ld-%02ld", year, month, day); break;
                    case 'H': printf("%02ld", hour); break;
                    case 'I': printf("%02ld", hour == 0 ? 12 : (hour > 12 ? hour - 12 : hour)); break;
                    case 'j': printf("%03ld", remaining_days + 1); break;  // Day of year
                    case 'm': printf("%02ld", month); break;
                    case 'M': printf("%02ld", min); break;
                    case 'n': putchar('\n'); break;
                    case 'p': printf("%s", hour < 12 ? "AM" : "PM"); break;
                    case 'P': printf("%s", hour < 12 ? "am" : "pm"); break;
                    case 'r': printf("%02ld:%02ld:%02ld %s",
                              hour == 0 ? 12 : (hour > 12 ? hour - 12 : hour),
                              min, sec, hour < 12 ? "AM" : "PM"); break;
                    case 'R': printf("%02ld:%02ld", hour, min); break;
                    case 's': printf("%lld", timestamp); break;
                    case 'S': printf("%02ld", sec); break;
                    case 't': putchar('\t'); break;
                    case 'T': printf("%02ld:%02ld:%02ld", hour, min, sec); break;
                    case 'u': printf("%ld", weekday == 0 ? 7 : weekday); break;
                    case 'w': printf("%ld", weekday); break;
                    case 'y': printf("%02ld", year % 100); break;
                    case 'Y': printf("%04ld", year); break;
                    case 'Z': printf("%s", utc ? "UTC" : "LOCAL"); break;
                    default: printf("%%%c", *p);
                }
                p++;
            } else {
                putchar(*p++);
            }
        }
        putchar('\n');
    } else {
        // Default format: "Thu Dec 16 12:00:00 UTC 2024"
        printf("%s %s %2ld %02ld:%02ld:%02ld %s %04ld\n",
               weekday_short[weekday], month_short[month-1], day,
               hour, min, sec, utc ? "UTC" : "LOCAL", year);
    }

    return 0;
}

U0 GnuDateRegister()
{
    "GNU 'date' utility loaded.\n";
}
