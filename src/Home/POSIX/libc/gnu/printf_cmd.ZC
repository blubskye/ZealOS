// printf_cmd.ZC - GNU coreutils 'printf' implementation
// Format and print data

// C-style main function
I64 printf_main(I64 argc, U8 **argv)
{
    I64 start = 1;

    // Parse options (printf has very few)
    while (start < argc && argv[start][0] == '-') {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: printf FORMAT [ARGUMENT]...\n");
            printf("  or:  printf OPTION\n");
            printf("Print ARGUMENT(s) according to FORMAT.\n\n");
            printf("  --help      display this help and exit\n");
            printf("  --version   output version information and exit\n");
            printf("\nFORMAT interprets sequences like C printf:\n");
            printf("  \\\\    backslash\n");
            printf("  \\a    alert (bell)\n");
            printf("  \\b    backspace\n");
            printf("  \\f    form feed\n");
            printf("  \\n    newline\n");
            printf("  \\r    carriage return\n");
            printf("  \\t    horizontal tab\n");
            printf("  \\v    vertical tab\n");
            printf("  \\0NNN octal character (1-3 digits)\n");
            printf("  \\xHH  hexadecimal character (1-2 digits)\n");
            printf("\nFormat specifications:\n");
            printf("  %%b    ARGUMENT as string with \\\\ escapes interpreted\n");
            printf("  %%c    first character of ARGUMENT\n");
            printf("  %%d    ARGUMENT as signed decimal integer\n");
            printf("  %%i    same as %%d\n");
            printf("  %%o    ARGUMENT as unsigned octal integer\n");
            printf("  %%s    ARGUMENT as string\n");
            printf("  %%u    ARGUMENT as unsigned decimal integer\n");
            printf("  %%x    ARGUMENT as unsigned hexadecimal (lowercase)\n");
            printf("  %%X    ARGUMENT as unsigned hexadecimal (uppercase)\n");
            printf("  %%%%    a literal %%\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("printf (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        // printf doesn't have other options - treat as format
        break;
    }

    if (start >= argc) {
        fprintf(stderr, "printf: missing format operand\n");
        return 1;
    }

    U8 *format = argv[start++];
    I64 arg_pos = start;

    // Get next argument (cycling through if needed)
    auto get_arg = [&]() -> U8* {
        if (arg_pos < argc) {
            return argv[arg_pos++];
        }
        return "";  // Empty string if no more arguments
    };

    // Process escape sequences in a string
    auto process_escapes = [](U8 *s) -> U0 {
        while (*s) {
            if (*s == '\\' && *(s+1)) {
                s++;
                switch (*s) {
                    case 'a': putchar('\a'); break;
                    case 'b': putchar('\b'); break;
                    case 'f': putchar('\f'); break;
                    case 'n': putchar('\n'); break;
                    case 'r': putchar('\r'); break;
                    case 't': putchar('\t'); break;
                    case 'v': putchar('\v'); break;
                    case '\\': putchar('\\'); break;
                    case '0': case '1': case '2': case '3':
                    case '4': case '5': case '6': case '7': {
                        // Octal
                        I64 val = 0;
                        for (I64 i = 0; i < 3 && *s >= '0' && *s <= '7'; i++) {
                            val = val * 8 + (*s - '0');
                            s++;
                        }
                        s--;  // Will be incremented below
                        putchar(val);
                        break;
                    }
                    case 'x': {
                        // Hexadecimal
                        s++;
                        I64 val = 0;
                        for (I64 i = 0; i < 2 && isxdigit(*s); i++) {
                            val *= 16;
                            if (*s >= '0' && *s <= '9') val += *s - '0';
                            else if (*s >= 'a' && *s <= 'f') val += *s - 'a' + 10;
                            else if (*s >= 'A' && *s <= 'F') val += *s - 'A' + 10;
                            s++;
                        }
                        s--;
                        putchar(val);
                        break;
                    }
                    default:
                        putchar(*s);
                }
            } else {
                putchar(*s);
            }
            s++;
        }
    };

    // Process format string
    U8 *p = format;
    while (*p) {
        if (*p == '\\' && *(p+1)) {
            p++;
            switch (*p) {
                case 'a': putchar('\a'); break;
                case 'b': putchar('\b'); break;
                case 'f': putchar('\f'); break;
                case 'n': putchar('\n'); break;
                case 'r': putchar('\r'); break;
                case 't': putchar('\t'); break;
                case 'v': putchar('\v'); break;
                case '\\': putchar('\\'); break;
                case '0': case '1': case '2': case '3':
                case '4': case '5': case '6': case '7': {
                    I64 val = 0;
                    for (I64 i = 0; i < 3 && *p >= '0' && *p <= '7'; i++) {
                        val = val * 8 + (*p - '0');
                        p++;
                    }
                    p--;
                    putchar(val);
                    break;
                }
                case 'x': {
                    p++;
                    I64 val = 0;
                    for (I64 i = 0; i < 2 && isxdigit(*p); i++) {
                        val *= 16;
                        if (*p >= '0' && *p <= '9') val += *p - '0';
                        else if (*p >= 'a' && *p <= 'f') val += *p - 'a' + 10;
                        else if (*p >= 'A' && *p <= 'F') val += *p - 'A' + 10;
                        p++;
                    }
                    p--;
                    putchar(val);
                    break;
                }
                case 'c':  // Stop processing
                    return 0;
                default:
                    putchar('\\');
                    putchar(*p);
            }
            p++;
        } else if (*p == '%' && *(p+1)) {
            p++;

            if (*p == '%') {
                putchar('%');
                p++;
                continue;
            }

            // Parse format specification
            Bool left_justify = FALSE;
            Bool zero_pad = FALSE;
            Bool plus_sign = FALSE;
            Bool space_prefix = FALSE;
            Bool alt_form = FALSE;
            I64 width = 0;
            I64 precision = -1;

            // Flags
            while (*p) {
                if (*p == '-') { left_justify = TRUE; p++; }
                else if (*p == '0') { zero_pad = TRUE; p++; }
                else if (*p == '+') { plus_sign = TRUE; p++; }
                else if (*p == ' ') { space_prefix = TRUE; p++; }
                else if (*p == '#') { alt_form = TRUE; p++; }
                else break;
            }

            // Width
            if (*p == '*') {
                width = atol(get_arg());
                p++;
            } else {
                while (isdigit(*p)) {
                    width = width * 10 + (*p - '0');
                    p++;
                }
            }

            // Precision
            if (*p == '.') {
                p++;
                precision = 0;
                if (*p == '*') {
                    precision = atol(get_arg());
                    p++;
                } else {
                    while (isdigit(*p)) {
                        precision = precision * 10 + (*p - '0');
                        p++;
                    }
                }
            }

            // Conversion specifier
            U8 spec = *p++;
            U8 *arg = get_arg();

            switch (spec) {
                case 's': {
                    I64 len = strlen(arg);
                    if (precision >= 0 && precision < len)
                        len = precision;
                    I64 pad = width - len;
                    if (pad > 0 && !left_justify) {
                        for (I64 i = 0; i < pad; i++) putchar(' ');
                    }
                    for (I64 i = 0; i < len; i++) putchar(arg[i]);
                    if (pad > 0 && left_justify) {
                        for (I64 i = 0; i < pad; i++) putchar(' ');
                    }
                    break;
                }

                case 'b': {
                    // String with escape processing
                    process_escapes(arg);
                    break;
                }

                case 'c': {
                    putchar(arg[0]);
                    break;
                }

                case 'd':
                case 'i': {
                    I64 val = atol(arg);
                    U8 buf[32];
                    snprintf(buf, sizeof(buf), "%ld", val);
                    I64 len = strlen(buf);
                    I64 pad = width - len;
                    if (pad > 0 && !left_justify && !zero_pad) {
                        for (I64 i = 0; i < pad; i++) putchar(' ');
                    }
                    if (val >= 0 && plus_sign) putchar('+');
                    else if (val >= 0 && space_prefix) putchar(' ');
                    if (pad > 0 && !left_justify && zero_pad) {
                        for (I64 i = 0; i < pad; i++) putchar('0');
                    }
                    printf("%s", buf);
                    if (pad > 0 && left_justify) {
                        for (I64 i = 0; i < pad; i++) putchar(' ');
                    }
                    break;
                }

                case 'u': {
                    U64 val = strtoul(arg, NULL, 10);
                    printf("%lu", val);
                    break;
                }

                case 'o': {
                    U64 val = strtoul(arg, NULL, 10);
                    if (alt_form && val != 0) putchar('0');
                    printf("%lo", val);
                    break;
                }

                case 'x': {
                    U64 val = strtoul(arg, NULL, 10);
                    if (alt_form && val != 0) printf("0x");
                    printf("%lx", val);
                    break;
                }

                case 'X': {
                    U64 val = strtoul(arg, NULL, 10);
                    if (alt_form && val != 0) printf("0X");
                    printf("%lX", val);
                    break;
                }

                case 'f':
                case 'F':
                case 'e':
                case 'E':
                case 'g':
                case 'G': {
                    F64 val = strtod(arg, NULL);
                    U8 fmt[16];
                    if (precision >= 0) {
                        snprintf(fmt, sizeof(fmt), "%%.%ld%c", precision, spec);
                    } else {
                        snprintf(fmt, sizeof(fmt), "%%%c", spec);
                    }
                    printf(fmt, val);
                    break;
                }

                default:
                    putchar('%');
                    putchar(spec);
            }
        } else {
            putchar(*p++);
        }
    }

    return 0;
}

U0 GnuPrintfRegister()
{
    "GNU 'printf' utility loaded.\n";
}
