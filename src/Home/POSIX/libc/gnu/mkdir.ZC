// mkdir.ZC - GNU coreutils 'mkdir' implementation
// Create directories

// C-style main function
I64 mkdir_main(I64 argc, U8 **argv)
{
    Bool parents = FALSE;       // -p
    I64 mode = 0777;           // Default mode
    Bool verbose = FALSE;       // -v
    I64 start = 1;

    // Parse options
    while (start < argc && argv[start][0] == '-' && argv[start][1]) {
        U8 *arg = argv[start];

        if (strcmp(arg, "--help") == 0) {
            printf("Usage: mkdir [OPTION]... DIRECTORY...\n");
            printf("Create the DIRECTORY(ies), if they do not already exist.\n\n");
            printf("  -m, --mode=MODE   set file mode (as in chmod), not a=rwx - umask\n");
            printf("  -p, --parents     no error if existing, make parent directories as needed\n");
            printf("  -v, --verbose     print a message for each created directory\n");
            printf("      --help        display this help and exit\n");
            printf("      --version     output version information and exit\n");
            return 0;
        }

        if (strcmp(arg, "--version") == 0) {
            printf("mkdir (ZealOS coreutils) 1.0\n");
            return 0;
        }

        if (strcmp(arg, "-p") == 0 || strcmp(arg, "--parents") == 0) {
            parents = TRUE;
            start++;
            continue;
        }

        if (strcmp(arg, "-v") == 0 || strcmp(arg, "--verbose") == 0) {
            verbose = TRUE;
            start++;
            continue;
        }

        if (strncmp(arg, "-m", 2) == 0) {
            U8 *mode_str = &arg[2];
            if (!*mode_str && start + 1 < argc) {
                start++;
                mode_str = argv[start];
            }
            mode = strtol(mode_str, NULL, 8);
            start++;
            continue;
        }

        if (strncmp(arg, "--mode=", 7) == 0) {
            mode = strtol(&arg[7], NULL, 8);
            start++;
            continue;
        }

        // Combined short options
        if (arg[0] == '-' && arg[1] != '-') {
            for (I64 i = 1; arg[i]; i++) {
                switch (arg[i]) {
                    case 'p': parents = TRUE; break;
                    case 'v': verbose = TRUE; break;
                    case 'm':
                        // Next argument is mode
                        if (arg[i+1]) {
                            mode = strtol(&arg[i+1], NULL, 8);
                        } else if (start + 1 < argc) {
                            start++;
                            mode = strtol(argv[start], NULL, 8);
                        }
                        goto next_arg;
                    default:
                        fprintf(stderr, "mkdir: invalid option -- '%c'\n", arg[i]);
                        return 1;
                }
            }
            next_arg:
            start++;
            continue;
        }

        if (strcmp(arg, "--") == 0) {
            start++;
            break;
        }

        break;
    }

    if (start >= argc) {
        fprintf(stderr, "mkdir: missing operand\n");
        return 1;
    }

    I64 exit_status = 0;

    // Create parent directories recursively
    auto mkdir_parents = [](U8 *path, I64 mode, Bool verbose) -> I64 {
        U8 tmp[PATH_MAX];
        U8 *p = NULL;
        I64 len;

        snprintf(tmp, sizeof(tmp), "%s", path);
        len = strlen(tmp);

        // Remove trailing slash
        if (tmp[len - 1] == '/')
            tmp[len - 1] = 0;

        for (p = tmp + 1; *p; p++) {
            if (*p == '/') {
                *p = 0;
                if (PosixMkdir(tmp, mode) < 0) {
                    if (errno != EEXIST) {
                        fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                                tmp, strerror(errno));
                        return -1;
                    }
                } else if (verbose) {
                    printf("mkdir: created directory '%s'\n", tmp);
                }
                *p = '/';
            }
        }

        if (PosixMkdir(tmp, mode) < 0) {
            if (errno != EEXIST) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        tmp, strerror(errno));
                return -1;
            }
        } else if (verbose) {
            printf("mkdir: created directory '%s'\n", tmp);
        }

        return 0;
    };

    for (I64 i = start; i < argc; i++) {
        U8 *path = argv[i];

        if (parents) {
            if (mkdir_parents(path, mode, verbose) < 0)
                exit_status = 1;
        } else {
            if (PosixMkdir(path, mode) < 0) {
                fprintf(stderr, "mkdir: cannot create directory '%s': %s\n",
                        path, strerror(errno));
                exit_status = 1;
            } else if (verbose) {
                printf("mkdir: created directory '%s'\n", path);
            }
        }
    }

    return exit_status;
}

U0 GnuMkdirRegister()
{
    "GNU 'mkdir' utility loaded.\n";
}
