// unwind.ZC - Stack Unwinding Support for ZealOS
// Part of the POSIX compatibility layer
//
// Implements the Itanium ABI exception handling (libunwind interface)
// This is a simplified version for basic C++ exception support

// ============================================================================
// UNWIND REASON CODES
// ============================================================================

#define _URC_NO_REASON                 0
#define _URC_FOREIGN_EXCEPTION_CAUGHT  1
#define _URC_FATAL_PHASE2_ERROR        2
#define _URC_FATAL_PHASE1_ERROR        3
#define _URC_NORMAL_STOP               4
#define _URC_END_OF_STACK              5
#define _URC_HANDLER_FOUND             6
#define _URC_INSTALL_CONTEXT           7
#define _URC_CONTINUE_UNWIND           8

// ============================================================================
// UNWIND ACTIONS
// ============================================================================

#define _UA_SEARCH_PHASE   1
#define _UA_CLEANUP_PHASE  2
#define _UA_HANDLER_FRAME  4
#define _UA_FORCE_UNWIND   8
#define _UA_END_OF_STACK  16

// ============================================================================
// EXCEPTION CLASS
// ============================================================================

// GNU C++ exception class: "GNUCC++\0" as 8 bytes
#define GNU_CPP_EXCEPTION_CLASS 0x474E5543432B2B00

// ============================================================================
// UNWIND STRUCTURES
// ============================================================================

// Unwind exception structure
class _Unwind_Exception {
    U64 exception_class;
    U0 (*exception_cleanup)(I64, _Unwind_Exception*);
    U64 private_1;
    U64 private_2;
};

// Unwind context (opaque to user code)
class _Unwind_Context {
    U64 registers[32];   // Saved registers
    U64 cfa;             // Canonical Frame Address
    U64 ip;              // Instruction pointer
    U64 ra;              // Return address
    U8 *lsda;            // Language Specific Data Area
    U8 *personality;     // Personality routine
};

// ============================================================================
// DWARF REGISTER NUMBERS (x86_64)
// ============================================================================

#define DW_REG_RAX  0
#define DW_REG_RDX  1
#define DW_REG_RCX  2
#define DW_REG_RBX  3
#define DW_REG_RSI  4
#define DW_REG_RDI  5
#define DW_REG_RBP  6
#define DW_REG_RSP  7
#define DW_REG_R8   8
#define DW_REG_R9   9
#define DW_REG_R10  10
#define DW_REG_R11  11
#define DW_REG_R12  12
#define DW_REG_R13  13
#define DW_REG_R14  14
#define DW_REG_R15  15
#define DW_REG_RIP  16

// ============================================================================
// UNWIND FUNCTIONS
// ============================================================================

// Get register value
U64 _Unwind_GetGR(_Unwind_Context *context, I64 reg)
{
    if (!context || reg < 0 || reg > 31) return 0;
    return context->registers[reg];
}

// Set register value
U0 _Unwind_SetGR(_Unwind_Context *context, I64 reg, U64 value)
{
    if (!context || reg < 0 || reg > 31) return;
    context->registers[reg] = value;
}

// Get instruction pointer
U64 _Unwind_GetIP(_Unwind_Context *context)
{
    if (!context) return 0;
    return context->ip;
}

// Set instruction pointer (for resuming)
U0 _Unwind_SetIP(_Unwind_Context *context, U64 ip)
{
    if (!context) return;
    context->ip = ip;
}

// Get Canonical Frame Address
U64 _Unwind_GetCFA(_Unwind_Context *context)
{
    if (!context) return 0;
    return context->cfa;
}

// Get Language Specific Data Area
U8 *_Unwind_GetLanguageSpecificData(_Unwind_Context *context)
{
    if (!context) return NULL;
    return context->lsda;
}

// Get region start (function start address)
U64 _Unwind_GetRegionStart(_Unwind_Context *context)
{
    // Simplified: return 0 (would need frame info)
    return 0;
}

// Get data relocation base
U64 _Unwind_GetDataRelBase(_Unwind_Context *context)
{
    return 0;
}

// Get text relocation base
U64 _Unwind_GetTextRelBase(_Unwind_Context *context)
{
    return 0;
}

// ============================================================================
// EXCEPTION RAISING
// ============================================================================

// Current exception being processed (thread-local in real implementation)
static _Unwind_Exception *g_current_unwind_exception = NULL;

// Raise an exception - initiate unwinding
I64 _Unwind_RaiseException(_Unwind_Exception *exception)
{
    if (!exception) return _URC_FATAL_PHASE1_ERROR;

    // Store for later retrieval
    g_current_unwind_exception = exception;

    // In ZealOS, we use the native exception mechanism
    // This simplified version just stores the exception and returns
    // Real implementation would walk the stack looking for handlers

    // Phase 1: Search for handler
    // (Simplified: we skip this and go directly to phase 2)

    // Phase 2: Cleanup and transfer control
    // In a real implementation, we'd walk the stack, calling
    // personality routines to find handlers and run cleanup code

    // For now, just return that we need to continue unwinding
    // The C++ ABI layer (__cxa_throw) will handle the ZealOS throw
    return _URC_CONTINUE_UNWIND;
}

// Resume unwinding after foreign exception catch
I64 _Unwind_Resume_or_Rethrow(_Unwind_Exception *exception)
{
    return _Unwind_RaiseException(exception);
}

// Resume unwinding (called from landing pad)
U0 _Unwind_Resume(_Unwind_Exception *exception)
{
    // Continue unwinding - this should not return
    _Unwind_RaiseException(exception);
    abort();  // Should never reach here
}

// ============================================================================
// FORCED UNWINDING
// ============================================================================

// Stop function type
typedef I64 (*_Unwind_Stop_Fn)(I64 version, I64 actions,
                               U64 exception_class,
                               _Unwind_Exception *exception,
                               _Unwind_Context *context,
                               U8 *stop_parameter);

// Force unwinding with stop function
I64 _Unwind_ForcedUnwind(_Unwind_Exception *exception,
                         _Unwind_Stop_Fn stop_fn,
                         U8 *stop_parameter)
{
    // Simplified: not fully implemented
    return _URC_FATAL_PHASE2_ERROR;
}

// ============================================================================
// BACKTRACE SUPPORT
// ============================================================================

// Backtrace callback type
typedef I64 (*_Unwind_Trace_Fn)(_Unwind_Context *context, U8 *arg);

// Walk the stack, calling trace_fn for each frame
I64 _Unwind_Backtrace(_Unwind_Trace_Fn trace_fn, U8 *arg)
{
    // Simplified backtrace using frame pointers
    // Real implementation would use DWARF unwind info

    _Unwind_Context context;
    MemSet(&context, 0, sizeof(context));

    // Get current frame pointer and return address
    // This is x86_64 specific
    U64 *rbp;
    U64 rip;

    // Get current RBP (frame pointer)
    // In real code, this would be inline assembly
    // asm("mov %%rbp, %0" : "=r"(rbp));

    // Simplified: just return, as we can't do real stack walking easily
    return _URC_END_OF_STACK;
}

// ============================================================================
// FIND FDE (FRAME DESCRIPTION ENTRY)
// ============================================================================

// Find FDE for a given PC
U8 *_Unwind_Find_FDE(U8 *pc, U8 **bases)
{
    // Simplified: not implemented
    // Real implementation would search .eh_frame section
    return NULL;
}

// ============================================================================
// DELETE EXCEPTION
// ============================================================================

U0 _Unwind_DeleteException(_Unwind_Exception *exception)
{
    if (!exception) return;

    if (exception->exception_cleanup) {
        exception->exception_cleanup(_URC_FOREIGN_EXCEPTION_CAUGHT, exception);
    }
}

// ============================================================================
// INITIALIZATION
// ============================================================================

"ZealOS unwind support loaded.\n";
"  - _Unwind_RaiseException, _Unwind_Resume\n";
"  - _Unwind_GetGR, _Unwind_SetGR\n";
"  - _Unwind_GetIP, _Unwind_SetIP\n";
