// TestLibc.ZC - Test suite for ZealOS libc

Cd(__DIR__);;
Cd("..");;
#include "MakeLibc"

// ============================================================================
// TEST: C-STYLE MAIN FUNCTION
// ============================================================================

I64 test_main(I64 argc, U8 **argv)
{
    printf("Hello from C-style main!\n");
    printf("argc = %d\n", argc);

    for (I64 i = 0; i < argc; i++)
        printf("argv[%d] = \"%s\"\n", i, argv[i]);

    return 0;
}

// ============================================================================
// TEST: STRING FUNCTIONS
// ============================================================================

U0 TestStrings()
{
    U8 buf[256];

    printf("\n=== String Tests ===\n");

    // strlen
    printf("strlen(\"hello\") = %d\n", strlen("hello"));

    // strcpy
    strcpy(buf, "Hello, World!");
    printf("strcpy result: \"%s\"\n", buf);

    // strcat
    strcpy(buf, "Hello");
    strcat(buf, ", ZealOS!");
    printf("strcat result: \"%s\"\n", buf);

    // strcmp
    printf("strcmp(\"abc\", \"abc\") = %d\n", strcmp("abc", "abc"));
    printf("strcmp(\"abc\", \"abd\") = %d\n", strcmp("abc", "abd"));
    printf("strcmp(\"abd\", \"abc\") = %d\n", strcmp("abd", "abc"));

    // strchr
    U8 *p = strchr("hello", 'l');
    printf("strchr(\"hello\", 'l') = \"%s\"\n", p ? p : "(null)");

    // strstr
    p = strstr("hello world", "wor");
    printf("strstr(\"hello world\", \"wor\") = \"%s\"\n", p ? p : "(null)");

    // strtok
    strcpy(buf, "one,two,three,four");
    p = strtok(buf, ",");
    while (p) {
        printf("  token: \"%s\"\n", p);
        p = strtok(NULL, ",");
    }

    printf("String tests passed!\n");
}

// ============================================================================
// TEST: MEMORY FUNCTIONS
// ============================================================================

U0 TestMemory()
{
    printf("\n=== Memory Tests ===\n");

    // malloc/free
    U8 *ptr = malloc(100);
    if (ptr) {
        printf("malloc(100) succeeded\n");
        memset(ptr, 'A', 99);
        ptr[99] = 0;
        printf("memset result: first char = '%c'\n", ptr[0]);
        free(ptr);
        printf("free() succeeded\n");
    }

    // calloc
    I64 *nums = calloc(10, sizeof(I64));
    if (nums) {
        printf("calloc(10, 8) succeeded, first element = %d\n", nums[0]);
        free(nums);
    }

    // memcpy
    U8 src[32] = "Hello, memcpy!";
    U8 dst[32];
    memcpy(dst, src, 32);
    printf("memcpy result: \"%s\"\n", dst);

    // memcmp
    printf("memcmp(\"abc\", \"abc\", 3) = %d\n", memcmp("abc", "abc", 3));
    printf("memcmp(\"abc\", \"abd\", 3) = %d\n", memcmp("abc", "abd", 3));

    printf("Memory tests passed!\n");
}

// ============================================================================
// TEST: STDIO FUNCTIONS
// ============================================================================

U0 TestStdio()
{
    printf("\n=== Stdio Tests ===\n");

    // printf formats
    printf("Integer: %d\n", 42);
    printf("Negative: %d\n", -123);
    printf("Unsigned: %u\n", 4294967295);
    printf("Hex: 0x%x\n", 255);
    printf("Hex upper: 0x%X\n", 255);
    printf("Octal: %o\n", 64);
    printf("String: %s\n", "hello");
    printf("Char: %c\n", 'Z');
    printf("Pointer: %p\n", &printf);
    printf("Width: [%10d]\n", 42);
    printf("Left: [%-10d]\n", 42);
    printf("Zero: [%010d]\n", 42);
    printf("Float: %f\n", 3.14159);
    printf("Precision: %.2f\n", 3.14159);

    // sprintf
    U8 buf[256];
    sprintf(buf, "Formatted: %d + %d = %d", 2, 3, 5);
    printf("sprintf result: \"%s\"\n", buf);

    // snprintf
    snprintf(buf, 10, "This is a very long string");
    printf("snprintf(10) result: \"%s\" (len=%d)\n", buf, strlen(buf));

    printf("Stdio tests passed!\n");
}

// ============================================================================
// TEST: CTYPE FUNCTIONS
// ============================================================================

U0 TestCtype()
{
    printf("\n=== Ctype Tests ===\n");

    printf("isalpha('A') = %d\n", isalpha('A'));
    printf("isalpha('5') = %d\n", isalpha('5'));
    printf("isdigit('5') = %d\n", isdigit('5'));
    printf("isdigit('A') = %d\n", isdigit('A'));
    printf("isspace(' ') = %d\n", isspace(' '));
    printf("isspace('A') = %d\n", isspace('A'));
    printf("toupper('a') = '%c'\n", toupper('a'));
    printf("tolower('Z') = '%c'\n", tolower('Z'));

    printf("Ctype tests passed!\n");
}

// ============================================================================
// TEST: STDLIB FUNCTIONS
// ============================================================================

U0 TestStdlib()
{
    printf("\n=== Stdlib Tests ===\n");

    // atoi
    printf("atoi(\"123\") = %d\n", atoi("123"));
    printf("atoi(\"-456\") = %d\n", atoi("-456"));

    // strtol
    U8 *end;
    printf("strtol(\"0xFF\", 16) = %d\n", strtol("0xFF", &end, 16));
    printf("strtol(\"777\", 8) = %d\n", strtol("777", &end, 8));

    // abs
    printf("abs(-42) = %d\n", abs(-42));

    // rand
    srand(12345);
    printf("rand() = %d\n", rand());
    printf("rand() = %d\n", rand());
    printf("rand() = %d\n", rand());

    // qsort
    I64 arr[5] = {5, 2, 8, 1, 9};
    I64 int_cmp(I64 *a, I64 *b) { return *a - *b; }
    qsort(arr, 5, sizeof(I64), &int_cmp);
    printf("qsort result: %d %d %d %d %d\n", arr[0], arr[1], arr[2], arr[3], arr[4]);

    printf("Stdlib tests passed!\n");
}

// ============================================================================
// TEST: FILE I/O
// ============================================================================

U0 TestFileIO()
{
    printf("\n=== File I/O Tests ===\n");

    // Write a test file
    FILE *fp = fopen("/Tmp/test_libc.txt", "w");
    if (fp) {
        fprintf(fp, "Line 1: Hello\n");
        fprintf(fp, "Line 2: World\n");
        fprintf(fp, "Line 3: Test\n");
        fclose(fp);
        printf("Wrote test file\n");

        // Read it back
        fp = fopen("/Tmp/test_libc.txt", "r");
        if (fp) {
            U8 line[256];
            printf("Reading back:\n");
            while (fgets(line, sizeof(line), fp)) {
                printf("  %s", line);
            }
            fclose(fp);
        }

        // Clean up
        remove("/Tmp/test_libc.txt");
        printf("File I/O tests passed!\n");
    } else {
        printf("Could not create test file (this is OK if /Tmp doesn't exist)\n");
    }
}

// ============================================================================
// RUN ALL TESTS
// ============================================================================

U0 RunAllTests()
{
    printf("========================================\n");
    printf("ZealOS libc Test Suite\n");
    printf("========================================\n");

    TestStrings();
    TestMemory();
    TestStdio();
    TestCtype();
    TestStdlib();
    TestFileIO();

    printf("\n========================================\n");
    printf("All tests completed!\n");
    printf("========================================\n");
}

// ============================================================================
// MAIN
// ============================================================================

"ZealOS libc Test Suite\n";
"Run: RunAllTests();   - Run all tests\n";
"Run: CMain(&test_main, argc, argv);  - Test C-style main\n";
"Run: CRun(&test_main, \"prog arg1 arg2\");  - Test command line parsing\n";
