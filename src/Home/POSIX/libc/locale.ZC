// locale.ZC - Locale Support for ZealOS
// Part of the POSIX compatibility layer
//
// Provides setlocale, localeconv, etc.

// ============================================================================
// LOCALE CATEGORIES
// ============================================================================

#define LC_CTYPE    0
#define LC_NUMERIC  1
#define LC_TIME     2
#define LC_COLLATE  3
#define LC_MONETARY 4
#define LC_MESSAGES 5
#define LC_ALL      6

#define LC_CTYPE_MASK    (1 << LC_CTYPE)
#define LC_NUMERIC_MASK  (1 << LC_NUMERIC)
#define LC_TIME_MASK     (1 << LC_TIME)
#define LC_COLLATE_MASK  (1 << LC_COLLATE)
#define LC_MONETARY_MASK (1 << LC_MONETARY)
#define LC_MESSAGES_MASK (1 << LC_MESSAGES)
#define LC_ALL_MASK      0x3F

// ============================================================================
// LOCALE CONVENTIONS STRUCTURE
// ============================================================================

class lconv {
    // Numeric (non-monetary)
    U8 *decimal_point;      // Decimal point character
    U8 *thousands_sep;      // Thousands separator
    U8 *grouping;           // Grouping (CHAR_MAX = no grouping)

    // Monetary
    U8 *int_curr_symbol;    // International currency symbol
    U8 *currency_symbol;    // Local currency symbol
    U8 *mon_decimal_point;  // Monetary decimal point
    U8 *mon_thousands_sep;  // Monetary thousands separator
    U8 *mon_grouping;       // Monetary grouping
    U8 *positive_sign;      // Positive sign
    U8 *negative_sign;      // Negative sign

    // Monetary formatting
    U8 int_frac_digits;     // International fractional digits
    U8 frac_digits;         // Local fractional digits
    U8 p_cs_precedes;       // 1 if currency symbol precedes positive
    U8 p_sep_by_space;      // 1 if space separates currency and positive
    U8 n_cs_precedes;       // 1 if currency symbol precedes negative
    U8 n_sep_by_space;      // 1 if space separates currency and negative
    U8 p_sign_posn;         // Positive sign position
    U8 n_sign_posn;         // Negative sign position

    // POSIX extensions
    U8 int_p_cs_precedes;
    U8 int_p_sep_by_space;
    U8 int_n_cs_precedes;
    U8 int_n_sep_by_space;
    U8 int_p_sign_posn;
    U8 int_n_sign_posn;
};

// ============================================================================
// LOCALE STATE
// ============================================================================

class CLocaleState {
    U8 lc_ctype[64];
    U8 lc_numeric[64];
    U8 lc_time[64];
    U8 lc_collate[64];
    U8 lc_monetary[64];
    U8 lc_messages[64];
    U8 lc_all[64];
    Bool initialized;
};

static CLocaleState g_locale_state;
static lconv g_lconv;

// Static strings for lconv
static U8 g_decimal_point[4] = ".";
static U8 g_thousands_sep[4] = ",";
static U8 g_grouping[4] = "\x03\x03";  // Groups of 3
static U8 g_int_curr_symbol[8] = "USD ";
static U8 g_currency_symbol[4] = "$";
static U8 g_positive_sign[4] = "";
static U8 g_negative_sign[4] = "-";
static U8 g_empty[4] = "";

// ============================================================================
// INITIALIZATION
// ============================================================================

U0 locale_init()
{
    if (g_locale_state.initialized) return;

    // Set default locale names (POSIX/C locale)
    StrCpy(g_locale_state.lc_ctype, "C");
    StrCpy(g_locale_state.lc_numeric, "C");
    StrCpy(g_locale_state.lc_time, "C");
    StrCpy(g_locale_state.lc_collate, "C");
    StrCpy(g_locale_state.lc_monetary, "C");
    StrCpy(g_locale_state.lc_messages, "C");
    StrCpy(g_locale_state.lc_all, "C");

    // Initialize lconv with C locale defaults
    g_lconv.decimal_point = g_decimal_point;
    g_lconv.thousands_sep = g_empty;
    g_lconv.grouping = g_empty;
    g_lconv.int_curr_symbol = g_empty;
    g_lconv.currency_symbol = g_empty;
    g_lconv.mon_decimal_point = g_empty;
    g_lconv.mon_thousands_sep = g_empty;
    g_lconv.mon_grouping = g_empty;
    g_lconv.positive_sign = g_empty;
    g_lconv.negative_sign = g_empty;

    g_lconv.int_frac_digits = 0xFF;  // CHAR_MAX
    g_lconv.frac_digits = 0xFF;
    g_lconv.p_cs_precedes = 0xFF;
    g_lconv.p_sep_by_space = 0xFF;
    g_lconv.n_cs_precedes = 0xFF;
    g_lconv.n_sep_by_space = 0xFF;
    g_lconv.p_sign_posn = 0xFF;
    g_lconv.n_sign_posn = 0xFF;

    g_lconv.int_p_cs_precedes = 0xFF;
    g_lconv.int_p_sep_by_space = 0xFF;
    g_lconv.int_n_cs_precedes = 0xFF;
    g_lconv.int_n_sep_by_space = 0xFF;
    g_lconv.int_p_sign_posn = 0xFF;
    g_lconv.int_n_sign_posn = 0xFF;

    g_locale_state.initialized = TRUE;
}

// ============================================================================
// LOCALE FUNCTIONS
// ============================================================================

// Set locale
U8 *setlocale(I64 category, U8 *locale)
{
    locale_init();

    // If locale is NULL, return current locale
    if (!locale) {
        switch (category) {
            case LC_CTYPE:    return g_locale_state.lc_ctype;
            case LC_NUMERIC:  return g_locale_state.lc_numeric;
            case LC_TIME:     return g_locale_state.lc_time;
            case LC_COLLATE:  return g_locale_state.lc_collate;
            case LC_MONETARY: return g_locale_state.lc_monetary;
            case LC_MESSAGES: return g_locale_state.lc_messages;
            case LC_ALL:      return g_locale_state.lc_all;
            default:          return NULL;
        }
    }

    // Empty string means use environment
    U8 *new_locale = locale;
    if (locale[0] == 0) {
        // Check environment variables
        U8 *env = getenv("LC_ALL");
        if (!env) env = getenv("LANG");
        if (!env) env = "C";
        new_locale = env;
    }

    // We only really support "C", "POSIX", and "en_US.UTF-8" variants
    Bool is_valid = (StrCmp(new_locale, "C") == 0 ||
                    StrCmp(new_locale, "POSIX") == 0 ||
                    StrNICmp(new_locale, "en_US", 5) == 0 ||
                    StrNICmp(new_locale, "en_GB", 5) == 0);

    if (!is_valid) {
        // Fall back to C locale for unsupported locales
        new_locale = "C";
    }

    // Set the locale
    U8 *result = NULL;
    switch (category) {
        case LC_CTYPE:
            StrCpy(g_locale_state.lc_ctype, new_locale);
            result = g_locale_state.lc_ctype;
            break;
        case LC_NUMERIC:
            StrCpy(g_locale_state.lc_numeric, new_locale);
            // Update lconv for numeric
            if (StrNICmp(new_locale, "en_US", 5) == 0) {
                g_lconv.decimal_point = g_decimal_point;
                g_lconv.thousands_sep = g_thousands_sep;
                g_lconv.grouping = g_grouping;
            } else {
                g_lconv.decimal_point = g_decimal_point;
                g_lconv.thousands_sep = g_empty;
                g_lconv.grouping = g_empty;
            }
            result = g_locale_state.lc_numeric;
            break;
        case LC_TIME:
            StrCpy(g_locale_state.lc_time, new_locale);
            result = g_locale_state.lc_time;
            break;
        case LC_COLLATE:
            StrCpy(g_locale_state.lc_collate, new_locale);
            result = g_locale_state.lc_collate;
            break;
        case LC_MONETARY:
            StrCpy(g_locale_state.lc_monetary, new_locale);
            // Update lconv for monetary
            if (StrNICmp(new_locale, "en_US", 5) == 0) {
                g_lconv.int_curr_symbol = g_int_curr_symbol;
                g_lconv.currency_symbol = g_currency_symbol;
                g_lconv.mon_decimal_point = g_decimal_point;
                g_lconv.mon_thousands_sep = g_thousands_sep;
                g_lconv.mon_grouping = g_grouping;
                g_lconv.positive_sign = g_positive_sign;
                g_lconv.negative_sign = g_negative_sign;
                g_lconv.int_frac_digits = 2;
                g_lconv.frac_digits = 2;
                g_lconv.p_cs_precedes = 1;
                g_lconv.p_sep_by_space = 0;
                g_lconv.n_cs_precedes = 1;
                g_lconv.n_sep_by_space = 0;
                g_lconv.p_sign_posn = 1;
                g_lconv.n_sign_posn = 1;
            }
            result = g_locale_state.lc_monetary;
            break;
        case LC_MESSAGES:
            StrCpy(g_locale_state.lc_messages, new_locale);
            result = g_locale_state.lc_messages;
            break;
        case LC_ALL:
            StrCpy(g_locale_state.lc_all, new_locale);
            StrCpy(g_locale_state.lc_ctype, new_locale);
            StrCpy(g_locale_state.lc_numeric, new_locale);
            StrCpy(g_locale_state.lc_time, new_locale);
            StrCpy(g_locale_state.lc_collate, new_locale);
            StrCpy(g_locale_state.lc_monetary, new_locale);
            StrCpy(g_locale_state.lc_messages, new_locale);
            // Recursively set all categories
            setlocale(LC_NUMERIC, new_locale);
            setlocale(LC_MONETARY, new_locale);
            result = g_locale_state.lc_all;
            break;
        default:
            return NULL;
    }

    return result;
}

// Get locale conventions
lconv *localeconv()
{
    locale_init();
    return &g_lconv;
}

// ============================================================================
// NEWLOCALE / USELOCALE (POSIX.1-2008)
// ============================================================================

// Locale object type
#define locale_t U64

// Global locale constant
#define LC_GLOBAL_LOCALE ((locale_t)-1)

// Current thread locale (we're single-threaded, so just use global)
static locale_t g_current_locale = 0;

// Create a new locale object
locale_t newlocale(I64 category_mask, U8 *locale, locale_t base)
{
    // Simplified: just return a token, we don't really create new locales
    return 1;
}

// Free a locale object
U0 freelocale(locale_t loc)
{
    // Nothing to free in our simplified implementation
}

// Duplicate a locale object
locale_t duplocale(locale_t loc)
{
    return loc;
}

// Use a locale object
locale_t uselocale(locale_t loc)
{
    locale_t old = g_current_locale;

    if (loc != 0) {
        g_current_locale = loc;
    }

    return old ? old : LC_GLOBAL_LOCALE;
}

// ============================================================================
// LANGINFO (nl_langinfo)
// ============================================================================

// nl_langinfo items
#define CODESET       0
#define D_T_FMT       1
#define D_FMT         2
#define T_FMT         3
#define T_FMT_AMPM    4
#define AM_STR        5
#define PM_STR        6
#define DAY_1         7
#define DAY_2         8
#define DAY_3         9
#define DAY_4         10
#define DAY_5         11
#define DAY_6         12
#define DAY_7         13
#define ABDAY_1       14
#define ABDAY_2       15
#define ABDAY_3       16
#define ABDAY_4       17
#define ABDAY_5       18
#define ABDAY_6       19
#define ABDAY_7       20
#define MON_1         21
#define MON_2         22
#define MON_3         23
#define MON_4         24
#define MON_5         25
#define MON_6         26
#define MON_7         27
#define MON_8         28
#define MON_9         29
#define MON_10        30
#define MON_11        31
#define MON_12        32
#define ABMON_1       33
#define ABMON_2       34
#define ABMON_3       35
#define ABMON_4       36
#define ABMON_5       37
#define ABMON_6       38
#define ABMON_7       39
#define ABMON_8       40
#define ABMON_9       41
#define ABMON_10      42
#define ABMON_11      43
#define ABMON_12      44
#define ERA           45
#define ERA_D_FMT     46
#define ERA_D_T_FMT   47
#define ERA_T_FMT     48
#define ALT_DIGITS    49
#define RADIXCHAR     50
#define THOUSEP       51
#define YESEXPR       52
#define NOEXPR        53
#define CRNCYSTR      54

// Day and month name arrays
static U8 *g_day_names[] = {
    "Sunday", "Monday", "Tuesday", "Wednesday",
    "Thursday", "Friday", "Saturday"
};

static U8 *g_abday_names[] = {
    "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
};

static U8 *g_mon_names[] = {
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December"
};

static U8 *g_abmon_names[] = {
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
};

// Get locale-specific information
U8 *nl_langinfo(I64 item)
{
    locale_init();

    switch (item) {
        case CODESET:     return "UTF-8";
        case D_T_FMT:     return "%a %b %e %H:%M:%S %Y";
        case D_FMT:       return "%m/%d/%y";
        case T_FMT:       return "%H:%M:%S";
        case T_FMT_AMPM:  return "%I:%M:%S %p";
        case AM_STR:      return "AM";
        case PM_STR:      return "PM";

        case DAY_1: case DAY_2: case DAY_3: case DAY_4:
        case DAY_5: case DAY_6: case DAY_7:
            return g_day_names[item - DAY_1];

        case ABDAY_1: case ABDAY_2: case ABDAY_3: case ABDAY_4:
        case ABDAY_5: case ABDAY_6: case ABDAY_7:
            return g_abday_names[item - ABDAY_1];

        case MON_1: case MON_2: case MON_3: case MON_4:
        case MON_5: case MON_6: case MON_7: case MON_8:
        case MON_9: case MON_10: case MON_11: case MON_12:
            return g_mon_names[item - MON_1];

        case ABMON_1: case ABMON_2: case ABMON_3: case ABMON_4:
        case ABMON_5: case ABMON_6: case ABMON_7: case ABMON_8:
        case ABMON_9: case ABMON_10: case ABMON_11: case ABMON_12:
            return g_abmon_names[item - ABMON_1];

        case ERA:         return "";
        case ERA_D_FMT:   return "";
        case ERA_D_T_FMT: return "";
        case ERA_T_FMT:   return "";
        case ALT_DIGITS:  return "";
        case RADIXCHAR:   return ".";
        case THOUSEP:     return ",";
        case YESEXPR:     return "^[yY]";
        case NOEXPR:      return "^[nN]";
        case CRNCYSTR:    return "$";

        default:          return "";
    }
}

// ============================================================================
// INITIALIZATION MESSAGE
// ============================================================================

locale_init();
"ZealOS locale library loaded.\n";
"  - Locale: setlocale, localeconv, nl_langinfo\n";
"  - Supports: C, POSIX, en_US locales\n";
