// MakeLibc.ZC - ZealOS libc Loader
// Include this file to load the C standard library compatibility layer

Cd(__DIR__);;

// ============================================================================
// CORE POSIX LAYER (required)
// ============================================================================

// Make sure POSIX layer is loaded first
Cd("..");;
#include "MakePOSIX"
Cd("libc");;

