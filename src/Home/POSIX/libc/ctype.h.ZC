// ctype.h - Character classification for ZealOS libc

#ifndef _CTYPE_H
#define _CTYPE_H

// Character classification functions

Bool isalpha(I64 c)
{
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}

Bool isdigit(I64 c)
{
    return c >= '0' && c <= '9';
}

Bool isalnum(I64 c)
{
    return isalpha(c) || isdigit(c);
}

Bool isxdigit(I64 c)
{
    return isdigit(c) || (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f');
}

Bool isspace(I64 c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}

Bool isupper(I64 c)
{
    return c >= 'A' && c <= 'Z';
}

Bool islower(I64 c)
{
    return c >= 'a' && c <= 'z';
}

Bool ispunct(I64 c)
{
    return (c >= '!' && c <= '/') ||
           (c >= ':' && c <= '@') ||
           (c >= '[' && c <= '`') ||
           (c >= '{' && c <= '~');
}

Bool isprint(I64 c)
{
    return c >= ' ' && c <= '~';
}

Bool isgraph(I64 c)
{
    return c > ' ' && c <= '~';
}

Bool iscntrl(I64 c)
{
    return (c >= 0 && c < ' ') || c == 0x7F;
}

Bool isblank(I64 c)
{
    return c == ' ' || c == '\t';
}

Bool isascii(I64 c)
{
    return c >= 0 && c <= 127;
}

// Character conversion functions

I64 toupper(I64 c)
{
    if (c >= 'a' && c <= 'z')
        return c - 32;
    return c;
}

I64 tolower(I64 c)
{
    if (c >= 'A' && c <= 'Z')
        return c + 32;
    return c;
}

I64 toascii(I64 c)
{
    return c & 0x7F;
}

// Locale-aware versions (just call the regular versions for now)
Bool isalpha_l(I64 c, U64 locale) { return isalpha(c); }
Bool isdigit_l(I64 c, U64 locale) { return isdigit(c); }
Bool isalnum_l(I64 c, U64 locale) { return isalnum(c); }
Bool isxdigit_l(I64 c, U64 locale) { return isxdigit(c); }
Bool isspace_l(I64 c, U64 locale) { return isspace(c); }
Bool isupper_l(I64 c, U64 locale) { return isupper(c); }
Bool islower_l(I64 c, U64 locale) { return islower(c); }
Bool ispunct_l(I64 c, U64 locale) { return ispunct(c); }
Bool isprint_l(I64 c, U64 locale) { return isprint(c); }
Bool isgraph_l(I64 c, U64 locale) { return isgraph(c); }
Bool iscntrl_l(I64 c, U64 locale) { return iscntrl(c); }
Bool isblank_l(I64 c, U64 locale) { return isblank(c); }
I64 toupper_l(I64 c, U64 locale) { return toupper(c); }
I64 tolower_l(I64 c, U64 locale) { return tolower(c); }

#endif // _CTYPE_H
