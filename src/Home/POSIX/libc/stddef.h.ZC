// stddef.h - Standard definitions for ZealOS libc
// Maps to ZealOS types

#ifndef _STDDEF_H
#define _STDDEF_H

// NULL pointer
#ifndef NULL
#define NULL 0
#endif

// Size types - ZealOS is 64-bit
typedef U64 size_t;
typedef I64 ssize_t;
typedef I64 ptrdiff_t;

// Wide character type
typedef I32 wchar_t;

// offsetof macro
#define offsetof(type, member) ((size_t)&((type *)0)->member)

#endif // _STDDEF_H
