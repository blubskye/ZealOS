    DynRegisterSymbol("setbuf", &setbuf);
    DynRegisterSymbol("perror", &perror);
    DynRegisterSymbol("remove", &remove);
    DynRegisterSymbol("rename", &rename);
    DynRegisterSymbol("tmpfile", &tmpfile);
    DynRegisterSymbol("tmpnam", &tmpnam);
    DynRegisterSymbol("fdopen", &fdopen);
    DynRegisterSymbol("freopen", &freopen);
    DynRegisterSymbol("fgetpos", &fgetpos);
    DynRegisterSymbol("fsetpos", &fsetpos);
    DynRegisterSymbol("sscanf", &sscanf);
