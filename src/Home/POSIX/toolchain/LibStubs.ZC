// ============================================================================
// FAKE LIBRARY HANDLES
// ============================================================================

// Create fake library entries for common .so files
// This lets binaries that need libc.so.6 find our symbols

class CFakeLib {
    U8  *name;          // Library name (e.g., "libc.so.6")
    U8  *soname;        // SONAME
};

static CFakeLib g_fake_libs[] = {
    {"libc.so.6",           "libc.so.6"},
    {"libc.so",             "libc.so.6"},
    {"libm.so.6",           "libm.so.6"},
    {"libm.so",             "libm.so.6"},
    {"libpthread.so.0",     "libpthread.so.0"},
    {"libpthread.so",       "libpthread.so.0"},
    {"libdl.so.2",          "libdl.so.2"},
    {"libdl.so",            "libdl.so.2"},
    {"librt.so.1",          "librt.so.1"},
    {"librt.so",            "librt.so.1"},
    {"libgcc_s.so.1",       "libgcc_s.so.1"},
    {"libgcc_s.so",         "libgcc_s.so.1"},
    {"libstdc++.so.6",      "libstdc++.so.6"},
    {"libstdc++.so",        "libstdc++.so.6"},
    {"libncurses.so.6",     "libncurses.so.6"},
    {"libncurses.so.5",     "libncurses.so.5"},
    {"libncurses.so",       "libncurses.so.6"},
    {"libncursesw.so.6",    "libncursesw.so.6"},
    {"libncursesw.so",      "libncursesw.so.6"},
    {"libresolv.so.2",      "libresolv.so.2"},
    {"libresolv.so",        "libresolv.so.2"},
    {"libnsl.so.1",         "libnsl.so.1"},
    {"libnsl.so",           "libnsl.so.1"},
    {"libcrypt.so.1",       "libcrypt.so.1"},
    {"libcrypt.so",         "libcrypt.so.1"},
    {"libutil.so.1",        "libutil.so.1"},
    {"libutil.so",          "libutil.so.1"},
    {"ld-linux-x86-64.so.2","ld-linux-x86-64.so.2"},
    {NULL, NULL}
};

Bool DynIsFakeLib(U8 *name)
{
    for (I64 i = 0; g_fake_libs[i].name; i++) {
        if (StrCmp(name, g_fake_libs[i].name) == 0)
            return TRUE;
    }
    return FALSE;
}

// ============================================================================
// INITIALIZATION
// ============================================================================

U0 DynLinkInitSymbols()
{
    CDynLinker *dl = DynLinkInit();

    // Register all ZealOS-provided symbols
    DynRegisterLibcSymbols();
}

// Auto-initialize when loaded
DynLinkInitSymbols();

"ZealOS library stubs registered.\n";
"  Fake libraries: libc.so.6, libm.so.6, libpthread.so.0, etc.\n";
