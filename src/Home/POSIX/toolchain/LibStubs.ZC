// LibStubs.ZC - Standard Library Stubs for ZealOS Dynamic Linker
// Part of the POSIX compatibility layer
//
// Creates stub shared libraries that redirect to ZealOS implementations.
// These allow dynamically-linked binaries to find their dependencies.

// ============================================================================
// LIBRARY STUB REGISTRATION
// ============================================================================

// Register all ZealOS-provided symbols as if they came from standard libraries
// This makes libc.so.6, libpthread.so.0, etc. "available" without actual .so files

U0 DynRegisterLibcSymbols()
{
    CDynLinker *dl = DynLinkInit();

    // ========================================================================
    // LIBC SYMBOLS
    // ========================================================================

    // stdio
    DynRegisterSymbol("printf", &printf);
    DynRegisterSymbol("fprintf", &fprintf);
    DynRegisterSymbol("sprintf", &sprintf);
    DynRegisterSymbol("snprintf", &snprintf);
    DynRegisterSymbol("vprintf", &vprintf);
    DynRegisterSymbol("vfprintf", &vfprintf);
    DynRegisterSymbol("vsprintf", &vsprintf);
    DynRegisterSymbol("vsnprintf", &vsnprintf);
    DynRegisterSymbol("puts", &puts);
    DynRegisterSymbol("putchar", &putchar);
    DynRegisterSymbol("putc", &putc);
    DynRegisterSymbol("fputc", &fputc);
    DynRegisterSymbol("getc", &getc);
    DynRegisterSymbol("fgetc", &fgetc);
    DynRegisterSymbol("getchar", &getchar);
    DynRegisterSymbol("ungetc", &ungetc);
    DynRegisterSymbol("fopen", &fopen);
    DynRegisterSymbol("fclose", &fclose);
    DynRegisterSymbol("fread", &fread);
    DynRegisterSymbol("fwrite", &fwrite);
    DynRegisterSymbol("fgets", &fgets);
    DynRegisterSymbol("fputs", &fputs);
    DynRegisterSymbol("fflush", &fflush);
    DynRegisterSymbol("fseek", &fseek);
