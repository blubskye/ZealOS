// ============================================================================
// SYMBOL TABLE
// ============================================================================

#define TCC_MAX_SYMBOLS 4096

class CTCCSymbol {
    U8      *name;
    void    *value;
    Bool    in_use;
};

CTCCSymbol tcc_symbols[TCC_MAX_SYMBOLS];
Bool tcc_symbols_init = FALSE;

U0 TccSymbolsInit()
{
    if (tcc_symbols_init)
        return;
    MemSet(tcc_symbols, 0, sizeof(tcc_symbols));
    tcc_symbols_init = TRUE;
}

I64 tcc_add_symbol(CTCCState *s, U8 *name, void *val)
{
    TccSymbolsInit();

    // Find free slot
    for (I64 i = 0; i < TCC_MAX_SYMBOLS; i++) {
        if (!tcc_symbols[i].in_use) {
            tcc_symbols[i].name = StrNew(name);
            tcc_symbols[i].value = val;
            tcc_symbols[i].in_use = TRUE;
            return 0;
        }
    }

    tcc_error(s, "symbol table full");
    return -1;
}

void *tcc_get_symbol(CTCCState *s, U8 *name)
{
    TccSymbolsInit();

    for (I64 i = 0; i < TCC_MAX_SYMBOLS; i++) {
        if (tcc_symbols[i].in_use && StrCmp(tcc_symbols[i].name, name) == 0) {
            return tcc_symbols[i].value;
        }
    }

    return NULL;
}

// ============================================================================
// OUTPUT
// ============================================================================

I64 tcc_output_file(CTCCState *s, U8 *filename)
{
    if (!s || !filename)
        return -1;

    if (s->outfile)
        Free(s->outfile);
    s->outfile = StrNew(filename);

    // In a real implementation, this would write the compiled code to file
    if (s->verbose)
        printf("tcc: output file: %s\n", filename);

    return 0;
}

I64 tcc_relocate(CTCCState *s, void *ptr)
{
    if (!s)
        return -1;

    if (ptr == TCC_RELOCATE_AUTO) {
        // Allocate memory for code
        // In real impl, this would be the actual code size
        s->code_size = 65536;  // 64KB placeholder
        s->code_mem = MAlloc(s->code_size);
        if (!s->code_mem)
            return -1;
        return 0;
    }

    // Relocate to provided address
    s->code_mem = ptr;
    return 0;
}

void *tcc_get_code(CTCCState *s, I64 *size)
{
    if (!s)
        return NULL;

    if (size)
        *size = s->code_size;

    return s->code_mem;
}

// ============================================================================
// RUN COMPILED CODE
// ============================================================================

I64 tcc_run(CTCCState *s, I64 argc, U8 **argv)
{
    if (!s)
        return -1;

    // Get main function
    void *main_ptr = tcc_get_symbol(s, "main");
    if (!main_ptr) {
        tcc_error(s, "main function not found");
        return -1;
    }

    // Call main(argc, argv)
    I64 (*main_func)(I64, U8**) = main_ptr;
    return main_func(argc, argv);
}

// ============================================================================
// CONVENIENCE FUNCTIONS
// ============================================================================

I64 tcc_run_string(U8 *code, I64 argc, U8 **argv)
{
    CTCCState *s = tcc_new();
    if (!s)
        return -1;

    tcc_set_output_type(s, TCC_OUTPUT_MEMORY);

    I64 ret = tcc_compile_string(s, code);
    if (ret < 0) {
        tcc_delete(s);
        return ret;
    }

    ret = tcc_relocate(s, TCC_RELOCATE_AUTO);
    if (ret < 0) {
        tcc_delete(s);
        return ret;
    }

    ret = tcc_run(s, argc, argv);

    tcc_delete(s);
    return ret;
}

void *tcc_compile_func(U8 *code, U8 *func_name)
{
    CTCCState *s = tcc_new();
    if (!s)
        return NULL;

    tcc_set_output_type(s, TCC_OUTPUT_MEMORY);

    if (tcc_compile_string(s, code) < 0) {
        tcc_delete(s);
        return NULL;
    }

    if (tcc_relocate(s, TCC_RELOCATE_AUTO) < 0) {
        tcc_delete(s);
        return NULL;
    }

    void *func = tcc_get_symbol(s, func_name);

    // Note: We don't delete s here because the code is still in use
    // The caller is responsible for the lifetime

    return func;
}

// ============================================================================
// REGISTER ZEALOS SYMBOLS FOR TCC
// ============================================================================

// Forward declarations of POSIX/libc functions
extern I64 printf(U8 *fmt, ...);
extern I64 fprintf(FILE *stream, U8 *fmt, ...);
extern I64 sprintf(U8 *buf, U8 *fmt, ...);
extern I64 snprintf(U8 *buf, I64 size, U8 *fmt, ...);
extern void *malloc(I64 size);
extern void *calloc(I64 nmemb, I64 size);
extern void *realloc(void *ptr, I64 size);
extern U0 free(void *ptr);
extern I64 strlen(U8 *s);
extern U8 *strcpy(U8 *dest, U8 *src);
extern U8 *strncpy(U8 *dest, U8 *src, I64 n);
extern I64 strcmp(U8 *s1, U8 *s2);
extern I64 strncmp(U8 *s1, U8 *s2, I64 n);
extern U8 *strcat(U8 *dest, U8 *src);
extern U8 *strchr(U8 *s, I64 c);
extern U8 *strrchr(U8 *s, I64 c);
extern U8 *strstr(U8 *haystack, U8 *needle);
extern U8 *strdup(U8 *s);
extern void *memcpy(void *dest, void *src, I64 n);
extern void *memmove(void *dest, void *src, I64 n);
extern void *memset(void *s, I64 c, I64 n);
extern I64 memcmp(void *s1, void *s2, I64 n);
extern I64 atoi(U8 *s);
extern I64 atol(U8 *s);
extern F64 atof(U8 *s);
extern I64 abs(I64 n);
extern FILE *fopen(U8 *path, U8 *mode);
extern I64 fclose(FILE *fp);
extern I64 fread(void *ptr, I64 size, I64 nmemb, FILE *stream);
extern I64 fwrite(void *ptr, I64 size, I64 nmemb, FILE *stream);
extern I64 fseek(FILE *stream, I64 offset, I64 whence);
extern I64 ftell(FILE *stream);
extern I64 fgetc(FILE *stream);
extern I64 fputc(I64 c, FILE *stream);
extern U8 *fgets(U8 *s, I64 size, FILE *stream);
extern I64 fputs(U8 *s, FILE *stream);
extern I64 fflush(FILE *stream);
extern I64 feof(FILE *stream);
extern I64 ferror(FILE *stream);
extern I64 getchar();
extern I64 putchar(I64 c);
extern I64 puts(U8 *s);
extern U0 exit(I64 status);
extern U0 abort();
extern I64 getpid();
extern I64 getppid();
extern I64 getuid();
extern I64 getgid();
extern I64 fork();
extern I64 execve(U8 *path, U8 **argv, U8 **envp);
extern I64 execvp(U8 *file, U8 **argv);
extern I64 waitpid(I64 pid, I64 *status, I64 options);
extern I64 kill(I64 pid, I64 sig);
extern U32 sleep(U32 seconds);
extern I64 usleep(I64 usec);
extern U8 *getenv(U8 *name);
extern I64 setenv(U8 *name, U8 *value, I64 overwrite);
extern I64 unsetenv(U8 *name);
extern I64 open(U8 *path, I64 flags, ...);
extern I64 close(I64 fd);
extern I64 read(I64 fd, void *buf, I64 count);
extern I64 write(I64 fd, void *buf, I64 count);
extern I64 lseek(I64 fd, I64 offset, I64 whence);
extern I64 dup(I64 oldfd);
extern I64 dup2(I64 oldfd, I64 newfd);
extern I64 pipe(I64 *pipefd);
extern I64 stat(U8 *path, void *statbuf);
extern I64 fstat(I64 fd, void *statbuf);
extern I64 access(U8 *path, I64 mode);
extern I64 unlink(U8 *path);
extern I64 rename(U8 *oldpath, U8 *newpath);
extern I64 mkdir(U8 *path, I64 mode);
extern I64 rmdir(U8 *path);
extern I64 chdir(U8 *path);
extern U8 *getcwd(U8 *buf, I64 size);
extern void *mmap(void *addr, I64 length, I64 prot, I64 flags, I64 fd, I64 offset);
extern I64 munmap(void *addr, I64 length);
extern I64 time(I64 *t);

U0 TccRegisterZealOSSymbols(CTCCState *s)
{
    // Standard I/O
    tcc_add_symbol(s, "printf", &printf);
    tcc_add_symbol(s, "fprintf", &fprintf);
    tcc_add_symbol(s, "sprintf", &sprintf);
    tcc_add_symbol(s, "snprintf", &snprintf);
    tcc_add_symbol(s, "puts", &puts);
    tcc_add_symbol(s, "putchar", &putchar);
    tcc_add_symbol(s, "getchar", &getchar);

    // Memory
    tcc_add_symbol(s, "malloc", &malloc);
    tcc_add_symbol(s, "calloc", &calloc);
    tcc_add_symbol(s, "realloc", &realloc);
    tcc_add_symbol(s, "free", &free);

    // String
    tcc_add_symbol(s, "strlen", &strlen);
    tcc_add_symbol(s, "strcpy", &strcpy);
    tcc_add_symbol(s, "strncpy", &strncpy);
    tcc_add_symbol(s, "strcmp", &strcmp);
    tcc_add_symbol(s, "strncmp", &strncmp);
    tcc_add_symbol(s, "strcat", &strcat);
    tcc_add_symbol(s, "strchr", &strchr);
    tcc_add_symbol(s, "strrchr", &strrchr);
    tcc_add_symbol(s, "strstr", &strstr);
    tcc_add_symbol(s, "strdup", &strdup);

    // Memory operations
    tcc_add_symbol(s, "memcpy", &memcpy);
    tcc_add_symbol(s, "memmove", &memmove);
    tcc_add_symbol(s, "memset", &memset);
    tcc_add_symbol(s, "memcmp", &memcmp);

    // Conversion
    tcc_add_symbol(s, "atoi", &atoi);
    tcc_add_symbol(s, "atol", &atol);
    tcc_add_symbol(s, "atof", &atof);
    tcc_add_symbol(s, "abs", &abs);

    // File I/O
    tcc_add_symbol(s, "fopen", &fopen);
    tcc_add_symbol(s, "fclose", &fclose);
    tcc_add_symbol(s, "fread", &fread);
    tcc_add_symbol(s, "fwrite", &fwrite);
    tcc_add_symbol(s, "fseek", &fseek);
    tcc_add_symbol(s, "ftell", &ftell);
    tcc_add_symbol(s, "fgetc", &fgetc);
    tcc_add_symbol(s, "fputc", &fputc);
    tcc_add_symbol(s, "fgets", &fgets);
    tcc_add_symbol(s, "fputs", &fputs);
    tcc_add_symbol(s, "fflush", &fflush);
    tcc_add_symbol(s, "feof", &feof);
    tcc_add_symbol(s, "ferror", &ferror);

    // Process control
    tcc_add_symbol(s, "exit", &exit);
    tcc_add_symbol(s, "abort", &abort);
    tcc_add_symbol(s, "getpid", &getpid);
    tcc_add_symbol(s, "getppid", &getppid);
    tcc_add_symbol(s, "getuid", &getuid);
    tcc_add_symbol(s, "getgid", &getgid);
    tcc_add_symbol(s, "fork", &fork);
    tcc_add_symbol(s, "execve", &execve);
    tcc_add_symbol(s, "execvp", &execvp);
    tcc_add_symbol(s, "waitpid", &waitpid);
    tcc_add_symbol(s, "kill", &kill);
    tcc_add_symbol(s, "sleep", &sleep);
    tcc_add_symbol(s, "usleep", &usleep);

    // Environment
    tcc_add_symbol(s, "getenv", &getenv);
    tcc_add_symbol(s, "setenv", &setenv);
    tcc_add_symbol(s, "unsetenv", &unsetenv);

    // Low-level I/O
    tcc_add_symbol(s, "open", &open);
    tcc_add_symbol(s, "close", &close);
    tcc_add_symbol(s, "read", &read);
    tcc_add_symbol(s, "write", &write);
    tcc_add_symbol(s, "lseek", &lseek);
    tcc_add_symbol(s, "dup", &dup);
    tcc_add_symbol(s, "dup2", &dup2);
    tcc_add_symbol(s, "pipe", &pipe);

    // File system
    tcc_add_symbol(s, "stat", &stat);
    tcc_add_symbol(s, "fstat", &fstat);
    tcc_add_symbol(s, "access", &access);
    tcc_add_symbol(s, "unlink", &unlink);
    tcc_add_symbol(s, "rename", &rename);
    tcc_add_symbol(s, "mkdir", &mkdir);
    tcc_add_symbol(s, "rmdir", &rmdir);
    tcc_add_symbol(s, "chdir", &chdir);
    tcc_add_symbol(s, "getcwd", &getcwd);

    // Memory mapping
    tcc_add_symbol(s, "mmap", &mmap);
    tcc_add_symbol(s, "munmap", &munmap);

    // Time
    tcc_add_symbol(s, "time", &time);

    // Standard streams
    tcc_add_symbol(s, "stdin", stdin);
    tcc_add_symbol(s, "stdout", stdout);
    tcc_add_symbol(s, "stderr", stderr);
}

// ============================================================================
// INITIALIZATION
// ============================================================================

"TCC_OS loaded - TCC OS interface for ZealOS\n";
