// TCC_OS.ZC - TCC OS Interface for ZealOS
// Part of the POSIX compatibility layer
//
// This file provides the OS-specific functions that TCC needs
// to operate on ZealOS.

#include "TCC.HH"

// ============================================================================
// TCC STATE MANAGEMENT
// ============================================================================

CTCCState *tcc_new()
{
    CTCCState *s = MAlloc(sizeof(CTCCState));
    if (!s)
        return NULL;

    MemSet(s, 0, sizeof(CTCCState));

    // Set defaults
    s->output_type = TCC_OUTPUT_MEMORY;
    s->verbose = 0;
    s->do_debug = FALSE;
    s->do_bounds_check = FALSE;
    s->nostdinc = FALSE;
    s->nostdlib = FALSE;
    s->static_link = TRUE;
    s->optimize_level = 0;

    // Allocate path arrays
    s->include_paths = MAlloc(64 * sizeof(U8*));
    s->sysinclude_paths = MAlloc(64 * sizeof(U8*));
    s->library_paths = MAlloc(64 * sizeof(U8*));
    s->defines = MAlloc(256 * sizeof(U8*));
    s->undefines = MAlloc(64 * sizeof(U8*));
    s->files = MAlloc(256 * sizeof(U8*));
    s->file_types = MAlloc(256 * sizeof(I64));
    s->libraries = MAlloc(64 * sizeof(U8*));

    // Add default system include paths
    tcc_add_sysinclude_path(s, "/Home/POSIX/libc");
    tcc_add_sysinclude_path(s, "/Home/POSIX/include");
    tcc_add_sysinclude_path(s, "/Home/POSIX/toolchain/tcc/include");

    // Add default library paths
    tcc_add_library_path(s, "/Home/POSIX/lib");
    tcc_add_library_path(s, "/Home/POSIX/toolchain/tcc/lib");

    // Define ZealOS-specific symbols
    tcc_define_symbol(s, "__ZEALOS__", "1");
    tcc_define_symbol(s, "__x86_64__", "1");
    tcc_define_symbol(s, "__LP64__", "1");
    tcc_define_symbol(s, "__STDC__", "1");
    tcc_define_symbol(s, "__STDC_VERSION__", "199901L");

    return s;
}

U0 tcc_delete(CTCCState *s)
{
    if (!s)
        return;

    // Free include paths
    for (I64 i = 0; i < s->include_count; i++)
        Free(s->include_paths[i]);
    Free(s->include_paths);

    // Free sysinclude paths
    for (I64 i = 0; i < s->sysinclude_count; i++)
        Free(s->sysinclude_paths[i]);
    Free(s->sysinclude_paths);

    // Free library paths
    for (I64 i = 0; i < s->library_count; i++)
        Free(s->library_paths[i]);
    Free(s->library_paths);

    // Free defines
    for (I64 i = 0; i < s->define_count; i++)
        Free(s->defines[i]);
    Free(s->defines);

    // Free undefines
    for (I64 i = 0; i < s->undef_count; i++)
        Free(s->undefines[i]);
    Free(s->undefines);

    // Free files
    for (I64 i = 0; i < s->file_count; i++)
        Free(s->files[i]);
    Free(s->files);
    Free(s->file_types);

    // Free libraries
    for (I64 i = 0; i < s->lib_count; i++)
        Free(s->libraries[i]);
    Free(s->libraries);

    // Free output file
    if (s->outfile)
        Free(s->outfile);

    // Free code memory
    if (s->code_mem)
        Free(s->code_mem);

    Free(s);
}

// ============================================================================
// ERROR HANDLING
// ============================================================================

U0 tcc_set_error_func(CTCCState *s, void *opaque, TCCErrorCallback func)
{
    if (s) {
        s->error_func = func;
        s->error_opaque = opaque;
    }
}

U0 tcc_error(CTCCState *s, U8 *fmt, ...)
{
    U8 buf[1024];
    // Format message (simplified - in real impl would use va_list)
    StrCpy(buf, fmt);

    if (s && s->error_func)
        s->error_func(s->error_opaque, buf);
    else
        fprintf(stderr, "tcc: error: %s\n", buf);

    if (s)
        s->error_count++;
}

U0 tcc_warning(CTCCState *s, U8 *fmt, ...)
{
    U8 buf[1024];
    StrCpy(buf, fmt);

    if (s && s->error_func)
        s->error_func(s->error_opaque, buf);
    else
        fprintf(stderr, "tcc: warning: %s\n", buf);

    if (s)
        s->warning_count++;
}

// ============================================================================
// OUTPUT TYPE
// ============================================================================

I64 tcc_set_output_type(CTCCState *s, I64 output_type)
{
    if (!s)
        return -1;

    s->output_type = output_type;
    return 0;
}

// ============================================================================
// PREPROCESSOR SYMBOLS
// ============================================================================

U0 tcc_define_symbol(CTCCState *s, U8 *sym, U8 *value)
{
    if (!s || !sym)
        return;

    // Create define string: "SYM=VALUE" or just "SYM"
    U8 *def;
    if (value) {
        def = MAlloc(StrLen(sym) + StrLen(value) + 2);
        StrCpy(def, sym);
        StrCat(def, "=");
        StrCat(def, value);
    } else {
        def = StrNew(sym);
    }

    s->defines[s->define_count++] = def;
}

U0 tcc_undefine_symbol(CTCCState *s, U8 *sym)
{
    if (!s || !sym)
        return;

    s->undefines[s->undef_count++] = StrNew(sym);
}

// ============================================================================
// INCLUDE/LIBRARY PATHS
// ============================================================================

I64 tcc_add_include_path(CTCCState *s, U8 *pathname)
{
    if (!s || !pathname)
        return -1;

    s->include_paths[s->include_count++] = StrNew(pathname);
    return 0;
}

I64 tcc_add_sysinclude_path(CTCCState *s, U8 *pathname)
{
    if (!s || !pathname)
        return -1;

    s->sysinclude_paths[s->sysinclude_count++] = StrNew(pathname);
    return 0;
}

I64 tcc_add_library_path(CTCCState *s, U8 *pathname)
{
    if (!s || !pathname)
        return -1;

    s->library_paths[s->library_count++] = StrNew(pathname);
    return 0;
}

I64 tcc_add_library(CTCCState *s, U8 *libraryname)
{
    if (!s || !libraryname)
        return -1;

    s->libraries[s->lib_count++] = StrNew(libraryname);
    return 0;
}

I64 tcc_set_lib_path(CTCCState *s, U8 *path)
{
    return tcc_add_library_path(s, path);
}

// ============================================================================
// SET OPTIONS FROM STRING
// ============================================================================

I64 tcc_set_options(CTCCState *s, U8 *options)
{
    if (!s || !options)
        return -1;

    // Parse space-separated options
    U8 *p = options;
    U8 opt[256];
    I64 i;

    while (*p) {
        // Skip whitespace
        while (*p == ' ' || *p == '\t')
            p++;

        if (!*p)
            break;

        // Extract option
        i = 0;
        while (*p && *p != ' ' && *p != '\t' && i < 255)
            opt[i++] = *p++;
        opt[i] = 0;

        // Process option
        if (opt[0] == '-') {
            if (opt[1] == 'I') {
                tcc_add_include_path(s, opt + 2);
            } else if (opt[1] == 'L') {
                tcc_add_library_path(s, opt + 2);
            } else if (opt[1] == 'D') {
                U8 *eq = StrChr(opt + 2, '=');
                if (eq) {
                    *eq = 0;
                    tcc_define_symbol(s, opt + 2, eq + 1);
                } else {
                    tcc_define_symbol(s, opt + 2, "1");
                }
            } else if (opt[1] == 'U') {
                tcc_undefine_symbol(s, opt + 2);
            } else if (opt[1] == 'l') {
                tcc_add_library(s, opt + 2);
            } else if (opt[1] == 'O') {
                s->optimize_level = opt[2] ? opt[2] - '0' : 1;
            } else if (opt[1] == 'g') {
                s->do_debug = TRUE;
            } else if (opt[1] == 'v') {
                s->verbose++;
            } else if (opt[1] == 'c') {
                s->output_type = TCC_OUTPUT_OBJ;
            } else if (StrCmp(opt, "-nostdinc") == 0) {
                s->nostdinc = TRUE;
            } else if (StrCmp(opt, "-nostdlib") == 0) {
                s->nostdlib = TRUE;
            } else if (StrCmp(opt, "-static") == 0) {
                s->static_link = TRUE;
            } else if (StrCmp(opt, "-shared") == 0) {
                s->output_type = TCC_OUTPUT_DLL;
            }
        }
    }

    return 0;
}

// ============================================================================
// FILE HANDLING
// ============================================================================

I64 tcc_get_file_type(U8 *filename)
{
    U8 *ext = strrchr(filename, '.');
    if (!ext)
        return TCC_FILETYPE_C;

    if (strcmp(ext, ".c") == 0)
        return TCC_FILETYPE_C;
    if (strcmp(ext, ".h") == 0)
        return TCC_FILETYPE_C;
    if (strcmp(ext, ".s") == 0 || strcmp(ext, ".S") == 0)
        return TCC_FILETYPE_ASM;
    if (strcmp(ext, ".o") == 0)
        return TCC_FILETYPE_BINARY;
    if (strcmp(ext, ".a") == 0)
        return TCC_FILETYPE_AR;

    return TCC_FILETYPE_C;
}

I64 tcc_add_file(CTCCState *s, U8 *filename)
{
    if (!s || !filename)
        return -1;

    // Check file exists
    if (PosixAccess(filename, 0) < 0) {
        tcc_error(s, "file not found: %s", filename);
        return -1;
    }

    s->files[s->file_count] = StrNew(filename);
    s->file_types[s->file_count] = tcc_get_file_type(filename);
    s->file_count++;

    return 0;
}

