    {"__cxa_free_exception",(U64)&__cxa_free_exception},
    {"__cxa_pure_virtual",  (U64)&__cxa_pure_virtual},
    {"__gxx_personality_v0",(U64)&__gxx_personality_v0},

    // C++ new/delete
    {"_Znwm",       (U64)&_Znwm},       // operator new
    {"_Znam",       (U64)&_Znam},       // operator new[]
    {"_ZdlPv",      (U64)&_ZdlPv},      // operator delete
    {"_ZdaPv",      (U64)&_ZdaPv},      // operator delete[]

    // Unwind
    {"_Unwind_RaiseException", (U64)&_Unwind_RaiseException},
    {"_Unwind_Resume",         (U64)&_Unwind_Resume},
    {"_Unwind_GetGR",          (U64)&_Unwind_GetGR},
    {"_Unwind_SetGR",          (U64)&_Unwind_SetGR},
    {"_Unwind_GetIP",          (U64)&_Unwind_GetIP},
    {"_Unwind_SetIP",          (U64)&_Unwind_SetIP},

    // Terminator
    {NULL, 0}
};

U64 DynLookupZealOS(U8 *name)
{
    for (I64 i = 0; g_zealos_symbols[i].name; i++) {
        if (StrCmp(g_zealos_symbols[i].name, name) == 0)
            return g_zealos_symbols[i].addr;
    }
    return 0;
}

// ============================================================================
// RELOCATIONS
// ============================================================================

I64 DynApplyRelocations(CDynLinker *dl, CDynLib *lib)
{
    U8 *base = lib->base_addr - lib->min_vaddr;

    // Apply RELA relocations
    if (lib->dyn.rela && lib->dyn.relasz) {
        I64 count = lib->dyn.relasz / sizeof(Elf64_Rela);
        Elf64_Rela *rela = (Elf64_Rela*)lib->dyn.rela;

        for (I64 i = 0; i < count; i++) {
            if (DynApplyRela(dl, lib, &rela[i]) < 0)
                return -1;
        }
    }

    // Apply REL relocations
    if (lib->dyn.rel && lib->dyn.relsz) {
        I64 count = lib->dyn.relsz / sizeof(Elf64_Rel);
        Elf64_Rel *rel = (Elf64_Rel*)lib->dyn.rel;

        for (I64 i = 0; i < count; i++) {
            Elf64_Rela rela;
            rela.r_offset = rel[i].r_offset;
            rela.r_info = rel[i].r_info;
            rela.r_addend = 0;

            if (DynApplyRela(dl, lib, &rela) < 0)
                return -1;
        }
    }

    // Apply PLT relocations
    if (lib->dyn.jmprel && lib->dyn.pltrelsz) {
        I64 ent_size = (lib->dyn.pltrel == DT_RELA) ?
                       sizeof(Elf64_Rela) : sizeof(Elf64_Rel);
        I64 count = lib->dyn.pltrelsz / ent_size;

        for (I64 i = 0; i < count; i++) {
            Elf64_Rela rela;

            if (lib->dyn.pltrel == DT_RELA) {
                Elf64_Rela *r = ((Elf64_Rela*)lib->dyn.jmprel) + i;
                rela = *r;
            } else {
                Elf64_Rel *r = ((Elf64_Rel*)lib->dyn.jmprel) + i;
                rela.r_offset = r->r_offset;
                rela.r_info = r->r_info;
                rela.r_addend = 0;
            }

            if (DynApplyRela(dl, lib, &rela) < 0)
                return -1;
        }
    }

    lib->relocated = TRUE;
    return 0;
}

I64 DynApplyRela(CDynLinker *dl, CDynLib *lib, Elf64_Rela *rela)
{
    U8 *base = lib->base_addr - lib->min_vaddr;
    U32 sym_idx = ELF64_R_SYM(rela->r_info);
    U32 rel_type = ELF64_R_TYPE(rela->r_info);

    U64 *target = (U64*)(base + rela->r_offset);
    U64 sym_val = 0;
    U8 *sym_name = NULL;

    // Get symbol if needed
    if (sym_idx != 0) {
        Elf64_Sym *sym = (Elf64_Sym*)(lib->dyn.symtab +
                                       sym_idx * lib->dyn.syment);

        if (lib->dyn.strtab)
            sym_name = lib->dyn.strtab + sym->st_name;

        if (sym->st_shndx == SHN_UNDEF) {
            // Undefined - look up globally
            sym_val = DynLookupSymbol(dl, sym_name, lib);

            if (sym_val == 0) {
                // Check if weak symbol
                if (ELF64_ST_BIND(sym->st_info) == STB_WEAK) {
                    sym_val = 0;  // OK to be zero for weak
                } else {
                    DynLinkSetError(dl, "Undefined symbol: %s", sym_name);
                    if (dl->verbose)
                        fprintf(stderr, "DynLink: Undefined symbol: %s (in %s)\n",
                                sym_name, lib->path);
                    return -1;
                }
            }
        } else {
            // Defined locally
            sym_val = base(U64) + sym->st_value;
        }
    }

    // Apply relocation
    switch (rel_type) {
        case R_X86_64_NONE:
            break;

        case R_X86_64_64:
            *target = sym_val + rela->r_addend;
            break;

        case R_X86_64_PC32:
            *(U32*)target = (sym_val + rela->r_addend - (U64)target)(U32);
            break;

        case R_X86_64_GLOB_DAT:
        case R_X86_64_JUMP_SLOT:
            *target = sym_val;
            break;

        case R_X86_64_RELATIVE:
            *target = base(U64) + rela->r_addend;
            break;

        case R_X86_64_32:
            *(U32*)target = (sym_val + rela->r_addend)(U32);
            break;

        case R_X86_64_32S:
            *(I32*)target = (sym_val + rela->r_addend)(I32);
            break;

        case R_X86_64_COPY:
            // Copy from shared object to executable
            if (sym_val) {
                Elf64_Sym *sym = (Elf64_Sym*)(lib->dyn.symtab +
                                               sym_idx * lib->dyn.syment);
                MemCpy(target, sym_val(void*), sym->st_size);
            }
            break;

        case R_X86_64_GOTPCREL:
            // GOT-relative, PC-relative
            *(U32*)target = (sym_val + rela->r_addend - (U64)target)(U32);
            break;

        default:
            if (dl->verbose)
                fprintf(stderr, "DynLink: Unknown relocation type %d for %s\n",
                        rel_type, sym_name ? sym_name : "<unknown>");
            break;
    }

    return 0;
}

// ============================================================================
// INITIALIZATION
// ============================================================================

I64 DynCallInit(CDynLinker *dl, CDynLib *lib)
{
    if (lib->initialized)
        return 0;

    U8 *base = lib->base_addr - lib->min_vaddr;

    // Call DT_INIT_ARRAY functions
    if (lib->dyn.init_array && lib->dyn.init_arraysz) {
        I64 count = lib->dyn.init_arraysz / sizeof(U64);
        U64 *init_funcs = (U64*)(base + lib->dyn.init_array);

        for (I64 i = 0; i < count; i++) {
            if (init_funcs[i]) {
                U0 (*init)() = (U0(*)())init_funcs[i];
                if (dl->verbose)
                    printf("DynLink: Calling init_array[%d] at 0x%X\n",
                           i, init_funcs[i]);
                init();
            }
        }
    }

    // Call DT_INIT function
    if (lib->dyn.init) {
        U0 (*init)() = (U0(*)())(base + lib->dyn.init);
        if (dl->verbose)
            printf("DynLink: Calling _init at 0x%X\n", lib->dyn.init);
        init();
    }

    lib->initialized = TRUE;
    return 0;
}

U0 DynCallFini(CDynLinker *dl, CDynLib *lib)
{
    if (!lib->initialized)
        return;

    U8 *base = lib->base_addr - lib->min_vaddr;

    // Call DT_FINI function
    if (lib->dyn.fini) {
        U0 (*fini)() = (U0(*)())(base + lib->dyn.fini);
        fini();
    }

    // Call DT_FINI_ARRAY functions (reverse order)
    if (lib->dyn.fini_array && lib->dyn.fini_arraysz) {
        I64 count = lib->dyn.fini_arraysz / sizeof(U64);
        U64 *fini_funcs = (U64*)(base + lib->dyn.fini_array);

        for (I64 i = count - 1; i >= 0; i--) {
            if (fini_funcs[i]) {
                U0 (*fini)() = (U0(*)())fini_funcs[i];
                fini();
            }
        }
    }

    lib->initialized = FALSE;
}

// ============================================================================
// DLOPEN / DLSYM / DLCLOSE
// ============================================================================

void *dlopen(U8 *filename, I64 flags)
{
    CDynLinker *dl = DynLinkInit();

    // NULL filename returns main program handle
    if (!filename)
        return dl->main_exe ? dl->main_exe : RTLD_DEFAULT;

    // Check if already loaded
    for (I64 i = 0; i < dl->lib_count; i++) {
        if (dl->libs[i]) {
            if (StrCmp(dl->libs[i]->path, filename) == 0 ||
                (dl->libs[i]->soname && StrCmp(dl->libs[i]->soname, filename) == 0)) {
                dl->libs[i]->ref_count++;
                return dl->libs[i];
            }
        }
    }

    // Find the library file
    U8 *path = DynFindLibrary(dl, filename);
    if (!path) {
        DynLinkSetError(dl, "Cannot find library: %s", filename);
        return NULL;
    }

    // Load the library
    CDynLib *lib = DynLoadFile(dl, path);
    Free(path);

    if (!lib)
        return NULL;

    lib->flags = flags;
    lib->ref_count = 1;

    // Map into memory
    if (DynMapLibrary(dl, lib) < 0) {
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    // Parse dynamic section
    if (DynParseDynamic(dl, lib) < 0) {
        Free(lib->base_addr);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    // Add to library list
    if (dl->lib_count < DL_MAX_LIBS) {
        dl->libs[dl->lib_count++] = lib;
    }

    // Add to load order list
    if (dl->load_tail) {
        dl->load_tail->next = lib;
        lib->prev = dl->load_tail;
        dl->load_tail = lib;
    } else {
        dl->load_head = dl->load_tail = lib;
    }

    // Load dependencies
    for (I64 i = 0; i < lib->needed_count; i++) {
        void *dep = dlopen(lib->needed[i], flags);
        if (!dep && !(flags & RTLD_LAZY)) {
            // Failed to load dependency
            // TODO: proper cleanup
            return NULL;
        }
    }

    // Apply relocations
    if (DynApplyRelocations(dl, lib) < 0) {
        if (!(flags & RTLD_LAZY)) {
            // TODO: proper cleanup
            return NULL;
        }
    }

    // Call constructors (unless RTLD_NOLOAD)
    if (!(flags & RTLD_NOLOAD)) {
        DynCallInit(dl, lib);
    }

    if (dl->verbose)
        printf("DynLink: Loaded %s at 0x%016X\n", lib->path, lib->base_addr);

    return lib;
}

void *dlsym(void *handle, U8 *symbol)
{
    CDynLinker *dl = DynLinkInit();

    if (!symbol) {
        DynLinkSetError(dl, "NULL symbol name");
        return NULL;
    }

    // Handle RTLD_DEFAULT - search all libraries
    if (handle == RTLD_DEFAULT || handle == NULL) {
        U64 addr = DynLookupSymbol(dl, symbol, NULL);
        if (addr)
            return (void*)addr;

        DynLinkSetError(dl, "Symbol not found: %s", symbol);
        return NULL;
    }

    // Handle RTLD_NEXT - search after current library
    if (handle == RTLD_NEXT) {
        // Get return address to determine "current" library
        // Simplified: just search from beginning
        U64 addr = DynLookupSymbol(dl, symbol, NULL);
        if (addr)
            return (void*)addr;

        DynLinkSetError(dl, "Symbol not found: %s", symbol);
        return NULL;
    }

    // Handle specific library
    CDynLib *lib = (CDynLib*)handle;

    Elf64_Sym *sym = DynLookupSymInLib(lib, symbol);
    if (sym) {
        U64 addr = (lib->base_addr - lib->min_vaddr) + sym->st_value;
        return (void*)addr;
    }

    // Also check dependencies if RTLD_GLOBAL
    if (lib->flags & RTLD_GLOBAL) {
        for (I64 i = 0; i < lib->needed_count; i++) {
            // Find loaded dependency
            for (I64 j = 0; j < dl->lib_count; j++) {
                if (dl->libs[j] && dl->libs[j]->soname &&
                    StrCmp(dl->libs[j]->soname, lib->needed[i]) == 0) {
                    void *result = dlsym(dl->libs[j], symbol);
                    if (result)
                        return result;
                }
            }
        }
    }

    DynLinkSetError(dl, "Symbol not found: %s", symbol);
    return NULL;
}

I64 dlclose(void *handle)
{
    CDynLinker *dl = DynLinkInit();

    if (!handle || handle == RTLD_DEFAULT || handle == RTLD_NEXT)
        return 0;

    CDynLib *lib = (CDynLib*)handle;

    // Decrement reference count
    lib->ref_count--;

    if (lib->ref_count > 0)
        return 0;

    // Don't actually unload if RTLD_NODELETE
    if (lib->flags & RTLD_NODELETE)
        return 0;

    // Call destructors
    DynCallFini(dl, lib);

    // Remove from load order list
    if (lib->prev)
        lib->prev->next = lib->next;
    else
        dl->load_head = lib->next;

    if (lib->next)
        lib->next->prev = lib->prev;
    else
        dl->load_tail = lib->prev;

    // Remove from library array
    for (I64 i = 0; i < dl->lib_count; i++) {
        if (dl->libs[i] == lib) {
            dl->libs[i] = NULL;
            break;
        }
    }

    // Free memory
    if (lib->base_addr)
        Free(lib->base_addr);
    if (lib->file_data)
        Free(lib->file_data);
    if (lib->path)
        Free(lib->path);
    if (lib->soname)
        Free(lib->soname);

    for (I64 i = 0; i < lib->needed_count; i++) {
        if (lib->needed[i])
            Free(lib->needed[i]);
    }

    Free(lib);

    return 0;
}

// dladdr - get information about a symbol address
I64 dladdr(void *addr, Dl_info *info)
{
    CDynLinker *dl = DynLinkInit();

    if (!info)
        return 0;

    MemSet(info, 0, sizeof(Dl_info));

    // Find which library contains this address
    for (I64 i = 0; i < dl->lib_count; i++) {
        CDynLib *lib = dl->libs[i];
        if (!lib)
            continue;

        if ((U8*)addr >= lib->base_addr &&
            (U8*)addr < lib->base_addr + lib->load_size) {

            info->dli_fname = lib->path;
            info->dli_fbase = lib->base_addr;

            // Find nearest symbol
            // TODO: implement proper symbol search
            info->dli_sname = NULL;
            info->dli_saddr = NULL;

            return 1;
        }
    }

    return 0;
}

// ============================================================================
// DYNAMIC LOADER ENTRY POINT
// ============================================================================

// Load and run a dynamically-linked ELF executable
I64 DynRun(U8 *filename, I64 argc, U8 **argv)
{
    CDynLinker *dl = DynLinkInit();
    dl->verbose = TRUE;  // Debug output

    printf("DynLink: Loading %s\n", filename);

    // Load main executable
    CDynLib *exe = DynLoadFile(dl, filename);
    if (!exe) {
        fprintf(stderr, "DynLink: Failed to load %s: %s\n", filename, dl->error);
        return -1;
    }

    exe->flags = RTLD_GLOBAL | RTLD_NOW;
    exe->ref_count = 1;

    // Map into memory
    if (DynMapLibrary(dl, exe) < 0) {
        fprintf(stderr, "DynLink: Failed to map %s: %s\n", filename, dl->error);
        return -1;
    }

    // Parse dynamic section
    if (DynParseDynamic(dl, exe) < 0) {
        fprintf(stderr, "DynLink: Failed to parse %s: %s\n", filename, dl->error);
        return -1;
    }

    // Set as main executable
    dl->main_exe = exe;
    dl->libs[dl->lib_count++] = exe;
    dl->load_head = dl->load_tail = exe;

    // Load all dependencies
    printf("DynLink: Loading dependencies...\n");
    for (I64 i = 0; i < exe->needed_count; i++) {
        printf("  Loading %s\n", exe->needed[i]);
        void *dep = dlopen(exe->needed[i], RTLD_GLOBAL | RTLD_NOW);
        if (!dep) {
            fprintf(stderr, "DynLink: Failed to load %s: %s\n",
                    exe->needed[i], dl->error);
            return -1;
        }
    }

    // Apply relocations to main executable
    printf("DynLink: Applying relocations...\n");
    if (DynApplyRelocations(dl, exe) < 0) {
        fprintf(stderr, "DynLink: Relocation failed: %s\n", dl->error);
        return -1;
    }

    // Call library initializers
    printf("DynLink: Calling initializers...\n");
    for (CDynLib *lib = dl->load_head; lib; lib = lib->next) {
        if (lib != exe) {
            DynCallInit(dl, lib);
        }
    }

    // Call main executable initializers
    DynCallInit(dl, exe);

    // Get entry point
    U64 entry = exe->ehdr->e_entry;
    if (exe->ehdr->e_type == ET_DYN) {
        // PIE - adjust entry point
        entry = (exe->base_addr - exe->min_vaddr) + entry;
    } else {
        entry = (exe->base_addr - exe->min_vaddr) + entry;
    }

    printf("DynLink: Jumping to entry point 0x%016X\n", entry);

    // Get environment
    CPosixProcess *proc = PosixGetCurrent();
    U8 **envp = proc ? proc->environ : NULL;

    // Call entry point
    I64 (*entry_func)(I64, U8**, U8**) = entry(void*);
    I64 result = entry_func(argc, argv, envp);

    // Call finalizers
    for (CDynLib *lib = dl->load_tail; lib; lib = lib->prev) {
        DynCallFini(dl, lib);
    }

    printf("DynLink: Process exited with code %d\n", result);
    return result;
}

// ============================================================================
// ADD LIBRARY SEARCH PATH
// ============================================================================

U0 DynAddSearchPath(U8 *path)
{
    CDynLinker *dl = DynLinkInit();

    if (dl->path_count < DL_MAX_SEARCH_PATHS) {
        dl->search_paths[dl->path_count++] = StrNew(path);
    }
}

// ============================================================================
// REGISTER GLOBAL SYMBOL
// ============================================================================

U0 DynRegisterSymbol(U8 *name, U64 addr)
{
    CDynLinker *dl = DynLinkInit();

    CDynSymbol *sym = MAlloc(sizeof(CDynSymbol));
    sym->name = StrNew(name);
    sym->addr = addr;
    sym->lib = NULL;

    U32 hash = DynSymHash(name);
    sym->next = dl->symtab[hash];
    dl->symtab[hash] = sym;
}

// ============================================================================
// INITIALIZATION MESSAGE
// ============================================================================

"ZealOS Dynamic Linker loaded.\n";
"  - dlopen, dlsym, dlclose, dladdr\n";
"  - Shared library loading\n";
"  - Symbol resolution\n";
"  - PLT/GOT relocations\n";
"  - Init/fini functions\n";
