// DynLink.ZC - ELF Dynamic Linker for ZealOS
// Part of the POSIX compatibility layer
//
// Implements runtime dynamic linking (ld-linux.so equivalent)
// Supports loading shared libraries and symbol resolution.

#include "ELF.HH"
#include "DynLink.HH"

// ============================================================================
// GLOBAL STATE
// ============================================================================

static CDynLinker *g_dynlink = NULL;

// ============================================================================
// INITIALIZATION
// ============================================================================

CDynLinker *DynLinkInit()
{
    if (g_dynlink)
        return g_dynlink;

    g_dynlink = MAlloc(sizeof(CDynLinker));
    MemSet(g_dynlink, 0, sizeof(CDynLinker));

    // Set up default search paths
    g_dynlink->search_paths[0] = StrNew("/Home/POSIX/lib");
    g_dynlink->search_paths[1] = StrNew("/Home/POSIX/usr/lib");
    g_dynlink->search_paths[2] = StrNew("/Home/POSIX/lib64");
    g_dynlink->search_paths[3] = StrNew("/Home/POSIX/usr/lib64");
    g_dynlink->path_count = 4;

    return g_dynlink;
}

// ============================================================================
// ERROR HANDLING
// ============================================================================

U0 DynLinkSetError(CDynLinker *dl, U8 *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(dl->error, sizeof(dl->error), fmt, ap);
    va_end(ap);
    dl->has_error = TRUE;
}

U8 *dlerror()
{
    if (!g_dynlink || !g_dynlink->has_error)
        return NULL;

    g_dynlink->has_error = FALSE;
    return g_dynlink->error;
}

// ============================================================================
// SYMBOL HASH FUNCTIONS
// ============================================================================

// ELF hash function (SYSV style)
U32 ELFHash(U8 *name)
{
    U32 h = 0, g;

    while (*name) {
        h = (h << 4) + *name++;
        g = h & 0xF0000000;
        if (g)
            h ^= g >> 24;
        h &= ~g;
    }

    return h;
}

// GNU hash function (faster)
U32 GNUHash(U8 *name)
{
    U32 h = 5381;

    while (*name)
        h = (h << 5) + h + *name++;

    return h;
}

// Simple hash for our symbol table
U32 DynSymHash(U8 *name)
{
    return GNUHash(name) % DL_HASH_SIZE;
}

// ============================================================================
// LIBRARY SEARCH
// ============================================================================

U8 *DynFindLibrary(CDynLinker *dl, U8 *name)
{
    static U8 path_buf[DL_MAX_PATH];

    // If absolute path, use directly
    if (name[0] == '/') {
        if (FileFind(name))
            return StrNew(name);
        return NULL;
    }

    // Check LD_LIBRARY_PATH environment variable
    CPosixProcess *proc = PosixGetCurrent();
    if (proc) {
        U8 *ld_path = getenv("LD_LIBRARY_PATH");
        if (ld_path) {
            U8 *path_copy = StrNew(ld_path);
            U8 *token = strtok(path_copy, ":");
            while (token) {
                snprintf(path_buf, DL_MAX_PATH, "%s/%s", token, name);
                if (FileFind(path_buf)) {
                    Free(path_copy);
                    return StrNew(path_buf);
                }
                token = strtok(NULL, ":");
            }
            Free(path_copy);
        }
    }

    // Search in configured paths
    for (I64 i = 0; i < dl->path_count; i++) {
        snprintf(path_buf, DL_MAX_PATH, "%s/%s", dl->search_paths[i], name);
        if (FileFind(path_buf))
            return StrNew(path_buf);
    }

    // Not found
    return NULL;
}

// ============================================================================
// LIBRARY LOADING
// ============================================================================

CDynLib *DynLoadFile(CDynLinker *dl, U8 *path)
{
    CDynLib *lib = MAlloc(sizeof(CDynLib));
    if (!lib) {
        DynLinkSetError(dl, "Out of memory");
        return NULL;
    }

    MemSet(lib, 0, sizeof(CDynLib));
    lib->path = StrNew(path);

    // Read file
    FILE *fp = fopen(path, "rb");
    if (!fp) {
        DynLinkSetError(dl, "Cannot open %s", path);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    fseek(fp, 0, SEEK_END);
    lib->file_size = ftell(fp);
    fseek(fp, 0, SEEK_SET);

    lib->file_data = MAlloc(lib->file_size);
    if (!lib->file_data) {
        DynLinkSetError(dl, "Out of memory reading %s", path);
        fclose(fp);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    if (fread(lib->file_data, 1, lib->file_size, fp) != lib->file_size) {
        DynLinkSetError(dl, "Read error: %s", path);
        fclose(fp);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }
    fclose(fp);

    // Validate ELF header
    lib->ehdr = (Elf64_Ehdr*)lib->file_data;

    if (lib->ehdr->e_ident[EI_MAG0] != ELFMAG0 ||
        lib->ehdr->e_ident[EI_MAG1] != ELFMAG1 ||
        lib->ehdr->e_ident[EI_MAG2] != ELFMAG2 ||
        lib->ehdr->e_ident[EI_MAG3] != ELFMAG3) {
        DynLinkSetError(dl, "Not an ELF file: %s", path);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    if (lib->ehdr->e_ident[EI_CLASS] != ELFCLASS64) {
        DynLinkSetError(dl, "Not 64-bit ELF: %s", path);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    if (lib->ehdr->e_machine != EM_X86_64) {
        DynLinkSetError(dl, "Not x86-64: %s", path);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    if (lib->ehdr->e_type != ET_DYN && lib->ehdr->e_type != ET_EXEC) {
        DynLinkSetError(dl, "Not executable or shared object: %s", path);
        Free(lib->file_data);
        Free(lib->path);
        Free(lib);
        return NULL;
    }

    lib->phdrs = (Elf64_Phdr*)(lib->file_data + lib->ehdr->e_phoff);

    return lib;
}

// ============================================================================
// MEMORY MAPPING
// ============================================================================

I64 DynMapLibrary(CDynLinker *dl, CDynLib *lib)
{
    // Calculate memory range needed
    lib->min_vaddr = 0xFFFFFFFFFFFFFFFF;
    lib->max_vaddr = 0;

    for (I64 i = 0; i < lib->ehdr->e_phnum; i++) {
        Elf64_Phdr *phdr = &lib->phdrs[i];

        if (phdr->p_type == PT_LOAD) {
            U64 seg_start = phdr->p_vaddr;
            U64 seg_end = phdr->p_vaddr + phdr->p_memsz;

            if (seg_start < lib->min_vaddr)
                lib->min_vaddr = seg_start;
            if (seg_end > lib->max_vaddr)
                lib->max_vaddr = seg_end;
        }
    }

    if (lib->max_vaddr <= lib->min_vaddr) {
        DynLinkSetError(dl, "No loadable segments in %s", lib->path);
        return -1;
    }

    // Allocate memory
    lib->load_size = lib->max_vaddr - lib->min_vaddr;
    lib->base_addr = MAlloc(lib->load_size);

    if (!lib->base_addr) {
        DynLinkSetError(dl, "Out of memory mapping %s", lib->path);
        return -1;
    }

    MemSet(lib->base_addr, 0, lib->load_size);

    // Load segments
    for (I64 i = 0; i < lib->ehdr->e_phnum; i++) {
        Elf64_Phdr *phdr = &lib->phdrs[i];

        if (phdr->p_type == PT_LOAD) {
            U8 *dest = lib->base_addr + (phdr->p_vaddr - lib->min_vaddr);

            if (phdr->p_filesz > 0) {
                MemCpy(dest, lib->file_data + phdr->p_offset, phdr->p_filesz);
            }
        }
        else if (phdr->p_type == PT_DYNAMIC) {
            // Find dynamic section
            lib->dynamic = (Elf64_Dyn*)(lib->base_addr +
                                        (phdr->p_vaddr - lib->min_vaddr));
            lib->dyn_count = phdr->p_memsz / sizeof(Elf64_Dyn);
        }
    }

    if (dl->verbose)
        printf("DynLink: Mapped %s at 0x%016X (%d bytes)\n",
               lib->path, lib->base_addr, lib->load_size);

    return 0;
}

// ============================================================================
// PARSE DYNAMIC SECTION
// ============================================================================

I64 DynParseDynamic(CDynLinker *dl, CDynLib *lib)
{
    if (!lib->dynamic) {
        // No dynamic section - might be a static executable
        return 0;
    }

    U8 *base = lib->base_addr - lib->min_vaddr;

    for (Elf64_Dyn *dyn = lib->dynamic; dyn->d_tag != DT_NULL; dyn++) {
        switch (dyn->d_tag) {
            case DT_NEEDED:
                // Record needed library name (will resolve later)
                if (lib->needed_count < DL_MAX_LIBS)
                    lib->needed[lib->needed_count++] = (U8*)(dyn->d_un.d_val);
                break;

            case DT_STRTAB:
                lib->dyn.strtab = base + dyn->d_un.d_ptr;
                break;

            case DT_STRSZ:
                lib->dyn.strsz = dyn->d_un.d_val;
                break;

            case DT_SYMTAB:
                lib->dyn.symtab = base + dyn->d_un.d_ptr;
                break;

            case DT_SYMENT:
                lib->dyn.syment = dyn->d_un.d_val;
                break;

            case DT_HASH:
                lib->dyn.hash = base + dyn->d_un.d_ptr;
                break;

            case DT_GNU_HASH:
                lib->dyn.gnu_hash = base + dyn->d_un.d_ptr;
                break;

            case DT_RELA:
                lib->dyn.rela = base + dyn->d_un.d_ptr;
                break;

            case DT_RELASZ:
                lib->dyn.relasz = dyn->d_un.d_val;
                break;

            case DT_RELAENT:
                lib->dyn.relaent = dyn->d_un.d_val;
                break;

            case DT_REL:
                lib->dyn.rel = base + dyn->d_un.d_ptr;
                break;

            case DT_RELSZ:
                lib->dyn.relsz = dyn->d_un.d_val;
                break;

            case DT_RELENT:
                lib->dyn.relent = dyn->d_un.d_val;
                break;

            case DT_JMPREL:
                lib->dyn.jmprel = base + dyn->d_un.d_ptr;
                break;

            case DT_PLTRELSZ:
                lib->dyn.pltrelsz = dyn->d_un.d_val;
                break;

            case DT_PLTREL:
                lib->dyn.pltrel = dyn->d_un.d_val;
                break;

            case DT_PLTGOT:
                lib->dyn.pltgot = base + dyn->d_un.d_ptr;
                break;

            case DT_INIT:
                lib->dyn.init = dyn->d_un.d_ptr;
                break;

            case DT_FINI:
                lib->dyn.fini = dyn->d_un.d_ptr;
                break;

            case DT_INIT_ARRAY:
                lib->dyn.init_array = dyn->d_un.d_ptr;
                break;

            case DT_INIT_ARRAYSZ:
                lib->dyn.init_arraysz = dyn->d_un.d_val;
                break;

            case DT_FINI_ARRAY:
                lib->dyn.fini_array = dyn->d_un.d_ptr;
                break;

            case DT_FINI_ARRAYSZ:
                lib->dyn.fini_arraysz = dyn->d_un.d_val;
                break;

            case DT_SONAME:
                // Will resolve after strtab is known
                break;
        }
    }

    // Second pass: resolve NEEDED and SONAME strings
    for (Elf64_Dyn *dyn = lib->dynamic; dyn->d_tag != DT_NULL; dyn++) {
        if (dyn->d_tag == DT_SONAME && lib->dyn.strtab) {
            lib->soname = StrNew(lib->dyn.strtab + dyn->d_un.d_val);
        }
    }

    // Resolve NEEDED library names
    for (I64 i = 0; i < lib->needed_count; i++) {
        if (lib->dyn.strtab) {
            U64 offset = (U64)lib->needed[i];
            lib->needed[i] = StrNew(lib->dyn.strtab + offset);
        }
    }

    if (dl->verbose) {
        printf("DynLink: Parsed dynamic section for %s\n", lib->path);
        if (lib->soname)
            printf("  SONAME: %s\n", lib->soname);
        printf("  Dependencies: %d\n", lib->needed_count);
        for (I64 i = 0; i < lib->needed_count; i++)
            printf("    - %s\n", lib->needed[i]);
    }

    return 0;
}

// ============================================================================
// SYMBOL LOOKUP
// ============================================================================

// Lookup symbol in a specific library using SYSV hash
Elf64_Sym *DynLookupSymSYSV(CDynLib *lib, U8 *name, U32 hash)
{
    if (!lib->dyn.hash || !lib->dyn.symtab || !lib->dyn.strtab)
        return NULL;

    U32 *hashtab = (U32*)lib->dyn.hash;
    U32 nbucket = hashtab[0];
    U32 nchain = hashtab[1];
    U32 *bucket = &hashtab[2];
    U32 *chain = &bucket[nbucket];

    U32 idx = bucket[hash % nbucket];

    while (idx != 0) {
        Elf64_Sym *sym = (Elf64_Sym*)(lib->dyn.symtab + idx * lib->dyn.syment);
        U8 *sym_name = lib->dyn.strtab + sym->st_name;

        if (StrCmp(sym_name, name) == 0) {
            // Found - check if defined
            if (sym->st_shndx != SHN_UNDEF)
                return sym;
        }

        if (idx >= nchain)
            break;
        idx = chain[idx];
    }

    return NULL;
}

// Lookup symbol in a specific library using GNU hash
Elf64_Sym *DynLookupSymGNU(CDynLib *lib, U8 *name, U32 hash)
{
    if (!lib->dyn.gnu_hash || !lib->dyn.symtab || !lib->dyn.strtab)
        return NULL;

    U32 *hashtab = (U32*)lib->dyn.gnu_hash;
    U32 nbuckets = hashtab[0];
    U32 symoffset = hashtab[1];
    U32 bloom_size = hashtab[2];
    U32 bloom_shift = hashtab[3];

    U64 *bloom = (U64*)&hashtab[4];
    U32 *buckets = (U32*)&bloom[bloom_size];
    U32 *chains = &buckets[nbuckets];

    // Bloom filter check
    U64 bloom_word = bloom[(hash / 64) % bloom_size];
    U64 mask = (1ULL << (hash % 64)) | (1ULL << ((hash >> bloom_shift) % 64));
    if ((bloom_word & mask) != mask)
        return NULL;

    // Bucket lookup
    U32 idx = buckets[hash % nbuckets];
    if (idx < symoffset)
        return NULL;

    // Chain walk
    while (TRUE) {
        Elf64_Sym *sym = (Elf64_Sym*)(lib->dyn.symtab +
                                       idx * lib->dyn.syment);
        U8 *sym_name = lib->dyn.strtab + sym->st_name;
        U32 chain_hash = chains[idx - symoffset];

        // Check hash and name
        if ((hash | 1) == (chain_hash | 1) && StrCmp(sym_name, name) == 0) {
            if (sym->st_shndx != SHN_UNDEF)
                return sym;
        }

        // End of chain?
        if (chain_hash & 1)
            break;

        idx++;
    }

    return NULL;
}

// Lookup symbol in a specific library
Elf64_Sym *DynLookupSymInLib(CDynLib *lib, U8 *name)
{
    U32 sysv_hash = ELFHash(name);
    U32 gnu_hash = GNUHash(name);

    // Try GNU hash first (faster)
    if (lib->dyn.gnu_hash) {
        Elf64_Sym *sym = DynLookupSymGNU(lib, name, gnu_hash);
        if (sym)
            return sym;
    }

    // Fall back to SYSV hash
    if (lib->dyn.hash) {
        return DynLookupSymSYSV(lib, name, sysv_hash);
    }

    // Linear search as last resort
    if (lib->dyn.symtab && lib->dyn.strtab) {
        // Need to know symbol count - use hash table nchain
        if (lib->dyn.hash) {
            U32 *hashtab = (U32*)lib->dyn.hash;
            U32 nchain = hashtab[1];

            for (U32 i = 0; i < nchain; i++) {
                Elf64_Sym *sym = (Elf64_Sym*)(lib->dyn.symtab +
                                              i * lib->dyn.syment);
                if (sym->st_name == 0)
                    continue;

                U8 *sym_name = lib->dyn.strtab + sym->st_name;
                if (StrCmp(sym_name, name) == 0 && sym->st_shndx != SHN_UNDEF)
                    return sym;
            }
        }
    }

    return NULL;
}

// Lookup symbol globally
U64 DynLookupSymbol(CDynLinker *dl, U8 *name, CDynLib *exclude)
{
    // First check our global symbol table
    U32 hash = DynSymHash(name);
    CDynSymbol *gsym = dl->symtab[hash];
    while (gsym) {
        if (StrCmp(gsym->name, name) == 0)
            return gsym->addr;
        gsym = gsym->next;
    }

    // Search loaded libraries in order
    for (CDynLib *lib = dl->load_head; lib; lib = lib->next) {
        if (lib == exclude)
            continue;

        Elf64_Sym *sym = DynLookupSymInLib(lib, name);
        if (sym) {
            return (lib->base_addr - lib->min_vaddr) + sym->st_value;
        }
    }

    // Check if symbol is provided by ZealOS POSIX layer
    U64 zealos_sym = DynLookupZealOS(name);
    if (zealos_sym)
        return zealos_sym;

    return 0;
}

