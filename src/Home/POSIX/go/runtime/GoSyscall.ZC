// GoSyscall.ZC - Go Syscall Interface for ZealOS
// Part of the POSIX compatibility layer
//
// This provides the syscall interface that Go programs use to interact
// with the operating system. We map Go's syscalls to our POSIX layer.

#include "../Go.HH"

// ============================================================================
// SYSCALL NUMBERS (Linux x86-64 ABI)
// ============================================================================

#define SYS_READ            0
#define SYS_WRITE           1
#define SYS_OPEN            2
#define SYS_CLOSE           3
#define SYS_STAT            4
#define SYS_FSTAT           5
#define SYS_LSTAT           6
#define SYS_POLL            7
#define SYS_LSEEK           8
#define SYS_MMAP            9
#define SYS_MPROTECT        10
#define SYS_MUNMAP          11
#define SYS_BRK             12
#define SYS_RT_SIGACTION    13
#define SYS_RT_SIGPROCMASK  14
#define SYS_IOCTL           16
#define SYS_PREAD64         17
#define SYS_PWRITE64        18
#define SYS_READV           19
#define SYS_WRITEV          20
#define SYS_ACCESS          21
#define SYS_PIPE            22
#define SYS_SELECT          23
#define SYS_SCHED_YIELD     24
#define SYS_MREMAP          25
#define SYS_MSYNC           26
#define SYS_MADVISE         28
#define SYS_DUP             32
#define SYS_DUP2            33
#define SYS_PAUSE           34
#define SYS_NANOSLEEP       35
#define SYS_GETITIMER       36
#define SYS_ALARM           37
#define SYS_SETITIMER       38
#define SYS_GETPID          39
#define SYS_SOCKET          41
#define SYS_CONNECT         42
#define SYS_ACCEPT          43
#define SYS_SENDTO          44
#define SYS_RECVFROM        45
#define SYS_SENDMSG         46
#define SYS_RECVMSG         47
#define SYS_SHUTDOWN        48
#define SYS_BIND            49
#define SYS_LISTEN          50
#define SYS_GETSOCKNAME     51
#define SYS_GETPEERNAME     52
#define SYS_SOCKETPAIR      53
#define SYS_SETSOCKOPT      54
#define SYS_GETSOCKOPT      55
#define SYS_CLONE           56
#define SYS_FORK            57
#define SYS_VFORK           58
#define SYS_EXECVE          59
#define SYS_EXIT            60
#define SYS_WAIT4           61
#define SYS_KILL            62
#define SYS_UNAME           63
#define SYS_FCNTL           72
#define SYS_FLOCK           73
#define SYS_FSYNC           74
#define SYS_FDATASYNC       75
#define SYS_TRUNCATE        76
#define SYS_FTRUNCATE       77
#define SYS_GETDENTS        78
#define SYS_GETCWD          79
#define SYS_CHDIR           80
#define SYS_FCHDIR          81
#define SYS_RENAME          82
#define SYS_MKDIR           83
#define SYS_RMDIR           84
#define SYS_CREAT           85
#define SYS_LINK            86
#define SYS_UNLINK          87
#define SYS_SYMLINK         88
#define SYS_READLINK        89
#define SYS_CHMOD           90
#define SYS_FCHMOD          91
#define SYS_CHOWN           92
#define SYS_FCHOWN          93
#define SYS_LCHOWN          94
#define SYS_UMASK           95
#define SYS_GETTIMEOFDAY    96
#define SYS_GETRLIMIT       97
#define SYS_GETRUSAGE       98
#define SYS_SYSINFO         99
#define SYS_TIMES           100
#define SYS_GETUID          102
#define SYS_SYSLOG          103
#define SYS_GETGID          104
#define SYS_SETUID          105
#define SYS_SETGID          106
#define SYS_GETEUID         107
#define SYS_GETEGID         108
#define SYS_SETPGID         109
#define SYS_GETPPID         110
#define SYS_GETPGRP         111
#define SYS_SETSID          112
#define SYS_SETREUID        113
#define SYS_SETREGID        114
#define SYS_GETGROUPS       115
#define SYS_SETGROUPS       116
#define SYS_SETRESUID       117
#define SYS_GETRESUID       118
#define SYS_SETRESGID       119
#define SYS_GETRESGID       120
#define SYS_GETPGID         121
#define SYS_SETFSUID        122
#define SYS_SETFSGID        123
#define SYS_GETSID          124
#define SYS_CAPGET          125
#define SYS_CAPSET          126
#define SYS_RT_SIGPENDING   127
#define SYS_RT_SIGTIMEDWAIT 128
#define SYS_RT_SIGQUEUEINFO 129
#define SYS_RT_SIGSUSPEND   130
#define SYS_SIGALTSTACK     131
#define SYS_UTIME           132
#define SYS_MKNOD           133
#define SYS_STATFS          137
#define SYS_FSTATFS         138
#define SYS_SYSFS           139
#define SYS_GETPRIORITY     140
#define SYS_SETPRIORITY     141
#define SYS_SCHED_SETPARAM  142
#define SYS_SCHED_GETPARAM  143
#define SYS_MLOCK           149
#define SYS_MUNLOCK         150
#define SYS_MLOCKALL        151
#define SYS_MUNLOCKALL      152
#define SYS_PRCTL           157
#define SYS_ARCH_PRCTL      158
#define SYS_GETTID          186
#define SYS_FUTEX           202
#define SYS_SCHED_GETAFFINITY 204
#define SYS_SET_TID_ADDRESS 218
#define SYS_CLOCK_GETTIME   228
#define SYS_CLOCK_GETRES    229
#define SYS_CLOCK_NANOSLEEP 230
#define SYS_EXIT_GROUP      231
#define SYS_EPOLL_WAIT      232
#define SYS_EPOLL_CTL       233
#define SYS_TGKILL          234
#define SYS_UTIMES          235
#define SYS_OPENAT          257
#define SYS_MKDIRAT         258
#define SYS_MKNODAT         259
#define SYS_FCHOWNAT        260
#define SYS_FUTIMESAT       261
#define SYS_NEWFSTATAT      262
#define SYS_UNLINKAT        263
#define SYS_RENAMEAT        264
#define SYS_LINKAT          265
#define SYS_SYMLINKAT       266
#define SYS_READLINKAT      267
#define SYS_FCHMODAT        268
#define SYS_FACCESSAT       269
#define SYS_PSELECT6        270
#define SYS_PPOLL           271
#define SYS_SET_ROBUST_LIST 273
#define SYS_SPLICE          275
#define SYS_SYNC_FILE_RANGE 277
#define SYS_UTIMENSAT       280
#define SYS_EPOLL_PWAIT     281
#define SYS_SIGNALFD        282
#define SYS_TIMERFD_CREATE  283
#define SYS_EVENTFD         284
#define SYS_FALLOCATE       285
#define SYS_TIMERFD_SETTIME 286
#define SYS_TIMERFD_GETTIME 287
#define SYS_ACCEPT4         288
#define SYS_SIGNALFD4       289
#define SYS_EVENTFD2        290
#define SYS_EPOLL_CREATE1   291
#define SYS_DUP3            292
#define SYS_PIPE2           293
#define SYS_PREADV          295
#define SYS_PWRITEV         296
#define SYS_PRLIMIT64       302
#define SYS_GETRANDOM       318

// ============================================================================
// SYSCALL IMPLEMENTATION
// ============================================================================

// Main syscall dispatcher
I64 GoSyscall(I64 num, I64 a1, I64 a2, I64 a3)
{
    return GoSyscall6(num, a1, a2, a3, 0, 0, 0);
}

I64 GoSyscall6(I64 num, I64 a1, I64 a2, I64 a3, I64 a4, I64 a5, I64 a6)
{
    GoEnterSyscall();

    I64 ret = -ENOSYS;

    switch (num) {
        // ================================================================
        // FILE I/O
        // ================================================================

        case SYS_READ:
            ret = read(a1, a2(void*), a3);
            break;

        case SYS_WRITE:
            ret = write(a1, a2(void*), a3);
            break;

        case SYS_OPEN:
            ret = open(a1(U8*), a2, a3);
            break;

        case SYS_OPENAT:
            ret = openat(a1, a2(U8*), a3, a4);
            break;

        case SYS_CLOSE:
            ret = close(a1);
            break;

        case SYS_LSEEK:
            ret = lseek(a1, a2, a3);
            break;

        case SYS_PREAD64:
            ret = pread(a1, a2(void*), a3, a4);
            break;

        case SYS_PWRITE64:
            ret = pwrite(a1, a2(void*), a3, a4);
            break;

        case SYS_DUP:
            ret = dup(a1);
            break;

        case SYS_DUP2:
            ret = dup2(a1, a2);
            break;

        case SYS_DUP3:
            ret = dup3(a1, a2, a3);
            break;

        case SYS_PIPE:
            ret = pipe(a1(I64*));
            break;

        case SYS_PIPE2:
            ret = pipe2(a1(I64*), a2);
            break;

        // ================================================================
        // FILE METADATA
        // ================================================================

        case SYS_STAT:
            ret = stat(a1(U8*), a2(void*));
            break;

        case SYS_FSTAT:
            ret = fstat(a1, a2(void*));
            break;

        case SYS_LSTAT:
            ret = lstat(a1(U8*), a2(void*));
            break;

        case SYS_NEWFSTATAT:
            ret = fstatat(a1, a2(U8*), a3(void*), a4);
            break;

        case SYS_ACCESS:
            ret = access(a1(U8*), a2);
            break;

        case SYS_FACCESSAT:
            ret = faccessat(a1, a2(U8*), a3, a4);
            break;

        case SYS_CHMOD:
            ret = chmod(a1(U8*), a2);
            break;

        case SYS_FCHMOD:
            ret = fchmod(a1, a2);
            break;

        case SYS_CHOWN:
            ret = chown(a1(U8*), a2, a3);
            break;

        case SYS_FCHOWN:
            ret = fchown(a1, a2, a3);
            break;

        case SYS_LCHOWN:
            ret = lchown(a1(U8*), a2, a3);
            break;

        // ================================================================
        // DIRECTORY OPERATIONS
        // ================================================================

        case SYS_GETCWD:
            ret = getcwd(a1(U8*), a2)(I64);
            if (ret)
                ret = strlen(a1(U8*));
            break;

        case SYS_CHDIR:
            ret = chdir(a1(U8*));
            break;

        case SYS_FCHDIR:
            ret = fchdir(a1);
            break;

        case SYS_MKDIR:
            ret = mkdir(a1(U8*), a2);
            break;

        case SYS_MKDIRAT:
            ret = mkdirat(a1, a2(U8*), a3);
            break;

        case SYS_RMDIR:
            ret = rmdir(a1(U8*));
            break;

        case SYS_UNLINK:
            ret = unlink(a1(U8*));
            break;

        case SYS_UNLINKAT:
            ret = unlinkat(a1, a2(U8*), a3);
            break;

        case SYS_RENAME:
            ret = rename(a1(U8*), a2(U8*));
            break;

        case SYS_LINK:
            ret = link(a1(U8*), a2(U8*));
            break;

        case SYS_SYMLINK:
            ret = symlink(a1(U8*), a2(U8*));
            break;

        case SYS_READLINK:
            ret = readlink(a1(U8*), a2(U8*), a3);
            break;

        case SYS_READLINKAT:
            ret = readlinkat(a1, a2(U8*), a3(U8*), a4);
            break;

        // ================================================================
        // MEMORY MANAGEMENT
        // ================================================================

        case SYS_MMAP:
            ret = mmap(a1(void*), a2, a3, a4, a5, a6)(I64);
            break;

        case SYS_MUNMAP:
            ret = munmap(a1(void*), a2);
            break;

        case SYS_MPROTECT:
            ret = mprotect(a1(void*), a2, a3);
            break;

        case SYS_MADVISE:
            ret = madvise(a1(void*), a2, a3);
            break;

        case SYS_MLOCK:
            ret = mlock(a1(void*), a2);
            break;

        case SYS_MUNLOCK:
            ret = munlock(a1(void*), a2);
            break;

        case SYS_MLOCKALL:
            ret = mlockall(a1);
            break;

        case SYS_MUNLOCKALL:
            ret = munlockall();
            break;

        case SYS_BRK:
            // Simplified - just return current break
            ret = 0;
            break;

        // ================================================================
        // PROCESS MANAGEMENT
        // ================================================================

        case SYS_GETPID:
            ret = getpid();
            break;

        case SYS_GETPPID:
            ret = getppid();
            break;

        case SYS_GETTID:
            ret = Fs->task_num;
            break;

        case SYS_GETUID:
            ret = getuid();
            break;

        case SYS_GETEUID:
            ret = geteuid();
            break;

        case SYS_GETGID:
            ret = getgid();
            break;

        case SYS_GETEGID:
            ret = getegid();
            break;

        case SYS_FORK:
            ret = fork();
            break;

        case SYS_VFORK:
            ret = vfork();
            break;

        case SYS_EXECVE:
            ret = execve(a1(U8*), a2(U8**), a3(U8**));
            break;

        case SYS_EXIT:
            exit(a1);
            ret = 0;
            break;

        case SYS_EXIT_GROUP:
            exit(a1);
            ret = 0;
            break;

        case SYS_WAIT4:
            ret = waitpid(a1, a2(I64*), a3);
            break;

        case SYS_KILL:
            ret = kill(a1, a2);
            break;

        case SYS_TGKILL:
            ret = kill(a2, a3);  // Simplified
            break;

        case SYS_CLONE:
            // Simplified - just fork for now
            ret = fork();
            break;

        // ================================================================
        // SIGNALS
        // ================================================================

        case SYS_RT_SIGACTION:
            ret = sigaction(a1, a2(void*), a3(void*));
            break;

        case SYS_RT_SIGPROCMASK:
            ret = sigprocmask(a1, a2(void*), a3(void*));
            break;

        case SYS_SIGALTSTACK:
            ret = sigaltstack(a1(void*), a2(void*));
            break;

        // ================================================================
        // TIME
        // ================================================================

        case SYS_GETTIMEOFDAY: {
            struct timeval *tv = a1(struct timeval*);
            if (tv) {
                I64 sec, nsec;
                GoWalltime(&sec, &nsec);
                tv->tv_sec = sec;
                tv->tv_usec = nsec / 1000;
            }
            ret = 0;
            break;
        }

        case SYS_CLOCK_GETTIME: {
            struct timespec *ts = a2(struct timespec*);
            if (ts) {
                if (a1 == CLOCK_REALTIME) {
                    I64 sec, nsec;
                    GoWalltime(&sec, &nsec);
                    ts->tv_sec = sec;
                    ts->tv_nsec = nsec;
                } else {
                    // Monotonic or other
                    I64 ns = GoNanotime();
                    ts->tv_sec = ns / 1000000000;
                    ts->tv_nsec = ns % 1000000000;
                }
            }
            ret = 0;
            break;
        }

        case SYS_NANOSLEEP: {
            struct timespec *req = a1(struct timespec*);
            if (req) {
                I64 ns = req->tv_sec * 1000000000LL + req->tv_nsec;
                GoSleep(ns);
            }
            ret = 0;
            break;
        }

        case SYS_CLOCK_NANOSLEEP: {
            struct timespec *req = a3(struct timespec*);
            if (req) {
                I64 ns = req->tv_sec * 1000000000LL + req->tv_nsec;
                GoSleep(ns);
            }
            ret = 0;
            break;
        }

        // ================================================================
        // FUTEX
        // ================================================================

        case SYS_FUTEX:
            ret = futex(a1(U32*), a2, a3, a4(void*), a5(U32*), a6);
            break;

        // ================================================================
        // POLL/SELECT/EPOLL
        // ================================================================

        case SYS_POLL:
            ret = poll(a1(void*), a2, a3);
            break;

        case SYS_PPOLL:
            ret = ppoll(a1(void*), a2, a3(void*), a4(void*));
            break;

        case SYS_SELECT:
            ret = select(a1, a2(void*), a3(void*), a4(void*), a5(void*));
            break;

        case SYS_PSELECT6:
            ret = pselect(a1, a2(void*), a3(void*), a4(void*), a5(void*), a6(void*));
            break;

        case SYS_EPOLL_CREATE1:
            ret = epoll_create1(a1);
            break;

        case SYS_EPOLL_CTL:
            ret = epoll_ctl(a1, a2, a3, a4(void*));
            break;

        case SYS_EPOLL_WAIT:
            ret = epoll_wait(a1, a2(void*), a3, a4);
            break;

        case SYS_EPOLL_PWAIT:
            ret = epoll_pwait(a1, a2(void*), a3, a4, a5(void*));
            break;

        // ================================================================
        // SCHEDULING
        // ================================================================

        case SYS_SCHED_YIELD:
            Yield();
            ret = 0;
            break;

        case SYS_SCHED_GETAFFINITY:
            // Return 1 CPU
            if (a3 >= 8) {
                *(U64*)(a2) = 1;
                ret = 8;
            } else {
                ret = -EINVAL;
            }
            break;

        // ================================================================
        // MISC
        // ================================================================

        case SYS_FCNTL:
            ret = fcntl(a1, a2, a3);
            break;

        case SYS_IOCTL:
            ret = ioctl(a1, a2, a3);
            break;

        case SYS_UMASK:
            ret = umask(a1);
            break;

        case SYS_TRUNCATE:
            ret = truncate(a1(U8*), a2);
            break;

        case SYS_FTRUNCATE:
            ret = ftruncate(a1, a2);
            break;

        case SYS_FSYNC:
            ret = fsync(a1);
            break;

        case SYS_FDATASYNC:
            ret = fdatasync(a1);
            break;

        case SYS_PRCTL:
            // Simplified - most prctl operations not supported
            ret = 0;
            break;

        case SYS_ARCH_PRCTL:
            // Architecture-specific (TLS setup)
            if (a1 == 0x1002) {  // ARCH_SET_FS
                GoSetTLS(a2(void*));
                ret = 0;
            } else if (a1 == 0x1003) {  // ARCH_GET_FS
                *(void**)a2 = GoGetTLS();
                ret = 0;
            } else {
                ret = -EINVAL;
            }
            break;

        case SYS_SET_TID_ADDRESS:
            // Store address for clear on exit
            ret = Fs->task_num;
            break;

        case SYS_SET_ROBUST_LIST:
            // Robust futex list - simplified
            ret = 0;
            break;

        case SYS_GETRANDOM:
            // Fill buffer with random bytes
            {
                U8 *buf = a1(U8*);
                I64 len = a2;
                for (I64 i = 0; i < len; i++)
                    buf[i] = RandU8();
                ret = len;
            }
            break;

        case SYS_UNAME: {
            // struct utsname
            struct {
                U8 sysname[65];
                U8 nodename[65];
                U8 release[65];
                U8 version[65];
                U8 machine[65];
                U8 domainname[65];
            } *u = a1(void*);

            if (u) {
                StrCpy(u->sysname, "ZealOS");
                StrCpy(u->nodename, "zealos");
                StrCpy(u->release, "1.0.0");
                StrCpy(u->version, "ZealOS with Go support");
                StrCpy(u->machine, "x86_64");
                StrCpy(u->domainname, "(none)");
                ret = 0;
            } else {
                ret = -EFAULT;
            }
            break;
        }

        case SYS_GETRLIMIT:
        case SYS_PRLIMIT64:
            // Resource limits - return large values
            {
                struct {
                    U64 rlim_cur;
                    U64 rlim_max;
                } *rlim = (a1 == SYS_PRLIMIT64) ? a4(void*) : a2(void*);

                if (rlim) {
                    rlim->rlim_cur = 0x7FFFFFFFFFFFFFFF;
                    rlim->rlim_max = 0x7FFFFFFFFFFFFFFF;
                }
                ret = 0;
            }
            break;

        default:
            // Unknown syscall
            ret = -ENOSYS;
            break;
    }

    GoExitSyscall();

    // Convert errno to negative return
    if (ret < 0 && ret > -4096)
        return ret;
    if (ret == -1 && posix_errno)
        return -posix_errno;

    return ret;
}

// ============================================================================
// RAW SYSCALL (No scheduler notification)
// ============================================================================

I64 GoRawSyscall(I64 num, I64 a1, I64 a2, I64 a3)
{
    // Same as GoSyscall but without Enter/ExitSyscall
    return GoSyscall6(num, a1, a2, a3, 0, 0, 0);
}

I64 GoRawSyscall6(I64 num, I64 a1, I64 a2, I64 a3, I64 a4, I64 a5, I64 a6)
{
    return GoSyscall6(num, a1, a2, a3, a4, a5, a6);
}

// ============================================================================
// INITIALIZATION
// ============================================================================

"GoSyscall loaded - Go syscall interface for ZealOS\n";
