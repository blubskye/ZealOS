}

// ============================================================================
// PWD - Print working directory
// ============================================================================

I64 UtilPwd(I64 argc, U8 **argv)
{
	U8 cwd[1024];

	if (PosixGetcwd(cwd, sizeof(cwd))) {
		"%s\n", cwd;
		return 0;
	}

	"pwd: %s\n", PosixStrerror(posix_errno);
	return 1;
}

// ============================================================================
// CLEAR - Clear the terminal screen
// ============================================================================

I64 UtilClear(I64 argc, U8 **argv)
{
	// ANSI escape to clear screen
	"\033[2J\033[H";
	return 0;
}

// ============================================================================
// CMP - Compare two files byte by byte
// ============================================================================

I64 UtilCmp(I64 argc, U8 **argv)
{
	Bool silent = FALSE;
	Bool verbose = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (!StrCmp(argv[i], "-s") || !StrCmp(argv[i], "--silent"))
			silent = TRUE;
		else if (!StrCmp(argv[i], "-l"))
			verbose = TRUE;
		arg_start = i + 1;
	}

	if (argc - arg_start < 2) {
		"cmp: missing operand\n";
		return 2;
	}

	I64 fd1 = PosixOpen(argv[arg_start], O_RDONLY, 0);
	if (fd1 < 0) {
		if (!silent)
			"cmp: %s: %s\n", argv[arg_start], PosixStrerror(posix_errno);
		return 2;
	}

	I64 fd2 = PosixOpen(argv[arg_start + 1], O_RDONLY, 0);
	if (fd2 < 0) {
		if (!silent)
			"cmp: %s: %s\n", argv[arg_start + 1], PosixStrerror(posix_errno);
		PosixClose(fd1);
		return 2;
	}

	I64 byte_pos = 1;
	I64 line_num = 1;
	U8 buf1[4096], buf2[4096];
	I64 n1, n2;
	I64 result = 0;

	while (1) {
		n1 = PosixRead(fd1, buf1, sizeof(buf1));
		n2 = PosixRead(fd2, buf2, sizeof(buf2));

		I64 min_n = (n1 < n2) ? n1 : n2;

		for (I64 i = 0; i < min_n; i++) {
			if (buf1[i] != buf2[i]) {
				if (verbose) {
					"%d %o %o\n", byte_pos, buf1[i], buf2[i];
				} else if (!silent) {
					"%s %s differ: byte %d, line %d\n",
						argv[arg_start], argv[arg_start + 1], byte_pos, line_num;
					result = 1;
					goto done;
				} else {
					result = 1;
					goto done;
				}
			}
			if (buf1[i] == '\n')
				line_num++;
			byte_pos++;
		}

		if (n1 != n2) {
			if (!silent) {
				"cmp: EOF on %s\n", (n1 < n2) ? argv[arg_start] : argv[arg_start + 1];
			}
			result = 1;
			goto done;
		}

		if (n1 <= 0)
			break;
	}

done:
	PosixClose(fd1);
	PosixClose(fd2);
	return result;
}

// ============================================================================
// XXD - Make a hexdump
// ============================================================================

I64 UtilXxd(I64 argc, U8 **argv)
{
	Bool reverse = FALSE;
	I64 cols = 16;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (!StrCmp(argv[i], "-r"))
			reverse = TRUE;
		else if (argv[i][1] == 'c') {
			if (argv[i][2])
				cols = Str2I64(argv[i] + 2);
			else if (i + 1 < argc)
				cols = Str2I64(argv[++i]);
		}
		arg_start = i + 1;
	}

	I64 fd;
	if (arg_start >= argc) {
		fd = 0;
	} else {
		fd = PosixOpen(argv[arg_start], O_RDONLY, 0);
		if (fd < 0) {
			"xxd: %s: %s\n", argv[arg_start], PosixStrerror(posix_errno);
			return 1;
		}
	}

	U8 buf[4096];
	I64 n;
	I64 offset = 0;

	while ((n = PosixRead(fd, buf, sizeof(buf))) > 0) {
		for (I64 i = 0; i < n; i += cols) {
			// Print offset
			"%08x: ", offset + i;

			// Print hex bytes
			for (I64 j = 0; j < cols; j++) {
				if (i + j < n)
					"%02x", buf[i + j];
				else
					"  ";
				if (j % 2 == 1)
					" ";
			}

			// Print ASCII
			" ";
			for (I64 j = 0; j < cols && i + j < n; j++) {
				U8 c = buf[i + j];
				if (c >= 32 && c < 127)
					"%c", c;
				else
					".";
			}
			"\n";
		}
		offset += n;
	}

	if (fd != 0)
		PosixClose(fd);

	return 0;
}

// ============================================================================
// OD - Octal dump
// ============================================================================

I64 UtilOd(I64 argc, U8 **argv)
{
	Bool hex = FALSE;
	Bool octal = TRUE;
	Bool chars = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'x': hex = TRUE; octal = FALSE; break;
				case 'c': chars = TRUE; octal = FALSE; break;
				case 'o': octal = TRUE; break;
				default:
					"od: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	I64 fd;
	if (arg_start >= argc) {
		fd = 0;
	} else {
		fd = PosixOpen(argv[arg_start], O_RDONLY, 0);
		if (fd < 0) {
			"od: %s: %s\n", argv[arg_start], PosixStrerror(posix_errno);
			return 1;
		}
	}

	U8 buf[16];
	I64 n;
	I64 offset = 0;

	while ((n = PosixRead(fd, buf, sizeof(buf))) > 0) {
		// Print offset in octal
		"%07o", offset;

		if (chars) {
			for (I64 i = 0; i < n; i++) {
				U8 c = buf[i];
				if (c == '\0')
					" \\0";
				else if (c == '\n')
					" \\n";
				else if (c == '\t')
					" \\t";
				else if (c == '\r')
					" \\r";
				else if (c >= 32 && c < 127)
					"  %c", c;
				else
					" %03o", c;
			}
		} else if (hex) {
			for (I64 i = 0; i < n; i++)
				" %02x", buf[i];
		} else {
			for (I64 i = 0; i < n; i++)
				" %03o", buf[i];
		}
		"\n";

		offset += n;
	}

	// Print final offset
	"%07o\n", offset;

	if (fd != 0)
		PosixClose(fd);

	return 0;
}

// ============================================================================
// HEXDUMP - Display file in hexadecimal format
// ============================================================================

I64 UtilHexdump(I64 argc, U8 **argv)
{
	Bool canonical = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (!StrCmp(argv[i], "-C"))
			canonical = TRUE;
		arg_start = i + 1;
	}

	I64 fd;
	if (arg_start >= argc) {
		fd = 0;
	} else {
		fd = PosixOpen(argv[arg_start], O_RDONLY, 0);
		if (fd < 0) {
			"hexdump: %s: %s\n", argv[arg_start], PosixStrerror(posix_errno);
			return 1;
		}
	}

	U8 buf[16];
	I64 n;
	I64 offset = 0;

	while ((n = PosixRead(fd, buf, sizeof(buf))) > 0) {
		"%08x", offset;

		if (canonical) {
			" ";
			for (I64 i = 0; i < 16; i++) {
				if (i < n)
					" %02x", buf[i];
				else
					"   ";
				if (i == 7)
					" ";
			}
			"  |";
			for (I64 i = 0; i < n; i++) {
				if (buf[i] >= 32 && buf[i] < 127)
					"%c", buf[i];
				else
					".";
			}
			"|";
		} else {
			for (I64 i = 0; i < n; i += 2) {
				if (i + 1 < n)
					" %02x%02x", buf[i + 1], buf[i];
				else
					" %02x", buf[i];
			}
		}
		"\n";

		offset += n;
	}

	"%08x\n", offset;

	if (fd != 0)
		PosixClose(fd);

	return 0;
}
