// FileUtils.ZC - File Utilities for ZealOS POSIX Layer
// Part of ZealOS POSIX compatibility layer

// ============================================================================
// CAT - Concatenate files
// ============================================================================

I64 UtilCat(I64 argc, U8 **argv)
{
	I64 i, fd, n;
	U8 buf[4096];
	Bool show_ends = FALSE;
	Bool show_tabs = FALSE;
	Bool number_lines = FALSE;
	Bool number_nonblank = FALSE;
	Bool squeeze_blank = FALSE;
	I64 line_num = 1;
	Bool last_was_blank = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (i = 1; i < argc && argv[i][0] == '-' && argv[i][1]; i++) {
		U8 *opt = argv[i] + 1;
		if (!StrCmp(opt, "-")) {
			arg_start = i + 1;
			break;
		}
		while (*opt) {
			switch (*opt) {
				case 'n': number_lines = TRUE; break;
				case 'b': number_nonblank = TRUE; break;
				case 'E': show_ends = TRUE; break;
				case 'T': show_tabs = TRUE; break;
				case 's': squeeze_blank = TRUE; break;
				case 'A': show_ends = show_tabs = TRUE; break;
				default:
					"cat: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	// If no files, read stdin
	if (arg_start >= argc) {
		fd = 0;  // stdin
		while ((n = PosixRead(fd, buf, sizeof(buf) - 1)) > 0) {
			buf[n] = 0;
			"%s", buf;
		}
		return 0;
	}

	// Process each file
	for (i = arg_start; i < argc; i++) {
		if (!StrCmp(argv[i], "-")) {
			fd = 0;  // stdin
		} else {
			fd = PosixOpen(argv[i], O_RDONLY, 0);
			if (fd < 0) {
				"cat: %s: %s\n", argv[i], PosixStrerror(posix_errno);
				continue;
			}
		}

		// Simple case - just output
		if (!number_lines && !number_nonblank && !show_ends && !show_tabs && !squeeze_blank) {
			while ((n = PosixRead(fd, buf, sizeof(buf) - 1)) > 0) {
				buf[n] = 0;
				"%s", buf;
			}
		} else {
			// Complex case with transformations
			U8 line[4096];
			I64 line_pos = 0;

			while ((n = PosixRead(fd, buf, sizeof(buf))) > 0) {
				for (I64 j = 0; j < n; j++) {
					if (buf[j] == '\n') {
						line[line_pos] = 0;
						Bool is_blank = (line_pos == 0);

						if (squeeze_blank && is_blank && last_was_blank)
							continue;

						if (number_lines || (number_nonblank && !is_blank)) {
							"%6d\t", line_num++;
						}

						// Output line with transformations
						for (I64 k = 0; k < line_pos; k++) {
							if (show_tabs && line[k] == '\t')
								"^I";
							else
								"%c", line[k];
						}

						if (show_ends)
							"$";
						"\n";

						last_was_blank = is_blank;
						line_pos = 0;
					} else {
						if (line_pos < sizeof(line) - 1)
							line[line_pos++] = buf[j];
					}
				}
			}

			// Handle last line without newline
			if (line_pos > 0) {
				line[line_pos] = 0;
				if (number_lines || number_nonblank)
					"%6d\t", line_num++;
				"%s", line;
			}
		}

		if (fd != 0)
			PosixClose(fd);
	}

	return 0;
}

// ============================================================================
// HEAD - Output first part of files
// ============================================================================

I64 UtilHead(I64 argc, U8 **argv)
{
	I64 i, fd, n;
	I64 num_lines = 10;
	I64 num_bytes = -1;
	I64 arg_start = 1;
	U8 buf[4096];

	// Parse options
	for (i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (argv[i][1] == 'n' && argv[i][2]) {
			num_lines = Str2I64(argv[i] + 2);
			arg_start = i + 1;
		} else if (argv[i][1] == 'n') {
			if (i + 1 < argc) {
				num_lines = Str2I64(argv[++i]);
				arg_start = i + 1;
			}
		} else if (argv[i][1] == 'c' && argv[i][2]) {
			num_bytes = Str2I64(argv[i] + 2);
			arg_start = i + 1;
		} else if (argv[i][1] == 'c') {
			if (i + 1 < argc) {
				num_bytes = Str2I64(argv[++i]);
				arg_start = i + 1;
			}
		} else if (argv[i][1] >= '0' && argv[i][1] <= '9') {
			num_lines = Str2I64(argv[i] + 1);
			arg_start = i + 1;
		} else {
			arg_start = i + 1;
		}
	}

	Bool multiple = (argc - arg_start) > 1;

	// If no files, read stdin
	if (arg_start >= argc) {
		fd = 0;
		if (num_bytes >= 0) {
			I64 remaining = num_bytes;
			while (remaining > 0 && (n = PosixRead(fd, buf, MinI64(sizeof(buf) - 1, remaining))) > 0) {
				buf[n] = 0;
				"%s", buf;
				remaining -= n;
			}
		} else {
			I64 lines = 0;
			while (lines < num_lines && (n = PosixRead(fd, buf, sizeof(buf) - 1)) > 0) {
				for (I64 j = 0; j < n && lines < num_lines; j++) {
					"%c", buf[j];
					if (buf[j] == '\n')
						lines++;
				}
			}
		}
		return 0;
	}

	// Process each file
	for (i = arg_start; i < argc; i++) {
		if (!StrCmp(argv[i], "-")) {
			fd = 0;
		} else {
			fd = PosixOpen(argv[i], O_RDONLY, 0);
			if (fd < 0) {
				"head: %s: %s\n", argv[i], PosixStrerror(posix_errno);
				continue;
			}
		}

		if (multiple)
			"==> %s <==\n", argv[i];

		if (num_bytes >= 0) {
			I64 remaining = num_bytes;
			while (remaining > 0 && (n = PosixRead(fd, buf, MinI64(sizeof(buf) - 1, remaining))) > 0) {
				buf[n] = 0;
				"%s", buf;
				remaining -= n;
			}
		} else {
			I64 lines = 0;
			while (lines < num_lines && (n = PosixRead(fd, buf, sizeof(buf) - 1)) > 0) {
				for (I64 j = 0; j < n && lines < num_lines; j++) {
					"%c", buf[j];
					if (buf[j] == '\n')
						lines++;
				}
			}
		}

		if (fd != 0)
			PosixClose(fd);

		if (multiple && i < argc - 1)
			"\n";
	}

	return 0;
}

// ============================================================================
// TAIL - Output last part of files
// ============================================================================

I64 UtilTail(I64 argc, U8 **argv)
{
	I64 i, fd;
	I64 num_lines = 10;
	I64 arg_start = 1;
	U8 *content;
	I64 size;

	// Parse options
	for (i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (argv[i][1] == 'n' && argv[i][2]) {
			num_lines = Str2I64(argv[i] + 2);
			arg_start = i + 1;
		} else if (argv[i][1] == 'n') {
			if (i + 1 < argc) {
				num_lines = Str2I64(argv[++i]);
				arg_start = i + 1;
			}
		} else if (argv[i][1] >= '0' && argv[i][1] <= '9') {
			num_lines = Str2I64(argv[i] + 1);
			arg_start = i + 1;
		} else {
			arg_start = i + 1;
		}
	}

	Bool multiple = (argc - arg_start) > 1;

	// Process each file
	for (i = (arg_start >= argc) ? arg_start : arg_start; i < argc || i == arg_start; i++) {
		if (i >= argc) {
			// stdin - not easily supported for tail
			"tail: stdin not supported\n";
			return 1;
		}

		if (multiple)
			"==> %s <==\n", argv[i];

		// Read entire file
		content = FileRead(argv[i], &size);
		if (!content) {
			"tail: %s: %s\n", argv[i], PosixStrerror(posix_errno);
			continue;
		}

		// Count lines from end
		I64 lines = 0;
		I64 start = size;

		for (I64 j = size - 1; j >= 0 && lines < num_lines; j--) {
			if (content[j] == '\n') {
				lines++;
				if (lines < num_lines)
					start = j;
			}
		}

		if (lines < num_lines)
			start = 0;
		else if (start < size && content[start] == '\n')
			start++;

		// Output
		for (I64 j = start; j < size; j++)
			"%c", content[j];

		Free(content);

		if (multiple && i < argc - 1)
			"\n";
	}

	return 0;
}

// ============================================================================
// WC - Word, line, character count
// ============================================================================

I64 UtilWc(I64 argc, U8 **argv)
{
	I64 i, fd, n;
	U8 buf[4096];
	Bool count_lines = FALSE;
	Bool count_words = FALSE;
	Bool count_chars = FALSE;
	Bool count_bytes = FALSE;
	I64 arg_start = 1;

	I64 total_lines = 0, total_words = 0, total_chars = 0;

	// Parse options
	for (i = 1; i < argc && argv[i][0] == '-' && argv[i][1]; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'l': count_lines = TRUE; break;
				case 'w': count_words = TRUE; break;
				case 'c': count_bytes = TRUE; break;
				case 'm': count_chars = TRUE; break;
				default:
					"wc: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	// Default: all counts
	if (!count_lines && !count_words && !count_chars && !count_bytes) {
		count_lines = count_words = count_bytes = TRUE;
	}

	Bool multiple = (argc - arg_start) > 1;

	// If no files, read stdin
	if (arg_start >= argc) {
		argv[arg_start] = "-";
		argc = arg_start + 1;
	}

	// Process each file
	for (i = arg_start; i < argc; i++) {
		I64 lines = 0, words = 0, chars = 0;
		Bool in_word = FALSE;

		if (!StrCmp(argv[i], "-")) {
			fd = 0;
		} else {
			fd = PosixOpen(argv[i], O_RDONLY, 0);
			if (fd < 0) {
				"wc: %s: %s\n", argv[i], PosixStrerror(posix_errno);
				continue;
			}
		}

		while ((n = PosixRead(fd, buf, sizeof(buf))) > 0) {
			for (I64 j = 0; j < n; j++) {
				chars++;
				if (buf[j] == '\n')
					lines++;

				if (buf[j] == ' ' || buf[j] == '\t' || buf[j] == '\n' ||
				    buf[j] == '\r' || buf[j] == '\f' || buf[j] == '\v') {
					in_word = FALSE;
				} else {
					if (!in_word) {
						words++;
						in_word = TRUE;
					}
				}
			}
		}

		if (fd != 0)
			PosixClose(fd);

		// Print counts
		if (count_lines)
			"%7d ", lines;
		if (count_words)
			"%7d ", words;
		if (count_bytes || count_chars)
			"%7d ", chars;

		if (StrCmp(argv[i], "-"))
			"%s", argv[i];
		"\n";

		total_lines += lines;
		total_words += words;
		total_chars += chars;
	}

	// Print totals if multiple files
	if (multiple) {
		if (count_lines)
			"%7d ", total_lines;
		if (count_words)
			"%7d ", total_words;
		if (count_bytes || count_chars)
			"%7d ", total_chars;
		"total\n";
	}

	return 0;
}

// ============================================================================
// CP - Copy files
// ============================================================================

I64 UtilCp(I64 argc, U8 **argv)
{
	I64 src_fd, dst_fd, n;
	U8 buf[8192];
	Bool recursive = FALSE;
	Bool force = FALSE;
	Bool verbose = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'r':
				case 'R': recursive = TRUE; break;
				case 'f': force = TRUE; break;
				case 'v': verbose = TRUE; break;
				default:
					"cp: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (argc - arg_start < 2) {
		"cp: missing operand\n";
		return 1;
	}

	U8 *dest = argv[argc - 1];
	Bool dest_is_dir = IsDir(dest);

	// Multiple sources require directory destination
	if (argc - arg_start > 2 && !dest_is_dir) {
		"cp: target '%s' is not a directory\n", dest;
		return 1;
	}

	for (I64 i = arg_start; i < argc - 1; i++) {
		U8 *src = argv[i];
		U8 dst_path[1024];

		if (dest_is_dir) {
			// Extract basename
			U8 *base = src + StrLen(src);
			while (base > src && base[-1] != '/')
				base--;
			StrPrint(dst_path, "%s/%s", dest, base);
		} else {
			StrCpy(dst_path, dest);
		}

		// Check if source is directory
		if (IsDir(src)) {
			if (!recursive) {
				"cp: -r not specified; omitting directory '%s'\n", src;
				continue;
			}
			// TODO: recursive copy
			"cp: recursive copy not yet implemented\n";
			continue;
		}

		src_fd = PosixOpen(src, O_RDONLY, 0);
		if (src_fd < 0) {
			"cp: cannot open '%s': %s\n", src, PosixStrerror(posix_errno);
			continue;
		}

		dst_fd = PosixOpen(dst_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
		if (dst_fd < 0) {
			"cp: cannot create '%s': %s\n", dst_path, PosixStrerror(posix_errno);
			PosixClose(src_fd);
			continue;
		}

		while ((n = PosixRead(src_fd, buf, sizeof(buf))) > 0) {
			PosixWrite(dst_fd, buf, n);
		}

		PosixClose(src_fd);
		PosixClose(dst_fd);

		if (verbose)
			"'%s' -> '%s'\n", src, dst_path;
	}

	return 0;
}

// ============================================================================
// MV - Move/rename files
// ============================================================================

I64 UtilMv(I64 argc, U8 **argv)
{
	Bool force = FALSE;
	Bool verbose = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'f': force = TRUE; break;
				case 'v': verbose = TRUE; break;
				default:
					"mv: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (argc - arg_start < 2) {
		"mv: missing operand\n";
		return 1;
	}

	U8 *dest = argv[argc - 1];
	Bool dest_is_dir = IsDir(dest);

	if (argc - arg_start > 2 && !dest_is_dir) {
		"mv: target '%s' is not a directory\n", dest;
		return 1;
	}

	for (I64 i = arg_start; i < argc - 1; i++) {
		U8 *src = argv[i];
		U8 dst_path[1024];

		if (dest_is_dir) {
			U8 *base = src + StrLen(src);
			while (base > src && base[-1] != '/')
				base--;
			StrPrint(dst_path, "%s/%s", dest, base);
		} else {
			StrCpy(dst_path, dest);
		}

		if (PosixRename(src, dst_path) < 0) {
			"mv: cannot move '%s' to '%s': %s\n", src, dst_path, PosixStrerror(posix_errno);
			continue;
		}

		if (verbose)
			"'%s' -> '%s'\n", src, dst_path;
	}

	return 0;
}

// ============================================================================
// RM - Remove files
// ============================================================================

I64 UtilRm(I64 argc, U8 **argv)
{
	Bool force = FALSE;
	Bool recursive = FALSE;
	Bool verbose = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'f': force = TRUE; break;
				case 'r':
				case 'R': recursive = TRUE; break;
				case 'v': verbose = TRUE; break;
				default:
					"rm: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (arg_start >= argc && !force) {
		"rm: missing operand\n";
		return 1;
	}

	I64 status = 0;

	for (I64 i = arg_start; i < argc; i++) {
		U8 *path = argv[i];

		if (IsDir(path)) {
			if (!recursive) {
				"rm: cannot remove '%s': Is a directory\n", path;
				status = 1;
				continue;
			}
			// TODO: recursive delete
			if (PosixRmdir(path) < 0) {
				if (!force) {
					"rm: cannot remove '%s': %s\n", path, PosixStrerror(posix_errno);
					status = 1;
				}
				continue;
			}
		} else {
			if (PosixUnlink(path) < 0) {
				if (!force) {
					"rm: cannot remove '%s': %s\n", path, PosixStrerror(posix_errno);
					status = 1;
				}
				continue;
			}
		}

		if (verbose)
			"removed '%s'\n", path;
	}

	return status;
}

// ============================================================================
// MKDIR - Create directories
// ============================================================================

I64 UtilMkdir(I64 argc, U8 **argv)
{
	Bool parents = FALSE;
	Bool verbose = FALSE;
	I64 mode = 0755;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'p': parents = TRUE; break;
				case 'v': verbose = TRUE; break;
				case 'm':
					if (i + 1 < argc)
						mode = Str2I64(argv[++i]);
					break;
				default:
					"mkdir: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (arg_start >= argc) {
		"mkdir: missing operand\n";
		return 1;
	}

	I64 status = 0;

	for (I64 i = arg_start; i < argc; i++) {
		U8 *path = argv[i];

		if (parents) {
			// Create parent directories as needed
			U8 temp[1024];
			StrCpy(temp, path);
			U8 *p = temp;
			while (*p) {
				if (*p == '/' && p != temp) {
					*p = 0;
					if (!IsDir(temp))
						PosixMkdir(temp, mode);
					*p = '/';
				}
				p++;
			}
		}

		if (PosixMkdir(path, mode) < 0) {
			if (!parents || posix_errno != EEXIST) {
				"mkdir: cannot create directory '%s': %s\n", path, PosixStrerror(posix_errno);
				status = 1;
				continue;
			}
		}

		if (verbose)
			"mkdir: created directory '%s'\n", path;
	}

	return status;
}

// ============================================================================
// RMDIR - Remove empty directories
// ============================================================================

I64 UtilRmdir(I64 argc, U8 **argv)
{
	Bool parents = FALSE;
	Bool verbose = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'p': parents = TRUE; break;
				case 'v': verbose = TRUE; break;
				default:
					"rmdir: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (arg_start >= argc) {
		"rmdir: missing operand\n";
		return 1;
	}

	I64 status = 0;

	for (I64 i = arg_start; i < argc; i++) {
		U8 *path = argv[i];

		if (PosixRmdir(path) < 0) {
			"rmdir: failed to remove '%s': %s\n", path, PosixStrerror(posix_errno);
			status = 1;
			continue;
		}

		if (verbose)
			"rmdir: removing directory, '%s'\n", path;

		// Remove parents if requested
		if (parents) {
			U8 temp[1024];
			StrCpy(temp, path);
			while (1) {
				U8 *last = temp + StrLen(temp);
				while (last > temp && last[-1] != '/')
					last--;
				if (last <= temp)
					break;
				last[-1] = 0;
				if (!temp[0])
					break;
				if (PosixRmdir(temp) < 0)
					break;
				if (verbose)
					"rmdir: removing directory, '%s'\n", temp;
			}
		}
	}

	return status;
}

// ============================================================================
// LS - List directory contents
// ============================================================================

I64 UtilLs(I64 argc, U8 **argv)
{
	Bool long_format = FALSE;
	Bool all = FALSE;
	Bool human = FALSE;
	Bool one_per_line = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 'l': long_format = TRUE; break;
				case 'a': all = TRUE; break;
				case 'h': human = TRUE; break;
				case '1': one_per_line = TRUE; break;
				default:
					"ls: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	// Default to current directory
	if (arg_start >= argc) {
		argv[arg_start] = ".";
		argc = arg_start + 1;
	}

	for (I64 i = arg_start; i < argc; i++) {
		U8 *path = argv[i];
		I64 dir_fd;
		CPosixDirent *entry;

		if (argc - arg_start > 1)
			"%s:\n", path;

		dir_fd = PosixOpenDir(path);
		if (dir_fd < 0) {
			"ls: cannot access '%s': %s\n", path, PosixStrerror(posix_errno);
			continue;
		}

		while ((entry = PosixReadDir(dir_fd)) != NULL) {
			// Skip hidden files unless -a
			if (!all && entry->d_name[0] == '.')
				continue;

			if (long_format) {
				U8 fullpath[1024];
				CPosixStat st;
				StrPrint(fullpath, "%s/%s", path, entry->d_name);

				if (PosixStat(fullpath, &st) == 0) {
					// File type
					if (S_ISDIR(st.st_mode))
						"d";
					else if (S_ISLNK(st.st_mode))
						"l";
					else
						"-";

					// Permissions (simplified)
					"rwxr-xr-x ";

					// Size
					if (human && st.st_size >= 1024 * 1024)
						"%4dM ", st.st_size / (1024 * 1024);
					else if (human && st.st_size >= 1024)
						"%4dK ", st.st_size / 1024;
					else
						"%8d ", st.st_size;

					"%s\n", entry->d_name;
				} else {
					"?????????? ? %s\n", entry->d_name;
				}
			} else if (one_per_line) {
				"%s\n", entry->d_name;
			} else {
				"%s  ", entry->d_name;
			}
		}

		if (!long_format && !one_per_line)
			"\n";

		PosixCloseDir(dir_fd);

		if (argc - arg_start > 1 && i < argc - 1)
			"\n";
	}

	return 0;
}

// ============================================================================
// TOUCH - Change file timestamps
// ============================================================================

I64 UtilTouch(I64 argc, U8 **argv)
{
	Bool no_create = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		if (!StrCmp(argv[i], "-c"))
			no_create = TRUE;
		arg_start = i + 1;
	}

	if (arg_start >= argc) {
		"touch: missing operand\n";
		return 1;
	}

	for (I64 i = arg_start; i < argc; i++) {
		U8 *path = argv[i];

		// Check if file exists
		if (PosixAccess(path, F_OK) < 0) {
			if (no_create)
				continue;

			// Create empty file
			I64 fd = PosixOpen(path, O_WRONLY | O_CREAT, 0644);
			if (fd < 0) {
				"touch: cannot create '%s': %s\n", path, PosixStrerror(posix_errno);
				continue;
			}
			PosixClose(fd);
		} else {
			// Update timestamp (not really possible in ZealOS, but we try)
			// Just open and close the file
			I64 fd = PosixOpen(path, O_WRONLY, 0);
			if (fd >= 0)
				PosixClose(fd);
		}
	}

	return 0;
}

// ============================================================================
// CHMOD - Change file mode (no-op in ZealOS)
// ============================================================================

I64 UtilChmod(I64 argc, U8 **argv)
{
	// ZealOS doesn't have file permissions, so this is a no-op
	if (argc < 3) {
		"chmod: missing operand\n";
		return 1;
	}

	// Just pretend it worked
	return 0;
}

// ============================================================================
// LN - Create links (limited support)
// ============================================================================

I64 UtilLn(I64 argc, U8 **argv)
{
	Bool symbolic = FALSE;
	Bool force = FALSE;
	I64 arg_start = 1;

	// Parse options
	for (I64 i = 1; i < argc && argv[i][0] == '-'; i++) {
		U8 *opt = argv[i] + 1;
		while (*opt) {
			switch (*opt) {
				case 's': symbolic = TRUE; break;
				case 'f': force = TRUE; break;
				default:
					"ln: invalid option -- '%c'\n", *opt;
					return 1;
			}
			opt++;
		}
		arg_start = i + 1;
	}

	if (argc - arg_start < 2) {
		"ln: missing operand\n";
		return 1;
	}

	// ZealOS doesn't support links
	"ln: links not supported in ZealOS\n";
	return 1;
}
