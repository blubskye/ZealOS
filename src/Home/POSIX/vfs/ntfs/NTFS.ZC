// NTFS.ZC - NTFS Filesystem Driver for ZealOS
// Part of the POSIX compatibility layer
//
// Clean-room implementation based on publicly available NTFS documentation.
// This is a read-only driver for safety.
//
// Features:
// - Read-only access to NTFS volumes
// - Resident and non-resident attribute support
// - Directory index traversal (B+ tree)
// - UTF-16 to UTF-8 filename conversion
// - Run list decoding for non-resident data
//
// Limitations:
// - No write support (by design)
// - No compression support
// - No encryption support
// - No extended attributes

#include "NTFS.HH"

// ============================================================================
// UTF-16 TO UTF-8 CONVERSION
// ============================================================================

U8 *NTFSUtf16ToUtf8(U16 *utf16, I64 len)
{
    if (!utf16 || len <= 0)
        return StrNew("");

    // Calculate required size (worst case: 3 bytes per UTF-16 code unit)
    I64 utf8_max = len * 3 + 1;
    U8 *utf8 = MAlloc(utf8_max);
    if (!utf8)
        return NULL;

    U8 *dst = utf8;
    I64 i;

    for (i = 0; i < len; i++) {
        U16 c = utf16[i];  // Assume little-endian (NTFS native)

        if (c < 0x80) {
            *dst++ = c;
        } else if (c < 0x800) {
            *dst++ = 0xC0 | (c >> 6);
            *dst++ = 0x80 | (c & 0x3F);
        } else {
            *dst++ = 0xE0 | (c >> 12);
            *dst++ = 0x80 | ((c >> 6) & 0x3F);
            *dst++ = 0x80 | (c & 0x3F);
        }
    }

    *dst = 0;
    return utf8;
}

// ============================================================================
// DEVICE I/O
// ============================================================================

I64 NTFSDeviceRead(CNTFS *fs, U64 offset, U0 *buf, I64 size)
{
    if (!fs || !buf)
        return -EINVAL;

    if (fs->device_fd >= 0) {
        I64 result = PosixLseek(fs->device_fd, offset, SEEK_SET);
        if (result < 0)
            return result;
        return PosixRead(fs->device_fd, buf, size);
    }

    return -EIO;
}

I64 NTFSReadClusters(CNTFS *fs, U64 lcn, I64 count, U0 *buf)
{
    return NTFSDeviceRead(fs, lcn * fs->bytes_per_cluster, buf,
                          count * fs->bytes_per_cluster);
}

I64 NTFSReadSectors(CNTFS *fs, U64 lsn, I64 count, U0 *buf)
{
    return NTFSDeviceRead(fs, lsn * fs->bytes_per_sector, buf,
                          count * fs->bytes_per_sector);
}

// ============================================================================
// UPDATE SEQUENCE FIXUP
// ============================================================================

// Apply update sequence fixup to a record
I64 NTFSFixupRecord(U0 *buf, U32 size, U16 update_seq_offset, U16 update_seq_count)
{
    U16 *usa = buf + update_seq_offset;
    U16 seq_num = usa[0];
    I64 i;

    // Each sector (512 bytes) ends with a 2-byte update sequence entry
    // that must be restored from the array
    for (i = 1; i < update_seq_count; i++) {
        U32 offset = i * 512 - 2;
        if (offset + 2 > size)
            break;

        U16 *sector_end = buf + offset;
        if (*sector_end != seq_num) {
            // Sequence number mismatch - corrupted record
            return -EIO;
        }
        *sector_end = usa[i];
    }

    return 0;
}

// ============================================================================
// RUN LIST DECODING
// ============================================================================

CNTFSRunEntry *NTFSDecodeRunlist(U8 *runlist, U64 base_vcn)
{
    if (!runlist)
        return NULL;

    CNTFSRunEntry *first = NULL;
    CNTFSRunEntry *last = NULL;
    U8 *p = runlist;
    I64 prev_lcn = 0;
    U64 vcn = base_vcn;

    while (*p) {
        U8 header = *p++;
        U8 len_size = header & 0x0F;
        U8 offset_size = (header >> 4) & 0x0F;

        if (len_size == 0)
            break;

        // Read length (unsigned)
        U64 length = 0;
        I64 i;
        for (i = 0; i < len_size; i++)
            length |= (*p++)(U64) << (i * 8);

        // Read LCN offset (signed)
        I64 lcn_offset = 0;
        if (offset_size > 0) {
            for (i = 0; i < offset_size; i++)
                lcn_offset |= (*p++)(I64) << (i * 8);

            // Sign extend
            if (lcn_offset & (1(I64) << (offset_size * 8 - 1))) {
                lcn_offset |= (-1)(I64) << (offset_size * 8);
            }
        }

        // Create run entry
        CNTFSRunEntry *run = MAlloc(sizeof(CNTFSRunEntry));
        if (!run) {
            NTFSFreeRunlist(first);
            return NULL;
        }

        run->vcn = vcn;
        run->length = length;

        if (offset_size == 0) {
            // Sparse run
            run->lcn = 0;
        } else {
            prev_lcn += lcn_offset;
            run->lcn = prev_lcn;
        }

        run->next = NULL;

        if (last)
            last->next = run;
        else
            first = run;
        last = run;

        vcn += length;
    }

    return first;
}

U0 NTFSFreeRunlist(CNTFSRunEntry *runs)
{
    while (runs) {
        CNTFSRunEntry *next = runs->next;
        Free(runs);
        runs = next;
    }
}

// ============================================================================
// MFT RECORD PARSING
// ============================================================================

I64 NTFSReadMFTRecord(CNTFS *fs, U64 record_num, U0 *buf)
{
    // Calculate position in $MFT
    U64 byte_offset = record_num * fs->mft_record_size;
    U64 cluster_offset = byte_offset / fs->bytes_per_cluster;
    U64 cluster_byte_offset = byte_offset % fs->bytes_per_cluster;

    // For now, assume MFT is contiguous (simplified)
    // A full implementation would use MFT's own runlist
    U64 lcn = fs->mft_lcn + cluster_offset;

    // Read the cluster(s) containing this record
    U64 records_per_cluster = fs->bytes_per_cluster / fs->mft_record_size;

    if (fs->mft_record_size >= fs->bytes_per_cluster) {
        // Record spans one or more clusters
        I64 clusters_needed = (fs->mft_record_size + fs->bytes_per_cluster - 1) /
                               fs->bytes_per_cluster;
        I64 result = NTFSReadClusters(fs, lcn, clusters_needed, buf);
        if (result < 0)
            return result;
    } else {
        // Multiple records per cluster
        U8 *cluster_buf = MAlloc(fs->bytes_per_cluster);
        if (!cluster_buf)
            return -ENOMEM;

        I64 result = NTFSReadClusters(fs, lcn, 1, cluster_buf);
        if (result < 0) {
            Free(cluster_buf);
            return result;
        }

        MemCpy(buf, cluster_buf + cluster_byte_offset, fs->mft_record_size);
        Free(cluster_buf);
    }

    // Verify signature
    CNTFSRecordHeader *hdr = buf;
    if (hdr->magic != NTFS_FILE_SIGNATURE)
        return -EIO;

    // Apply update sequence fixup
    return NTFSFixupRecord(buf, fs->mft_record_size,
                           hdr->update_seq_offset, hdr->update_seq_count);
}

// Find attribute in MFT record
U0 *NTFSFindAttribute(U0 *record, U32 attr_type, U16 *attr_name, U8 attr_name_len)
{
    CNTFSRecordHeader *hdr = record;
    U8 *p = record + hdr->attrs_offset;

    while (p < record(U8*) + hdr->bytes_used) {
        CNTFSAttrHeader *attr = p;

        if (attr->type == NTFS_AT_END || attr->length == 0)
            break;

        if (attr->type == attr_type) {
            // Check name if specified
            if (attr_name && attr_name_len > 0) {
                if (attr->name_length == attr_name_len) {
                    U16 *name = p + attr->name_offset;
                    if (MemCmp(name, attr_name, attr_name_len * 2) == 0)
                        return attr;
                }
            } else if (attr->name_length == 0) {
                return attr;
            }
        }

        p += attr->length;
    }

    return NULL;
}

CNTFSMFTRecord *NTFSParseMFTRecord(CNTFS *fs, U0 *buf, U64 record_num)
{
    CNTFSRecordHeader *hdr = buf;

    CNTFSMFTRecord *rec = MAlloc(sizeof(CNTFSMFTRecord));
    if (!rec)
        return NULL;

    MemSet(rec, 0, sizeof(CNTFSMFTRecord));
    rec->record_number = record_num;
    rec->flags = hdr->flags;
    rec->hard_links = hdr->hard_link_count;
    rec->base_record = hdr->base_record;

    // Parse standard information
    CNTFSAttrHeader *std_attr = NTFSFindAttribute(buf, NTFS_AT_STANDARD_INFO, NULL, 0);
    if (std_attr && !std_attr->non_resident) {
        CNTFSResidentAttr *res = std_attr + 1;
        CNTFSStdInfo *std_info = std_attr(U8*) + res->value_offset;

        rec->creation_time = std_info->creation_time;
        rec->modification_time = std_info->modification_time;
        rec->mft_change_time = std_info->mft_change_time;
        rec->access_time = std_info->access_time;
        rec->file_attrs = std_info->file_attrs;
    }

    // Parse filename - prefer WIN32 or WIN32_DOS name
    CNTFSAttrHeader *name_attr = buf + hdr->attrs_offset;
    U8 *best_name = NULL;
    U8 best_name_type = 255;

    U8 *p = buf + hdr->attrs_offset;
    while (p < buf(U8*) + hdr->bytes_used) {
        CNTFSAttrHeader *attr = p;
        if (attr->type == NTFS_AT_END || attr->length == 0)
            break;

        if (attr->type == NTFS_AT_FILENAME && !attr->non_resident) {
            CNTFSResidentAttr *res = attr + 1;
            CNTFSFilename *fn = attr(U8*) + res->value_offset;

            // Prefer WIN32 or WIN32_DOS names over POSIX or DOS
            if (fn->name_type == NTFS_FILENAME_WIN32 ||
                fn->name_type == NTFS_FILENAME_WIN32_DOS ||
                best_name == NULL) {
                if (best_name)
                    Free(best_name);
                best_name = NTFSUtf16ToUtf8(fn->name, fn->name_length);
                best_name_type = fn->name_type;
                rec->parent_ref = fn->parent_ref & 0x0000FFFFFFFFFFFF;  // Mask sequence number
            }
        }

        p += attr->length;
    }

    rec->name = best_name;

    // Parse data attribute
    CNTFSAttrHeader *data_attr = NTFSFindAttribute(buf, NTFS_AT_DATA, NULL, 0);
    if (data_attr) {
        if (data_attr->non_resident) {
            CNTFSNonResidentAttr *nres = data_attr + 1;
            rec->data_resident = FALSE;
            rec->data_size = nres->data_size;
            rec->alloc_size = nres->alloc_size;
            rec->data_runs = NTFSDecodeRunlist(
                data_attr(U8*) + nres->runlist_offset,
                nres->start_vcn);
        } else {
            CNTFSResidentAttr *res = data_attr + 1;
            rec->data_resident = TRUE;
            rec->data_size = res->value_length;
            rec->data_inline = MAlloc(res->value_length);
            if (rec->data_inline)
                MemCpy(rec->data_inline, data_attr(U8*) + res->value_offset, res->value_length);
        }
    }

    // Check for directory
    rec->is_directory = (hdr->flags & NTFS_FILE_RECORD_IS_DIR) != 0;

    if (rec->is_directory) {
        // Parse index allocation for directories
        CNTFSAttrHeader *index_alloc = NTFSFindAttribute(buf, NTFS_AT_INDEX_ALLOCATION, NULL, 0);
        if (index_alloc && index_alloc->non_resident) {
            CNTFSNonResidentAttr *nres = index_alloc + 1;
            rec->has_index_alloc = TRUE;
            rec->index_runs = NTFSDecodeRunlist(
                index_alloc(U8*) + nres->runlist_offset,
                nres->start_vcn);
        }
    }

    return rec;
}

U0 NTFSFreeMFTRecord(CNTFSMFTRecord *rec)
{
    if (!rec)
        return;

    if (rec->name)
        Free(rec->name);
    if (rec->data_inline)
        Free(rec->data_inline);
    if (rec->data_runs)
        NTFSFreeRunlist(rec->data_runs);
    if (rec->index_runs)
        NTFSFreeRunlist(rec->index_runs);

    Free(rec);
}

// ============================================================================
// DATA READING
// ============================================================================

I64 NTFSReadFromRuns(CNTFS *fs, CNTFSRunEntry *runs, U0 *buf, I64 size, I64 offset)
{
    if (!runs || !buf)
        return -EINVAL;

    I64 total_read = 0;
    U8 *cluster_buf = MAlloc(fs->bytes_per_cluster);
    if (!cluster_buf)
        return -ENOMEM;

    CNTFSRunEntry *run = runs;

    // Skip to starting run
    while (run) {
        I64 run_bytes = run->length * fs->bytes_per_cluster;
        if (offset < run_bytes)
            break;
        offset -= run_bytes;
        run = run->next;
    }

    while (run && size > 0) {
        I64 run_bytes = run->length * fs->bytes_per_cluster;
        I64 to_read = run_bytes - offset;
        if (to_read > size)
            to_read = size;

        if (run->lcn == 0) {
            // Sparse - return zeros
            MemSet(buf, 0, to_read);
        } else {
            // Read from disk
            U64 start_cluster = run->lcn + offset / fs->bytes_per_cluster;
            U64 cluster_offset = offset % fs->bytes_per_cluster;

            while (to_read > 0) {
                if (NTFSReadClusters(fs, start_cluster, 1, cluster_buf) < 0) {
                    Free(cluster_buf);
                    return total_read > 0 ? total_read : -EIO;
                }

                I64 copy_size = fs->bytes_per_cluster - cluster_offset;
                if (copy_size > to_read)
                    copy_size = to_read;

                MemCpy(buf, cluster_buf + cluster_offset, copy_size);

                buf += copy_size;
                to_read -= copy_size;
                total_read += copy_size;
                size -= copy_size;
                start_cluster++;
                cluster_offset = 0;
            }
        }

        offset = 0;
        run = run->next;
    }

    Free(cluster_buf);
    return total_read;
}

// ============================================================================
// DIRECTORY OPERATIONS
// ============================================================================

// Search index root for filename
I64 NTFSSearchIndexRoot(CNTFS *fs, U0 *record, U8 *name, U64 *found_mft_ref)
{
    CNTFSAttrHeader *idx_root_attr = NTFSFindAttribute(record, NTFS_AT_INDEX_ROOT, NULL, 0);
    if (!idx_root_attr || idx_root_attr->non_resident)
        return -ENOENT;

    CNTFSResidentAttr *res = idx_root_attr + 1;
    CNTFSIndexRoot *idx_root = idx_root_attr(U8*) + res->value_offset;

    // Get entries
    U8 *entries_start = idx_root(U8*) + 0x10 + idx_root->entries_offset;
    U8 *entries_end = idx_root(U8*) + 0x10 + idx_root->index_length;

    I64 name_len = StrLen(name);

    U8 *p = entries_start;
    while (p < entries_end) {
        CNTFSIndexEntry *entry = p;

        if (entry->flags & NTFS_INDEX_ENTRY_LAST)
            break;

        // Get filename from entry
        CNTFSFilename *fn = p + sizeof(CNTFSIndexEntry);
        U8 *entry_name = NTFSUtf16ToUtf8(fn->name, fn->name_length);

        if (entry_name) {
            // Case-insensitive compare (NTFS default)
            Bool match = (StrICmp(entry_name, name) == 0);
            Free(entry_name);

            if (match) {
                *found_mft_ref = entry->mft_ref & 0x0000FFFFFFFFFFFF;
                return 0;
            }
        }

        p += entry->length;
    }

    return -ENOENT;
}

// ============================================================================
// VFS OPERATIONS - MOUNT
// ============================================================================

I64 NTFSMount(CVFSMount *mnt, U8 *device, U8 *options)
{
    if (!mnt || !device)
        return -EINVAL;

    // Allocate filesystem state
    CNTFS *fs = MAlloc(sizeof(CNTFS));
    if (!fs)
        return -ENOMEM;

    MemSet(fs, 0, sizeof(CNTFS));
    fs->device_path = StrNew(device);
    fs->read_only = TRUE;

    // Open device
    fs->device_fd = PosixOpen(device, O_RDONLY, 0);
    if (fs->device_fd < 0) {
        Free(fs->device_path);
        Free(fs);
        return -ENODEV;
    }

    // Read boot sector
    CNTFSBootSector *boot = MAlloc(512);
    if (!boot) {
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -ENOMEM;
    }

    I64 result = NTFSDeviceRead(fs, 0, boot, 512);
    if (result < 0) {
        Free(boot);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return result;
    }

    // Verify NTFS signature
    if (MemCmp(boot->oem_id, NTFS_OEM_ID, 8) != 0 ||
        boot->end_marker != NTFS_BOOT_MAGIC) {
        Free(boot);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -EINVAL;
    }

    // Parse boot sector
    fs->bytes_per_sector = boot->bytes_per_sector;
    fs->sectors_per_cluster = boot->sectors_per_cluster;
    fs->bytes_per_cluster = fs->bytes_per_sector * fs->sectors_per_cluster;
    fs->total_sectors = boot->total_sectors;
    fs->total_clusters = fs->total_sectors / fs->sectors_per_cluster;
    fs->mft_lcn = boot->mft_lcn;
    fs->volume_serial = boot->volume_serial;

    // MFT record size
    if (boot->clusters_per_mft < 0) {
        fs->mft_record_size = 1 << (-boot->clusters_per_mft);
    } else {
        fs->mft_record_size = boot->clusters_per_mft * fs->bytes_per_cluster;
    }

    // Index record size
    if (boot->clusters_per_index < 0) {
        fs->index_record_size = 1 << (-boot->clusters_per_index);
    } else {
        fs->index_record_size = boot->clusters_per_index * fs->bytes_per_cluster;
    }

    Free(boot);

    // Allocate MFT record buffer
    fs->mft_record_buf = MAlloc(fs->mft_record_size);
    if (!fs->mft_record_buf) {
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -ENOMEM;
    }

    // Read volume name from $Volume
    result = NTFSReadMFTRecord(fs, NTFS_MFT_VOLUME, fs->mft_record_buf);
    if (result >= 0) {
        CNTFSAttrHeader *vol_name = NTFSFindAttribute(fs->mft_record_buf,
                                                      NTFS_AT_VOLUME_NAME, NULL, 0);
        if (vol_name && !vol_name->non_resident) {
            CNTFSResidentAttr *res = vol_name + 1;
            U16 *name = vol_name(U8*) + res->value_offset;
            I64 name_len = res->value_length / 2;
            U8 *utf8_name = NTFSUtf16ToUtf8(name, name_len);
            if (utf8_name) {
                StrCpy(fs->volume_label, utf8_name);
                Free(utf8_name);
            }
        }
    }

    // Create VFS superblock
    CVFSSuperblock *vfs_sb = MAlloc(sizeof(CVFSSuperblock));
    if (!vfs_sb) {
        Free(fs->mft_record_buf);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -ENOMEM;
    }

    MemSet(vfs_sb, 0, sizeof(CVFSSuperblock));
    vfs_sb->magic = NTFS_FILE_SIGNATURE;
    vfs_sb->fs_type = VFS_FS_NTFS;
    vfs_sb->block_size = fs->bytes_per_cluster;
    vfs_sb->block_count = fs->total_clusters;
    vfs_sb->mount = mnt;
    vfs_sb->fs_private = fs;
    vfs_sb->flags |= VFS_MNT_RDONLY;
    StrCpy(vfs_sb->label, fs->volume_label);

    fs->vfs_sb = vfs_sb;
    fs->vfs_mount = mnt;

    // Read root directory MFT record
    result = NTFSReadMFTRecord(fs, NTFS_MFT_ROOT, fs->mft_record_buf);
    if (result < 0) {
        Free(vfs_sb);
        Free(fs->mft_record_buf);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return result;
    }

    CNTFSMFTRecord *root_rec = NTFSParseMFTRecord(fs, fs->mft_record_buf, NTFS_MFT_ROOT);
    if (!root_rec) {
        Free(vfs_sb);
        Free(fs->mft_record_buf);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -EIO;
    }

    // Create VFS root inode
    CVFSInode *root = VFSInodeAlloc(vfs_sb);
    if (!root) {
        NTFSFreeMFTRecord(root_rec);
        Free(vfs_sb);
        Free(fs->mft_record_buf);
        PosixClose(fs->device_fd);
        Free(fs->device_path);
        Free(fs);
        return -ENOMEM;
    }

    root->ino = NTFS_MFT_ROOT;
    root->mode = VFS_IFDIR | 0755;
    root->nlink = root_rec->hard_links;
    root->size = root_rec->data_size;
    root->fs_private = root_rec;

    // Convert NTFS time to Unix time (100ns intervals since 1601 -> seconds since 1970)
    // Difference is 116444736000000000 (100ns intervals)
    #define NTFS_TIME_OFFSET 116444736000000000ULL
    if (root_rec->modification_time > NTFS_TIME_OFFSET)
        root->mtime = (root_rec->modification_time - NTFS_TIME_OFFSET) / 10000000;
    if (root_rec->access_time > NTFS_TIME_OFFSET)
        root->atime = (root_rec->access_time - NTFS_TIME_OFFSET) / 10000000;
    if (root_rec->creation_time > NTFS_TIME_OFFSET)
        root->ctime = (root_rec->creation_time - NTFS_TIME_OFFSET) / 10000000;

    vfs_sb->root = root;
    mnt->root = root;
    mnt->sb = vfs_sb;

    // Install operations
    static CVFSOps ntfs_ops = {
        .mount = &NTFSMount,
        .unmount = &NTFSUnmount,
        .lookup = &NTFSLookup,
        .readlink = &NTFSReadlink,
        .open = &NTFSOpen,
        .close = &NTFSClose,
        .read = &NTFSRead,
        .readdir = &NTFSReaddir,
    };

    vfs_sb->ops = &ntfs_ops;

    printf("NTFS: Mounted %s (%s)\n", device,
           fs->volume_label[0] ? fs->volume_label : "unnamed");
    printf("  Cluster size: %d, MFT record: %d, Total clusters: %lld\n",
           fs->bytes_per_cluster, fs->mft_record_size, fs->total_clusters);

    return 0;
}

I64 NTFSUnmount(CVFSMount *mnt)
{
    if (!mnt || !mnt->sb)
        return -EINVAL;

    CVFSSuperblock *vfs_sb = mnt->sb;
    CNTFS *fs = vfs_sb->fs_private;

    if (fs) {
        if (fs->mft_record_buf)
            Free(fs->mft_record_buf);
        if (fs->device_fd >= 0)
            PosixClose(fs->device_fd);
        if (fs->device_path)
            Free(fs->device_path);
        Free(fs);
    }

    if (vfs_sb->root) {
        CNTFSMFTRecord *root_rec = vfs_sb->root->fs_private;
        if (root_rec)
            NTFSFreeMFTRecord(root_rec);
        VFSInodeFree(vfs_sb->root);
    }

    Free(vfs_sb);
    return 0;
}

// ============================================================================
// VFS OPERATIONS - INODE
// ============================================================================

I64 NTFSLookup(CVFSInode *dir, U8 *name, CVFSInode **result)
{
    if (!dir || !name || !result)
        return -EINVAL;

    *result = NULL;

    if (!VFS_ISDIR(dir->mode))
        return -ENOTDIR;

    CNTFS *fs = dir->sb->fs_private;
    CNTFSMFTRecord *dir_rec = dir->fs_private;

    if (!fs || !dir_rec)
        return -EIO;

    // Read directory MFT record
    I64 err = NTFSReadMFTRecord(fs, dir->ino, fs->mft_record_buf);
    if (err < 0)
        return err;

    // Search index root
    U64 found_mft_ref;
    err = NTFSSearchIndexRoot(fs, fs->mft_record_buf, name, &found_mft_ref);
    if (err < 0)
        return err;

    // Read found MFT record
    err = NTFSReadMFTRecord(fs, found_mft_ref, fs->mft_record_buf);
    if (err < 0)
        return err;

    CNTFSMFTRecord *found_rec = NTFSParseMFTRecord(fs, fs->mft_record_buf, found_mft_ref);
    if (!found_rec)
        return -EIO;

    // Create VFS inode
    CVFSInode *inode = VFSInodeAlloc(dir->sb);
    if (!inode) {
        NTFSFreeMFTRecord(found_rec);
        return -ENOMEM;
    }

    inode->ino = found_mft_ref;
    inode->nlink = found_rec->hard_links;
    inode->size = found_rec->data_size;
    inode->fs_private = found_rec;
    inode->parent = dir;

    // Set mode based on attributes
    if (found_rec->is_directory) {
        inode->mode = VFS_IFDIR | 0755;
    } else if (found_rec->file_attrs & NTFS_FILE_ATTR_REPARSE) {
        inode->mode = VFS_IFLNK | 0777;
    } else {
        inode->mode = VFS_IFREG | 0644;
    }

    // Times
    #define NTFS_TIME_OFFSET 116444736000000000ULL
    if (found_rec->modification_time > NTFS_TIME_OFFSET)
        inode->mtime = (found_rec->modification_time - NTFS_TIME_OFFSET) / 10000000;
    if (found_rec->access_time > NTFS_TIME_OFFSET)
        inode->atime = (found_rec->access_time - NTFS_TIME_OFFSET) / 10000000;
    if (found_rec->creation_time > NTFS_TIME_OFFSET)
        inode->ctime = (found_rec->creation_time - NTFS_TIME_OFFSET) / 10000000;

    // Insert into cache
    VFSInodeInsertCache(inode);

    *result = inode;
    return 0;
}

I64 NTFSReadlink(CVFSInode *inode, U8 *buf, I64 size)
{
    // NTFS uses reparse points for symlinks
    // This is a simplified implementation
    if (!inode || !buf)
        return -EINVAL;

    if (!VFS_ISLNK(inode->mode))
        return -EINVAL;

    // TODO: Parse reparse point data
    // For now, return empty
    buf[0] = 0;
    return 0;
}

// ============================================================================
// VFS OPERATIONS - FILE
// ============================================================================

I64 NTFSOpen(CVFSFile *file)
{
    return 0;
}

I64 NTFSClose(CVFSFile *file)
{
    return 0;
}

I64 NTFSRead(CVFSFile *file, U0 *buf, I64 size, I64 offset)
{
    if (!file || !buf || !file->inode)
        return -EINVAL;

    CVFSInode *inode = file->inode;
    CNTFS *fs = inode->sb->fs_private;
    CNTFSMFTRecord *rec = inode->fs_private;

    if (!fs || !rec)
        return -EIO;

    // Adjust for EOF
    if (offset >= rec->data_size)
        return 0;

    if (offset + size > rec->data_size)
        size = rec->data_size - offset;

    // Resident data
    if (rec->data_resident && rec->data_inline) {
        MemCpy(buf, rec->data_inline + offset, size);
        return size;
    }

    // Non-resident data
    if (rec->data_runs) {
        return NTFSReadFromRuns(fs, rec->data_runs, buf, size, offset);
    }

    return -EIO;
}

I64 NTFSReaddir(CVFSFile *file, U0 *buf, I64 count)
{
    if (!file || !buf || !file->inode)
        return -EINVAL;

    CVFSInode *inode = file->inode;
    if (!VFS_ISDIR(inode->mode))
        return -ENOTDIR;

    CNTFS *fs = inode->sb->fs_private;
    CNTFSMFTRecord *rec = inode->fs_private;

    if (!fs || !rec)
        return -EIO;

    // Read MFT record
    I64 err = NTFSReadMFTRecord(fs, inode->ino, fs->mft_record_buf);
    if (err < 0)
        return err;

    // Find index root
    CNTFSAttrHeader *idx_root_attr = NTFSFindAttribute(fs->mft_record_buf,
                                                        NTFS_AT_INDEX_ROOT, NULL, 0);
    if (!idx_root_attr || idx_root_attr->non_resident)
        return -EIO;

    CNTFSResidentAttr *res = idx_root_attr + 1;
    CNTFSIndexRoot *idx_root = idx_root_attr(U8*) + res->value_offset;

    U8 *entries_start = idx_root(U8*) + 0x10 + idx_root->entries_offset;
    U8 *entries_end = idx_root(U8*) + 0x10 + idx_root->index_length;

    CVFSDirent *dirent = buf;
    I64 entries_read = 0;
    I64 position = 0;

    U8 *p = entries_start;
    while (p < entries_end && entries_read < count) {
        CNTFSIndexEntry *entry = p;

        if (entry->flags & NTFS_INDEX_ENTRY_LAST)
            break;

        // Skip entries before current position
        if (position >= file->dir_pos) {
            CNTFSFilename *fn = p + sizeof(CNTFSIndexEntry);
            U8 *name = NTFSUtf16ToUtf8(fn->name, fn->name_length);

            if (name) {
                dirent->ino = entry->mft_ref & 0x0000FFFFFFFFFFFF;
                dirent->off = position + 1;
                dirent->reclen = sizeof(CVFSDirent);

                // Determine type
                if (fn->file_attrs & NTFS_FILE_ATTR_DIRECTORY)
                    dirent->type = DT_DIR;
                else if (fn->file_attrs & NTFS_FILE_ATTR_REPARSE)
                    dirent->type = DT_LNK;
                else
                    dirent->type = DT_REG;

                I64 name_len = StrLen(name);
                if (name_len > VFS_MAX_NAME)
                    name_len = VFS_MAX_NAME;
                MemCpy(dirent->name, name, name_len);
                dirent->name[name_len] = 0;

                Free(name);
                dirent++;
                entries_read++;
            }
        }

        position++;
        p += entry->length;
    }

    file->dir_pos = position;
    return entries_read;
}

// ============================================================================
// REGISTRATION
// ============================================================================

static CVFSFilesystem ntfs_filesystem = {
    .name = "ntfs",
    .type = VFS_FS_NTFS,
    .flags = 0,
    .ops = NULL,
    .probe = NULL,
    .next = NULL
};

U0 NTFSRegister()
{
    VFSRegisterFilesystem(&ntfs_filesystem);
    "NTFS filesystem driver registered (read-only).\n";
}

// Auto-register
NTFSRegister();
