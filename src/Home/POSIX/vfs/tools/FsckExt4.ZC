// FsckExt4.ZC - Check and Repair Ext2/3/4 Filesystems for ZealOS
// Part of the POSIX compatibility layer
//
// This utility checks ext2, ext3, or ext4 filesystems for errors
// and optionally repairs them.
// Based on public ext2/3/4 specifications.

#include "FSTools.HH"

// ============================================================================
// FSCK CONTEXT
// ============================================================================

class CFsckExt4Context : CFsckContext {
    CExt2Superblock sb;
    U8              *gd_buf;        // Group descriptors
    I64             gd_size;        // Size of each group descriptor
    I64             num_groups;
    U32             block_size;

    // Bitmaps
    U8              **block_bitmaps;
    U8              **inode_bitmaps;

    // Calculated bitmaps (what should be)
    U8              **calc_block_bitmaps;
    U8              **calc_inode_bitmaps;

    // Inode reference counts
    U16             *inode_links;   // Calculated link counts
    Bool            *inode_used;    // Inodes we've seen
};

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

static U64 FsckGetBlockBitmap(CFsckExt4Context *ctx, I64 group)
{
    if (ctx->gd_size >= 64) {
        CExt4GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_block_bitmap | (gd->bg_block_bitmap_hi(U64) << 32);
    } else {
        CExt2GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_block_bitmap;
    }
}

static U64 FsckGetInodeBitmap(CFsckExt4Context *ctx, I64 group)
{
    if (ctx->gd_size >= 64) {
        CExt4GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_inode_bitmap | (gd->bg_inode_bitmap_hi(U64) << 32);
    } else {
        CExt2GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_inode_bitmap;
    }
}

static U64 FsckGetInodeTable(CFsckExt4Context *ctx, I64 group)
{
    if (ctx->gd_size >= 64) {
        CExt4GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_inode_table | (gd->bg_inode_table_hi(U64) << 32);
    } else {
        CExt2GroupDesc *gd = ctx->gd_buf + group * ctx->gd_size;
        return gd->bg_inode_table;
    }
}

static Bool FsckIsBlockUsed(CFsckExt4Context *ctx, U64 block)
{
    if (block == 0) return TRUE;  // Block 0 is never valid

    U32 blocks_per_group = ctx->sb.s_blocks_per_group;
    I64 group = (block - ctx->sb.s_first_data_block) / blocks_per_group;
    I64 offset = (block - ctx->sb.s_first_data_block) % blocks_per_group;

    if (group >= ctx->num_groups) return TRUE;  // Out of range

    return (ctx->block_bitmaps[group][offset / 8] >> (offset % 8)) & 1;
}

static U0 FsckMarkBlockUsed(CFsckExt4Context *ctx, U64 block, Bool calc_only)
{
    if (block == 0) return;

    U32 blocks_per_group = ctx->sb.s_blocks_per_group;
    I64 group = (block - ctx->sb.s_first_data_block) / blocks_per_group;
    I64 offset = (block - ctx->sb.s_first_data_block) % blocks_per_group;

    if (group >= ctx->num_groups) return;

    if (calc_only) {
        ctx->calc_block_bitmaps[group][offset / 8] |= (1 << (offset % 8));
    } else {
        ctx->block_bitmaps[group][offset / 8] |= (1 << (offset % 8));
    }
}

// ============================================================================
// INODE CHECKING
// ============================================================================

static I64 FsckReadInode(CFsckExt4Context *ctx, U64 inode_num, CExt2Inode *inode)
{
    if (inode_num == 0 || inode_num > ctx->sb.s_inodes_count)
        return -EINVAL;

    I64 inodes_per_group = ctx->sb.s_inodes_per_group;
    I64 group = (inode_num - 1) / inodes_per_group;
    I64 offset = (inode_num - 1) % inodes_per_group;

    U64 inode_table = FsckGetInodeTable(ctx, group);
    U64 inode_offset = inode_table * ctx->block_size + offset * ctx->sb.s_inode_size;

    if (DeviceRead(ctx->device_fd, inode_offset, inode, sizeof(CExt2Inode)) < 0)
        return -EIO;

    return 0;
}

static I64 FsckCheckIndirectBlock(CFsckExt4Context *ctx, U64 block, I64 level, I64 *block_count)
{
    if (block == 0)
        return 0;

    // Mark this indirect block as used
    FsckMarkBlockUsed(ctx, block, TRUE);
    (*block_count)++;

    // Check if it's actually allocated
    if (!FsckIsBlockUsed(ctx, block)) {
        ctx->errors_found++;
        if (ctx->flags & FSCK_VERBOSE) {
            "  ERROR: Indirect block %lld not marked in bitmap\n", block;
        }
    }

    if (level == 0) {
        // Direct data block
        return 0;
    }

    // Read indirect block
    U32 *indirect = MAlloc(ctx->block_size);
    if (DeviceRead(ctx->device_fd, block * ctx->block_size, indirect, ctx->block_size) < 0) {
        Free(indirect);
        return -EIO;
    }

    I64 entries = ctx->block_size / sizeof(U32);
    I64 i;
    for (i = 0; i < entries; i++) {
        if (indirect[i] != 0) {
            FsckCheckIndirectBlock(ctx, indirect[i], level - 1, block_count);
        }
    }

    Free(indirect);
    return 0;
}

static I64 FsckCheckExtentTree(CFsckExt4Context *ctx, CExt2Inode *inode, I64 *block_count)
{
    CExt4ExtentHeader *eh = &inode->i_block[0];

    // Validate header
    if (eh->eh_magic != EXT4_EXT_MAGIC) {
        ctx->errors_found++;
        if (ctx->flags & FSCK_VERBOSE) {
            "  ERROR: Invalid extent magic 0x%04x\n", eh->eh_magic;
        }
        return -EINVAL;
    }

    if (eh->eh_depth == 0) {
        // Leaf node - contains extents
        CExt4Extent *ext = eh + 1;
        I64 i;
        for (i = 0; i < eh->eh_entries; i++) {
            U64 start = ext[i].ee_start_lo | (ext[i].ee_start_hi(U64) << 32);
            U64 len = ext[i].ee_len;

            // Mark blocks as used
            U64 j;
            for (j = 0; j < len; j++) {
                FsckMarkBlockUsed(ctx, start + j, TRUE);
                (*block_count)++;

                if (!FsckIsBlockUsed(ctx, start + j)) {
                    ctx->errors_found++;
                    if (ctx->flags & FSCK_VERBOSE) {
                        "  ERROR: Data block %lld not marked in bitmap\n", start + j;
                    }
                }
            }
        }
    } else {
        // Internal node - contains index entries
        // Would need to read child blocks recursively
        // Simplified: just count as valid for now
        CExt4ExtentIdx *idx = eh + 1;
        I64 i;
        for (i = 0; i < eh->eh_entries; i++) {
            U64 child_block = idx[i].ei_leaf_lo | (idx[i].ei_leaf_hi(U64) << 32);
            FsckMarkBlockUsed(ctx, child_block, TRUE);
            (*block_count)++;
        }
    }

    return 0;
}

static I64 FsckCheckInode(CFsckExt4Context *ctx, U64 inode_num, CExt2Inode *inode)
{
    if (inode->i_mode == 0 && inode->i_links_count == 0)
        return 0;  // Unused inode

    ctx->inode_used[inode_num] = TRUE;

    // Check mode
    U16 mode_type = inode->i_mode & 0xF000;
    Bool is_valid_type = (mode_type == EXT2_S_IFREG || mode_type == EXT2_S_IFDIR ||
                          mode_type == EXT2_S_IFLNK || mode_type == EXT2_S_IFBLK ||
                          mode_type == EXT2_S_IFCHR || mode_type == EXT2_S_IFIFO ||
                          mode_type == EXT2_S_IFSOCK);

    if (!is_valid_type && inode->i_mode != 0) {
        ctx->errors_found++;
        if (ctx->flags & FSCK_VERBOSE) {
            "  ERROR: Inode %lld has invalid mode 0x%04x\n", inode_num, inode->i_mode;
        }
    }

    // Count blocks
    I64 block_count = 0;

    // Check if using extents
    if (inode->i_flags & EXT4_EXTENTS_FL) {
        FsckCheckExtentTree(ctx, inode, &block_count);
    } else {
        // Traditional indirect blocks
        I64 i;

        // Direct blocks
        for (i = 0; i < 12; i++) {
            if (inode->i_block[i] != 0) {
                FsckMarkBlockUsed(ctx, inode->i_block[i], TRUE);
                block_count++;

                if (!FsckIsBlockUsed(ctx, inode->i_block[i])) {
                    ctx->errors_found++;
                    if (ctx->flags & FSCK_VERBOSE) {
                        "  ERROR: Direct block %d not marked in bitmap\n", inode->i_block[i];
                    }
                }
            }
        }

        // Indirect blocks
        FsckCheckIndirectBlock(ctx, inode->i_block[12], 1, &block_count);
        FsckCheckIndirectBlock(ctx, inode->i_block[13], 2, &block_count);
        FsckCheckIndirectBlock(ctx, inode->i_block[14], 3, &block_count);
    }

    // Verify block count matches
    I64 expected_blocks = (block_count * ctx->block_size) / 512;
    if (inode->i_blocks != expected_blocks && mode_type == EXT2_S_IFREG) {
        if (ctx->flags & FSCK_VERBOSE) {
            "  WARNING: Inode %lld block count mismatch (stored=%d, calc=%d)\n",
                inode_num, inode->i_blocks, expected_blocks;
        }
    }

    return 0;
}

// ============================================================================
// DIRECTORY CHECKING
// ============================================================================

static I64 FsckCheckDirectory(CFsckExt4Context *ctx, U64 inode_num, U64 parent_inode)
{
    CExt2Inode inode;
    if (FsckReadInode(ctx, inode_num, &inode) < 0)
        return -EIO;

    if ((inode.i_mode & 0xF000) != EXT2_S_IFDIR)
        return -ENOTDIR;

    ctx->dirs_checked++;

    // Read directory data
    if (inode.i_block[0] == 0)
        return 0;

    U8 *dir_data = MAlloc(ctx->block_size);
    if (DeviceRead(ctx->device_fd, inode.i_block[0] * ctx->block_size, dir_data, ctx->block_size) < 0) {
        Free(dir_data);
        return -EIO;
    }

    Bool found_dot = FALSE;
    Bool found_dotdot = FALSE;

    U64 offset = 0;
    while (offset < ctx->block_size) {
        CExt2DirEntry2 *de = dir_data + offset;

        if (de->rec_len == 0)
            break;

        if (de->inode != 0) {
            // Check "."
            if (de->name_len == 1 && de->name[0] == '.') {
                found_dot = TRUE;
                if (de->inode != inode_num) {
                    ctx->errors_found++;
                    if (ctx->flags & FSCK_VERBOSE) {
                        "  ERROR: '.' entry in dir %lld points to %d\n", inode_num, de->inode;
                    }
                }
            }
            // Check ".."
            else if (de->name_len == 2 && de->name[0] == '.' && de->name[1] == '.') {
                found_dotdot = TRUE;
                if (de->inode != parent_inode && inode_num != EXT2_ROOT_INO) {
                    ctx->errors_found++;
                    if (ctx->flags & FSCK_VERBOSE) {
                        "  ERROR: '..' entry in dir %lld points to %d (expected %lld)\n",
                            inode_num, de->inode, parent_inode;
                    }
                }
            }
            else {
                // Regular entry - count link
                if (de->inode < ctx->sb.s_inodes_count) {
                    ctx->inode_links[de->inode]++;
                    ctx->files_checked++;

                    // Recursively check subdirectories
                    if (de->file_type == EXT2_FT_DIR) {
                        FsckCheckDirectory(ctx, de->inode, inode_num);
                    }
                }
            }
        }

        offset += de->rec_len;
    }

    Free(dir_data);

    if (!found_dot) {
        ctx->errors_found++;
        if (ctx->flags & FSCK_VERBOSE) {
            "  ERROR: Missing '.' entry in directory %lld\n", inode_num;
        }
    }

    if (!found_dotdot) {
        ctx->errors_found++;
        if (ctx->flags & FSCK_VERBOSE) {
            "  ERROR: Missing '..' entry in directory %lld\n", inode_num;
        }
    }

    return 0;
}

// ============================================================================
// MAIN FSCK FUNCTION
// ============================================================================

I64 FsckExt4(U8 *device, U32 flags)
{
    CFsckExt4Context ctx;
    MemSet(&ctx, 0, sizeof(CFsckExt4Context));

    ctx.device_path = device;
    ctx.flags = flags;

    "Checking %s...\n", device;

    // Open device
    I64 open_flags = (flags & FSCK_READONLY) ? O_RDONLY : O_RDWR;
    ctx.device_fd = PosixOpen(device, open_flags, 0);
    if (ctx.device_fd < 0) {
        "fsck.ext4: Cannot open %s\n", device;
        return FSCK_OPERATIONAL;
    }

    // Read superblock
    if (DeviceRead(ctx.device_fd, 1024, &ctx.sb, sizeof(CExt2Superblock)) < 0) {
        "fsck.ext4: Cannot read superblock\n";
        PosixClose(ctx.device_fd);
        return FSCK_OPERATIONAL;
    }

    // Verify magic
    if (ctx.sb.s_magic != EXT2_SUPER_MAGIC) {
        "fsck.ext4: Bad magic number 0x%04x (expected 0x%04x)\n",
            ctx.sb.s_magic, EXT2_SUPER_MAGIC;
        PosixClose(ctx.device_fd);
        return FSCK_OPERATIONAL;
    }

    // Calculate parameters
    ctx.block_size = 1024 << ctx.sb.s_log_block_size;
    ctx.num_groups = (ctx.sb.s_blocks_count + ctx.sb.s_blocks_per_group - 1) /
                     ctx.sb.s_blocks_per_group;

    if (ctx.sb.s_feature_incompat & EXT4_FEATURE_INCOMPAT_64BIT) {
        ctx.gd_size = 64;
    } else {
        ctx.gd_size = 32;
    }

    "Filesystem: ext%s\n",
        (ctx.sb.s_feature_incompat & EXT4_FEATURE_INCOMPAT_EXTENTS) ? "4" :
        (ctx.sb.s_feature_compat & EXT3_FEATURE_COMPAT_HAS_JOURNAL) ? "3" : "2";
    "Block size: %d\n", ctx.block_size;
    "Block groups: %d\n", ctx.num_groups;
    "Inodes: %d\n", ctx.sb.s_inodes_count;
    "Blocks: %lld\n", ctx.sb.s_blocks_count;

    // Check if clean
    if (!(flags & FSCK_FORCE) && ctx.sb.s_state == EXT2_VALID_FS) {
        "Filesystem is clean.\n";
        if (!(flags & FSCK_VERBOSE)) {
            PosixClose(ctx.device_fd);
            return FSCK_OK;
        }
        "Continuing check due to verbose mode...\n";
    }

    // Read group descriptors
    I64 gdt_size = ctx.num_groups * ctx.gd_size;
    ctx.gd_buf = MAlloc(gdt_size);

    U64 gdt_block = (ctx.block_size == 1024) ? 2 : 1;
    if (DeviceRead(ctx.device_fd, gdt_block * ctx.block_size, ctx.gd_buf, gdt_size) < 0) {
        "fsck.ext4: Cannot read group descriptors\n";
        Free(ctx.gd_buf);
        PosixClose(ctx.device_fd);
        return FSCK_OPERATIONAL;
    }

    // Allocate bitmaps
    ctx.block_bitmaps = MAlloc(ctx.num_groups * sizeof(U8*));
    ctx.inode_bitmaps = MAlloc(ctx.num_groups * sizeof(U8*));
    ctx.calc_block_bitmaps = MAlloc(ctx.num_groups * sizeof(U8*));
    ctx.calc_inode_bitmaps = MAlloc(ctx.num_groups * sizeof(U8*));

    I64 bitmap_size = ctx.block_size;
    I64 i;
    for (i = 0; i < ctx.num_groups; i++) {
        ctx.block_bitmaps[i] = MAlloc(bitmap_size);
        ctx.inode_bitmaps[i] = MAlloc(bitmap_size);
        ctx.calc_block_bitmaps[i] = MAlloc(bitmap_size);
        ctx.calc_inode_bitmaps[i] = MAlloc(bitmap_size);

        MemSet(ctx.calc_block_bitmaps[i], 0, bitmap_size);
        MemSet(ctx.calc_inode_bitmaps[i], 0, bitmap_size);

        // Read actual bitmaps
        U64 bb = FsckGetBlockBitmap(&ctx, i);
        U64 ib = FsckGetInodeBitmap(&ctx, i);

        DeviceRead(ctx.device_fd, bb * ctx.block_size, ctx.block_bitmaps[i], bitmap_size);
        DeviceRead(ctx.device_fd, ib * ctx.block_size, ctx.inode_bitmaps[i], bitmap_size);
    }

    // Allocate inode tracking
    ctx.inode_links = MAlloc(ctx.sb.s_inodes_count * sizeof(U16));
    ctx.inode_used = MAlloc(ctx.sb.s_inodes_count * sizeof(Bool));
    MemSet(ctx.inode_links, 0, ctx.sb.s_inodes_count * sizeof(U16));
    MemSet(ctx.inode_used, 0, ctx.sb.s_inodes_count * sizeof(Bool));

    // Pass 1: Check all inodes
    "Pass 1: Checking inodes...\n";

    U64 inode_num;
    CExt2Inode inode;
    for (inode_num = 1; inode_num <= ctx.sb.s_inodes_count; inode_num++) {
        if (FsckReadInode(&ctx, inode_num, &inode) == 0) {
            FsckCheckInode(&ctx, inode_num, &inode);
        }

        if ((inode_num % 10000) == 0) {
            "  %lld/%d inodes checked\r", inode_num, ctx.sb.s_inodes_count;
        }
    }
    "  %d inodes checked\n", ctx.sb.s_inodes_count;

    // Pass 2: Check directory structure
    "Pass 2: Checking directory structure...\n";

    FsckCheckDirectory(&ctx, EXT2_ROOT_INO, EXT2_ROOT_INO);

    "  %lld directories, %lld files checked\n", ctx.dirs_checked, ctx.files_checked;

    // Pass 3: Check link counts
    "Pass 3: Checking reference counts...\n";

    for (inode_num = 1; inode_num <= ctx.sb.s_inodes_count; inode_num++) {
        if (!ctx.inode_used[inode_num])
            continue;

        if (FsckReadInode(&ctx, inode_num, &inode) < 0)
            continue;

        if (inode.i_links_count != ctx.inode_links[inode_num]) {
            ctx.errors_found++;
            if (ctx.flags & FSCK_VERBOSE) {
                "  ERROR: Inode %lld link count mismatch (stored=%d, actual=%d)\n",
                    inode_num, inode.i_links_count, ctx.inode_links[inode_num];
            }
        }
    }

    // Pass 4: Check block bitmap
    "Pass 4: Checking block bitmaps...\n";

    I64 bitmap_errors = 0;
    for (i = 0; i < ctx.num_groups; i++) {
        I64 j;
        for (j = 0; j < bitmap_size; j++) {
            if (ctx.block_bitmaps[i][j] != ctx.calc_block_bitmaps[i][j]) {
                bitmap_errors++;
                if (ctx.flags & FSCK_VERBOSE && bitmap_errors <= 10) {
                    "  Block bitmap mismatch in group %d\n", i;
                }
            }
        }
    }

    if (bitmap_errors > 0) {
        ctx.errors_found += bitmap_errors;
        "  %lld block bitmap differences found\n", bitmap_errors;
    }

    // Summary
    "\n";
    if (ctx.errors_found == 0) {
        "%s: clean\n", device;
        "\n";
        "  %d inodes used (%d%%)\n",
            ctx.sb.s_inodes_count - ctx.sb.s_free_inodes_count,
            ((ctx.sb.s_inodes_count - ctx.sb.s_free_inodes_count) * 100) / ctx.sb.s_inodes_count;
        "  %lld blocks used (%d%%)\n",
            ctx.sb.s_blocks_count - ctx.sb.s_free_blocks_count,
            ((ctx.sb.s_blocks_count - ctx.sb.s_free_blocks_count) * 100) / ctx.sb.s_blocks_count;
    } else {
        "%s: %lld errors found\n", device, ctx.errors_found;

        if (ctx.errors_fixed > 0) {
            "  %lld errors corrected\n", ctx.errors_fixed;
        }

        if (ctx.errors_found > ctx.errors_fixed) {
            "  %lld errors remaining\n", ctx.errors_found - ctx.errors_fixed;
        }
    }

    // Clean up
    for (i = 0; i < ctx.num_groups; i++) {
        Free(ctx.block_bitmaps[i]);
        Free(ctx.inode_bitmaps[i]);
        Free(ctx.calc_block_bitmaps[i]);
        Free(ctx.calc_inode_bitmaps[i]);
    }
    Free(ctx.block_bitmaps);
    Free(ctx.inode_bitmaps);
    Free(ctx.calc_block_bitmaps);
    Free(ctx.calc_inode_bitmaps);
    Free(ctx.inode_links);
    Free(ctx.inode_used);
    Free(ctx.gd_buf);
    PosixClose(ctx.device_fd);

    if (ctx.errors_found == 0)
        return FSCK_OK;
    else if (ctx.errors_fixed == ctx.errors_found)
        return FSCK_CORRECTED;
    else
        return FSCK_ERRORS;
}

// ============================================================================
// COMMAND LINE INTERFACE
// ============================================================================

U0 FsckExt4Help()
{
    "Usage: FsckExt4(device, flags)\n";
    "\n";
    "Check an ext2/3/4 filesystem for errors.\n";
    "\n";
    "Flags:\n";
    "  FSCK_READONLY     - Don't modify filesystem\n";
    "  FSCK_VERBOSE      - Verbose output\n";
    "  FSCK_FORCE        - Force check even if clean\n";
    "  FSCK_AUTO_REPAIR  - Automatically repair errors\n";
    "\n";
    "Return values:\n";
    "  FSCK_OK           (0)  - No errors\n";
    "  FSCK_CORRECTED    (1)  - Errors corrected\n";
    "  FSCK_ERRORS       (4)  - Uncorrected errors\n";
    "  FSCK_OPERATIONAL  (8)  - Operational error\n";
    "\n";
    "Examples:\n";
    "  FsckExt4(\"/dev/sda1\", FSCK_READONLY | FSCK_VERBOSE);\n";
    "  FsckExt4(\"/dev/sda1\", FSCK_FORCE);\n";
}
