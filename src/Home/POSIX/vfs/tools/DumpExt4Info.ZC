// DumpExt4Info.ZC - Dump Ext2/3/4 Filesystem Information for ZealOS
// Part of the POSIX compatibility layer
//
// Similar to Linux's dumpe2fs utility.
// Displays superblock and group descriptor information.

#include "FSTools.HH"

// ============================================================================
// UUID FORMATTING
// ============================================================================

static U8 *FormatUUIDStr(U8 *uuid)
{
    U8 *str = MAlloc(37);
    snprintf(str, 37, "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
             uuid[0], uuid[1], uuid[2], uuid[3],
             uuid[4], uuid[5],
             uuid[6], uuid[7],
             uuid[8], uuid[9],
             uuid[10], uuid[11], uuid[12], uuid[13], uuid[14], uuid[15]);
    return str;
}

// ============================================================================
// TIME FORMATTING
// ============================================================================

static U8 *FormatTime(U32 timestamp)
{
    if (timestamp == 0)
        return StrNew("n/a");

    // Simplified - just return timestamp value
    // Real implementation would convert to readable date
    U8 *str = MAlloc(32);
    snprintf(str, 32, "%d (unix time)", timestamp);
    return str;
}

// ============================================================================
// FEATURE FLAG NAMES
// ============================================================================

static U0 PrintCompatFeatures(U32 features)
{
    if (features == 0) {
        "(none)";
        return;
    }

    if (features & EXT2_FEATURE_COMPAT_DIR_PREALLOC)
        "dir_prealloc ";
    if (features & EXT2_FEATURE_COMPAT_IMAGIC_INODES)
        "imagic_inodes ";
    if (features & EXT3_FEATURE_COMPAT_HAS_JOURNAL)
        "has_journal ";
    if (features & EXT2_FEATURE_COMPAT_EXT_ATTR)
        "ext_attr ";
    if (features & EXT2_FEATURE_COMPAT_RESIZE_INO)
        "resize_inode ";
    if (features & EXT2_FEATURE_COMPAT_DIR_INDEX)
        "dir_index ";
}

static U0 PrintIncompatFeatures(U32 features)
{
    if (features == 0) {
        "(none)";
        return;
    }

    if (features & EXT2_FEATURE_INCOMPAT_COMPRESSION)
        "compression ";
    if (features & EXT2_FEATURE_INCOMPAT_FILETYPE)
        "filetype ";
    if (features & EXT3_FEATURE_INCOMPAT_RECOVER)
        "needs_recovery ";
    if (features & EXT3_FEATURE_INCOMPAT_JOURNAL_DEV)
        "journal_dev ";
    if (features & EXT2_FEATURE_INCOMPAT_META_BG)
        "meta_bg ";
    if (features & EXT4_FEATURE_INCOMPAT_EXTENTS)
        "extents ";
    if (features & EXT4_FEATURE_INCOMPAT_64BIT)
        "64bit ";
    if (features & EXT4_FEATURE_INCOMPAT_FLEX_BG)
        "flex_bg ";
}

static U0 PrintROCompatFeatures(U32 features)
{
    if (features == 0) {
        "(none)";
        return;
    }

    if (features & EXT2_FEATURE_RO_COMPAT_SPARSE_SUPER)
        "sparse_super ";
    if (features & EXT2_FEATURE_RO_COMPAT_LARGE_FILE)
        "large_file ";
    if (features & EXT2_FEATURE_RO_COMPAT_BTREE_DIR)
        "btree_dir ";
    if (features & EXT4_FEATURE_RO_COMPAT_HUGE_FILE)
        "huge_file ";
    if (features & EXT4_FEATURE_RO_COMPAT_GDT_CSUM)
        "gdt_csum ";
    if (features & EXT4_FEATURE_RO_COMPAT_DIR_NLINK)
        "dir_nlink ";
    if (features & EXT4_FEATURE_RO_COMPAT_EXTRA_ISIZE)
        "extra_isize ";
}

// ============================================================================
// FILESYSTEM STATE
// ============================================================================

static U8 *GetFsState(U16 state)
{
    if (state == EXT2_VALID_FS)
        return "clean";
    else if (state == EXT2_ERROR_FS)
        return "errors";
    else
        return "unknown";
}

static U8 *GetErrorBehavior(U16 errors)
{
    switch (errors) {
        case 1: return "Continue";
        case 2: return "Remount read-only";
        case 3: return "Panic";
        default: return "Unknown";
    }
}

static U8 *GetCreatorOS(U32 os)
{
    switch (os) {
        case 0: return "Linux";
        case 1: return "Hurd";
        case 2: return "Masix";
        case 3: return "FreeBSD";
        case 4: return "Lites";
        default: return "Unknown";
    }
}

// ============================================================================
// MAIN DUMP FUNCTION
// ============================================================================

I64 DumpExt4Info(U8 *device)
{
    "dumpe2fs: Reading %s\n\n", device;

    // Open device
    I64 fd = PosixOpen(device, O_RDONLY, 0);
    if (fd < 0) {
        "dumpe2fs: Cannot open %s\n", device;
        return -EACCES;
    }

    // Read superblock
    CExt2Superblock sb;
    if (DeviceRead(fd, 1024, &sb, sizeof(CExt2Superblock)) < 0) {
        "dumpe2fs: Cannot read superblock\n";
        PosixClose(fd);
        return -EIO;
    }

    // Verify magic
    if (sb.s_magic != EXT2_SUPER_MAGIC) {
        "dumpe2fs: Bad magic number 0x%04x (expected 0xEF53)\n", sb.s_magic;
        PosixClose(fd);
        return -EINVAL;
    }

    // Calculate values
    U32 block_size = 1024 << sb.s_log_block_size;
    U64 blocks_count = sb.s_blocks_count;
    if (sb.s_feature_incompat & EXT4_FEATURE_INCOMPAT_64BIT) {
        blocks_count |= (sb.s_blocks_count_hi(U64) << 32);
    }

    I64 num_groups = (blocks_count + sb.s_blocks_per_group - 1) / sb.s_blocks_per_group;

    // Determine filesystem type
    U8 *fs_type = "ext2";
    if (sb.s_feature_incompat & EXT4_FEATURE_INCOMPAT_EXTENTS)
        fs_type = "ext4";
    else if (sb.s_feature_compat & EXT3_FEATURE_COMPAT_HAS_JOURNAL)
        fs_type = "ext3";

    // Print superblock information
    "Filesystem volume name:   ";
    if (sb.s_volume_name[0])
        "%s\n", sb.s_volume_name;
    else
        "<none>\n";

    U8 *uuid_str = FormatUUIDStr(sb.s_uuid);
    "Filesystem UUID:          %s\n", uuid_str;
    Free(uuid_str);

    "Filesystem magic number:  0x%04X\n", sb.s_magic;
    "Filesystem revision #:    %d", sb.s_rev_level;
    if (sb.s_rev_level == EXT2_DYNAMIC_REV)
        " (dynamic)\n";
    else
        " (original)\n";

    "Filesystem features:      ";
    PrintCompatFeatures(sb.s_feature_compat);
    "\n";

    "Filesystem incompatible:  ";
    PrintIncompatFeatures(sb.s_feature_incompat);
    "\n";

    "Filesystem ro-compatible: ";
    PrintROCompatFeatures(sb.s_feature_ro_compat);
    "\n";

    "Filesystem state:         %s\n", GetFsState(sb.s_state);
    "Errors behavior:          %s\n", GetErrorBehavior(sb.s_errors);
    "Filesystem OS type:       %s\n", GetCreatorOS(sb.s_creator_os);

    "\n";
    "Inode count:              %d\n", sb.s_inodes_count;
    "Block count:              %lld\n", blocks_count;
    "Reserved block count:     %d\n", sb.s_r_blocks_count;
    "Free blocks:              %d\n", sb.s_free_blocks_count;
    "Free inodes:              %d\n", sb.s_free_inodes_count;
    "First block:              %d\n", sb.s_first_data_block;
    "Block size:               %d\n", block_size;
    "Fragment size:            %d\n", 1024 << sb.s_log_frag_size;
    "Blocks per group:         %d\n", sb.s_blocks_per_group;
    "Fragments per group:      %d\n", sb.s_frags_per_group;
    "Inodes per group:         %d\n", sb.s_inodes_per_group;

    "\n";
    "Inode size:               %d\n", sb.s_inode_size;
    "First inode:              %d\n", sb.s_first_ino;
    "Required extra isize:     %d\n", sb.s_min_extra_isize;
    "Desired extra isize:      %d\n", sb.s_want_extra_isize;

    "\n";
    U8 *mtime = FormatTime(sb.s_mtime);
    U8 *wtime = FormatTime(sb.s_wtime);
    U8 *lastcheck = FormatTime(sb.s_lastcheck);
    "Last mount time:          %s\n", mtime;
    "Last write time:          %s\n", wtime;
    "Mount count:              %d\n", sb.s_mnt_count;
    "Maximum mount count:      %d\n", sb.s_max_mnt_count;
    "Last checked:             %s\n", lastcheck;
    "Check interval:           %d seconds\n", sb.s_checkinterval;
    Free(mtime);
    Free(wtime);
    Free(lastcheck);

    "\n";
    "Reserved GDT blocks:      %d\n", sb.s_reserved_gdt_blocks;
    "Journal inode:            %d\n", sb.s_journal_inum;
    "Default directory hash:   %d\n", sb.s_def_hash_version;

    "\n";
    "Block groups:             %d\n", num_groups;

    // Read and print group descriptors
    "\n";
    "Group descriptor size:    ";
    I64 gd_size;
    if (sb.s_feature_incompat & EXT4_FEATURE_INCOMPAT_64BIT) {
        gd_size = 64;
        "64 bytes\n";
    } else {
        gd_size = 32;
        "32 bytes\n";
    }

    // Read group descriptors
    I64 gdt_size = num_groups * gd_size;
    U8 *gd_buf = MAlloc(gdt_size);

    U64 gdt_block = (block_size == 1024) ? 2 : 1;
    if (DeviceRead(fd, gdt_block * block_size, gd_buf, gdt_size) < 0) {
        "dumpe2fs: Cannot read group descriptors\n";
        Free(gd_buf);
        PosixClose(fd);
        return -EIO;
    }

    // Print group information
    "\n";
    I64 group;
    for (group = 0; group < num_groups && group < 10; group++) {
        "Group %d:", group;

        U64 bb, ib, it;
        U32 free_blocks, free_inodes, used_dirs;

        if (gd_size >= 64) {
            CExt4GroupDesc *gd = gd_buf + group * gd_size;
            bb = gd->bg_block_bitmap | (gd->bg_block_bitmap_hi(U64) << 32);
            ib = gd->bg_inode_bitmap | (gd->bg_inode_bitmap_hi(U64) << 32);
            it = gd->bg_inode_table | (gd->bg_inode_table_hi(U64) << 32);
            free_blocks = gd->bg_free_blocks_count | (gd->bg_free_blocks_count_hi << 16);
            free_inodes = gd->bg_free_inodes_count | (gd->bg_free_inodes_count_hi << 16);
            used_dirs = gd->bg_used_dirs_count | (gd->bg_used_dirs_count_hi << 16);
        } else {
            CExt2GroupDesc *gd = gd_buf + group * gd_size;
            bb = gd->bg_block_bitmap;
            ib = gd->bg_inode_bitmap;
            it = gd->bg_inode_table;
            free_blocks = gd->bg_free_blocks_count;
            free_inodes = gd->bg_free_inodes_count;
            used_dirs = gd->bg_used_dirs_count;
        }

        " (Blocks %lld-%lld)\n",
            sb.s_first_data_block + group * sb.s_blocks_per_group,
            sb.s_first_data_block + (group + 1) * sb.s_blocks_per_group - 1;

        "  Block bitmap at %lld\n", bb;
        "  Inode bitmap at %lld\n", ib;
        "  Inode table at %lld\n", it;
        "  %d free blocks, %d free inodes, %d used directories\n",
            free_blocks, free_inodes, used_dirs;
    }

    if (num_groups > 10) {
        "... (%d more groups)\n", num_groups - 10;
    }

    Free(gd_buf);
    PosixClose(fd);

    return 0;
}

// ============================================================================
// COMMAND LINE INTERFACE
// ============================================================================

U0 DumpExt4InfoHelp()
{
    "Usage: DumpExt4Info(device)\n";
    "\n";
    "Display ext2/3/4 filesystem superblock and group descriptor information.\n";
    "Similar to Linux's dumpe2fs utility.\n";
    "\n";
    "Examples:\n";
    "  DumpExt4Info(\"/dev/sda1\");\n";
}
