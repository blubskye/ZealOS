// List guild members
CJSONValue *DiscordListGuildMembers(CDiscordClient *client, CDiscordSnowflake guild_id,
                                    I64 limit, CDiscordSnowflake after)
{
	U8 endpoint[128];
	CHTTPResponse *resp;

	if (limit > 0 && after > 0) {
		StrPrint(endpoint, "/guilds/%llu/members?limit=%d&after=%llu", guild_id, limit, after);
	} else if (limit > 0) {
		StrPrint(endpoint, "/guilds/%llu/members?limit=%d", guild_id, limit);
	} else if (after > 0) {
		StrPrint(endpoint, "/guilds/%llu/members?after=%llu", guild_id, after);
	} else {
		StrPrint(endpoint, "/guilds/%llu/members", guild_id);
	}

	resp = DiscordAPIRequest(client, HTTP_METHOD_GET, endpoint, NULL);
	if (!resp) return NULL;

	CJSONValue *result = NULL;
	if (resp->status_code == 200 && resp->body) {
		result = JSONParse(resp->body);
	}

	HTTPResponseFree(resp);
	return result;
}

// Modify guild member
I64 DiscordModifyGuildMember(CDiscordClient *client, CDiscordSnowflake guild_id,
                             CDiscordSnowflake user_id, U8 *nick,
                             CDiscordSnowflake *role_ids, I64 role_count)
{
	U8 endpoint[128];
	CJSONBuilder json;
	CHTTPResponse *resp;
	I64 i;

	StrPrint(endpoint, "/guilds/%llu/members/%llu", guild_id, user_id);

	JSONBuilderInit(&json, 512);
	JSONBeginObject(&json);

	if (nick) {
		JSONKeyString(&json, "nick", nick);
	}

	if (role_ids && role_count > 0) {
		JSONKeyArray(&json, "roles");
		for (i = 0; i < role_count; i++) {
			U8 id_str[32];
			StrPrint(id_str, "%llu", role_ids[i]);
			JSONString(&json, id_str);
		}
		JSONEndArray(&json);
	}

	JSONEndObject(&json);

	resp = DiscordAPIRequest(client, HTTP_METHOD_PATCH, endpoint, JSONBuilderGet(&json));
	JSONBuilderFree(&json);

	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 200 || status == 204) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

