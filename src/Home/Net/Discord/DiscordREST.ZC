// Ban member
I64 DiscordBanMember(CDiscordClient *client, CDiscordSnowflake guild_id,
                     CDiscordSnowflake user_id, I64 delete_message_days)
{
	U8 endpoint[128];
	CJSONBuilder json;
	CHTTPResponse *resp;

	StrPrint(endpoint, "/guilds/%llu/bans/%llu", guild_id, user_id);

	JSONBuilderInit(&json, 64);
	JSONBeginObject(&json);
	if (delete_message_days > 0 && delete_message_days <= 7) {
		JSONKeyInt(&json, "delete_message_days", delete_message_days);
	}
	JSONEndObject(&json);

	resp = DiscordAPIRequest(client, HTTP_METHOD_PUT, endpoint, JSONBuilderGet(&json));
	JSONBuilderFree(&json);

	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 204) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

