// ============================================================================
// REACTION ENDPOINTS
// ============================================================================

// URL encode emoji for reactions
// Unicode emoji: URL encode as-is
// Custom emoji: name:id format
U0 DiscordEncodeEmoji(U8 *emoji_str, U8 *encoded, CDiscordSnowflake custom_id)
{
	if (custom_id > 0) {
		// Custom emoji: name:id
		StrPrint(encoded, "%s:%llu", emoji_str, custom_id);
	} else {
		// Unicode emoji - URL encode
		// For simplicity, we just copy it (most emojis work directly)
		StrCpy(encoded, emoji_str);
	}
}

// Add reaction to message
I64 DiscordAddReaction(CDiscordClient *client, CDiscordSnowflake channel_id,
                       CDiscordSnowflake message_id, U8 *emoji, CDiscordSnowflake custom_id)
{
	U8 endpoint[192];
	U8 encoded_emoji[64];
	CHTTPResponse *resp;

	DiscordEncodeEmoji(emoji, encoded_emoji, custom_id);
	StrPrint(endpoint, "/channels/%llu/messages/%llu/reactions/%s/@me",
	         channel_id, message_id, encoded_emoji);

	resp = DiscordAPIRequest(client, HTTP_METHOD_PUT, endpoint, NULL);
	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 204) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

