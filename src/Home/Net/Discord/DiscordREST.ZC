// Bulk delete messages (2-100 messages, not older than 2 weeks)
I64 DiscordBulkDeleteMessages(CDiscordClient *client, CDiscordSnowflake channel_id,
                              CDiscordSnowflake *message_ids, I64 count)
{
	U8 endpoint[128];
	CJSONBuilder json;
	CHTTPResponse *resp;
	I64 i;

	if (count < 2 || count > 100) return DISCORD_ERR_API_ERROR;

	StrPrint(endpoint, "/channels/%llu/messages/bulk-delete", channel_id);

	JSONBuilderInit(&json, 512);
	JSONBeginObject(&json);
	JSONKeyArray(&json, "messages");
	for (i = 0; i < count; i++) {
		U8 id_str[32];
		StrPrint(id_str, "%llu", message_ids[i]);
		JSONString(&json, id_str);
	}
	JSONEndArray(&json);
	JSONEndObject(&json);

	resp = DiscordAPIRequest(client, HTTP_METHOD_POST, endpoint, JSONBuilderGet(&json));
	JSONBuilderFree(&json);

	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 204) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

