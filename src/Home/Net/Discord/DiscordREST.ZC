// Get users who reacted with emoji
CJSONValue *DiscordGetReactions(CDiscordClient *client, CDiscordSnowflake channel_id,
                                CDiscordSnowflake message_id, U8 *emoji,
                                CDiscordSnowflake custom_id, I64 limit)
{
	U8 endpoint[192];
	U8 encoded_emoji[64];
	CHTTPResponse *resp;

	DiscordEncodeEmoji(emoji, encoded_emoji, custom_id);

	if (limit > 0) {
		StrPrint(endpoint, "/channels/%llu/messages/%llu/reactions/%s?limit=%d",
		         channel_id, message_id, encoded_emoji, limit);
	} else {
		StrPrint(endpoint, "/channels/%llu/messages/%llu/reactions/%s",
		         channel_id, message_id, encoded_emoji);
	}

	resp = DiscordAPIRequest(client, HTTP_METHOD_GET, endpoint, NULL);
	if (!resp) return NULL;

	CJSONValue *result = NULL;
	if (resp->status_code == 200 && resp->body) {
		result = JSONParse(resp->body);
	}

	HTTPResponseFree(resp);
	return result;
}

