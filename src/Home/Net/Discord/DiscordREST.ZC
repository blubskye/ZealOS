// DiscordREST.ZC - Extended Discord REST API for ZealOS
// Part of ZealOS Discord implementation
// Provides comprehensive REST API coverage for channels, guilds, reactions, etc.

// ============================================================================
// CHANNEL ENDPOINTS
// ============================================================================

// Get channel information
CJSONValue *DiscordGetChannel(CDiscordClient *client, CDiscordSnowflake channel_id)
{
	U8 endpoint[64];
	CHTTPResponse *resp;

	StrPrint(endpoint, "/channels/%llu", channel_id);

	resp = DiscordAPIRequest(client, HTTP_METHOD_GET, endpoint, NULL);
	if (!resp) return NULL;

	CJSONValue *result = NULL;
	if (resp->status_code == 200 && resp->body) {
		result = JSONParse(resp->body);
	}

	HTTPResponseFree(resp);
	return result;
}

// Modify channel
I64 DiscordModifyChannel(CDiscordClient *client, CDiscordSnowflake channel_id,
                         U8 *name, U8 *topic)
{
	U8 endpoint[64];
	CJSONBuilder json;
	CHTTPResponse *resp;

	StrPrint(endpoint, "/channels/%llu", channel_id);

	JSONBuilderInit(&json, 256);
	JSONBeginObject(&json);
	if (name) {
		JSONKeyString(&json, "name", name);
	}
	if (topic) {
		JSONKeyString(&json, "topic", topic);
	}
	JSONEndObject(&json);

	resp = DiscordAPIRequest(client, HTTP_METHOD_PATCH, endpoint, JSONBuilderGet(&json));
	JSONBuilderFree(&json);

	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 200) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

// Delete channel
I64 DiscordDeleteChannel(CDiscordClient *client, CDiscordSnowflake channel_id)
{
	U8 endpoint[64];
	CHTTPResponse *resp;

	StrPrint(endpoint, "/channels/%llu", channel_id);

	resp = DiscordAPIRequest(client, HTTP_METHOD_DELETE, endpoint, NULL);
	if (!resp) return DISCORD_ERR_API_ERROR;

	I64 status = resp->status_code;
	HTTPResponseFree(resp);

	return (status == 200) ? DISCORD_OK : DISCORD_ERR_API_ERROR;
}

// Get messages from channel
// Returns JSON array of messages, caller must free with JSONValueFree
CJSONValue *DiscordGetMessages(CDiscordClient *client, CDiscordSnowflake channel_id,
                               I64 limit, CDiscordSnowflake before, CDiscordSnowflake after)
{
	U8 endpoint[128];
	CHTTPResponse *resp;
	I64 offset = 0;

	offset += StrPrint(endpoint + offset, "/channels/%llu/messages?", channel_id);

	if (limit > 0) {
		offset += StrPrint(endpoint + offset, "limit=%d", limit);
	}
	if (before > 0) {
		if (limit > 0) offset += StrPrint(endpoint + offset, "&");
		offset += StrPrint(endpoint + offset, "before=%llu", before);
	}
	if (after > 0) {
		if (limit > 0 || before > 0) offset += StrPrint(endpoint + offset, "&");
		offset += StrPrint(endpoint + offset, "after=%llu", after);
	}

	resp = DiscordAPIRequest(client, HTTP_METHOD_GET, endpoint, NULL);
	if (!resp) return NULL;

	CJSONValue *result = NULL;
	if (resp->status_code == 200 && resp->body) {
		result = JSONParse(resp->body);
	}

	HTTPResponseFree(resp);
	return result;
}

