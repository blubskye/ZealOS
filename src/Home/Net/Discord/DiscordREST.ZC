// Create DM channel
CJSONValue *DiscordCreateDM(CDiscordClient *client, CDiscordSnowflake user_id)
{
	CJSONBuilder json;
	CHTTPResponse *resp;
	U8 id_str[32];

	JSONBuilderInit(&json, 64);
	JSONBeginObject(&json);
	StrPrint(id_str, "%llu", user_id);
	JSONKeyString(&json, "recipient_id", id_str);
	JSONEndObject(&json);

	resp = DiscordAPIRequest(client, HTTP_METHOD_POST, "/users/@me/channels", JSONBuilderGet(&json));
	JSONBuilderFree(&json);

	if (!resp) return NULL;

	CJSONValue *result = NULL;
	if (resp->status_code == 200 && resp->body) {
		result = JSONParse(resp->body);
	}

	HTTPResponseFree(resp);
	return result;
}

