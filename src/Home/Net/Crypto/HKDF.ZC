// HKDF.ZC - HMAC-based Key Derivation Function for ZealOS
// Implementation based on RFC 5869
// https://datatracker.ietf.org/doc/html/rfc5869
//
// HKDF is used extensively in TLS 1.3 for key derivation
//
// HKDF consists of two stages:
//   1. Extract: PRK = HMAC(salt, IKM)
//   2. Expand:  OKM = HKDF-Expand(PRK, info, L)

// ============================================================================
// HKDF-EXTRACT
// ============================================================================

// Extract a pseudorandom key from input key material
// PRK = HMAC(salt, IKM)
// If salt is NULL or zero-length, a string of HashLen zeros is used
U0 HKDFExtract(U8 *salt, I64 salt_len,
               U8 *ikm, I64 ikm_len,
               U8 *prk,
               I64 hash_type)
{
	U8 zero_salt[64];  // Max hash size for SHA-384/512
	I64 hash_size;

	hash_size = HMACSize(hash_type);

	// If salt is not provided, use a string of HashLen zeros
	if (salt == NULL || salt_len == 0)
	{
		MemSet(zero_salt, 0, hash_size);
		salt = zero_salt;
		salt_len = hash_size;
	}

	// PRK = HMAC(salt, IKM)
	HMAC(salt, salt_len, ikm, ikm_len, prk, hash_type);
}

// ============================================================================
// HKDF-EXPAND
// ============================================================================

// Expand a pseudorandom key to desired length
// OKM = HKDF-Expand(PRK, info, L)
//
// T(0) = empty string
// T(1) = HMAC(PRK, T(0) || info || 0x01)
// T(2) = HMAC(PRK, T(1) || info || 0x02)
// ...
// OKM = T(1) || T(2) || ... (first L bytes)
U0 HKDFExpand(U8 *prk, I64 prk_len,
              U8 *info, I64 info_len,
              U8 *okm, I64 okm_len,
              I64 hash_type)
{
	I64 hash_size;
	I64 n;  // Number of iterations needed
	I64 i;
	I64 offset;
	I64 copy_len;
	U8 T[64];  // Previous T value (max hash size)
	U8 counter;
	CHMACContext ctx;

	hash_size = HMACSize(hash_type);

	// Calculate number of iterations: N = ceil(L / HashLen)
	n = (okm_len + hash_size - 1) / hash_size;

	// RFC 5869 limits N to 255
	if (n > 255)
	{
		NetErr("HKDF-Expand: Output too long (max %d bytes)", hash_size * 255);
		return;
	}

	offset = 0;
	for (i = 1; i <= n; i++)
	{
		counter = i;

		HMACInit(&ctx, prk, prk_len, hash_type);

		// T(i) = HMAC(PRK, T(i-1) || info || counter)
		if (i > 1)
		{
			// Include previous T value
			HMACUpdate(&ctx, T, hash_size);
		}

		if (info != NULL && info_len > 0)
		{
			HMACUpdate(&ctx, info, info_len);
		}

		HMACUpdate(&ctx, &counter, 1);
		HMACFinal(&ctx, T);

		// Copy to output (may be partial on last iteration)
		copy_len = okm_len - offset;
		if (copy_len > hash_size)
			copy_len = hash_size;

		MemCopy(okm + offset, T, copy_len);
		offset += copy_len;
	}

	// Clear sensitive data
	CryptoSecureZero(T, hash_size);
}

// ============================================================================
// HKDF (Combined Extract-and-Expand)
// ============================================================================

U0 HKDF(U8 *salt, I64 salt_len,
        U8 *ikm, I64 ikm_len,
        U8 *info, I64 info_len,
        U8 *okm, I64 okm_len,
        I64 hash_type)
{
	U8 prk[64];  // Max PRK size for SHA-384
	I64 hash_size;

	hash_size = HMACSize(hash_type);

	// Extract
	HKDFExtract(salt, salt_len, ikm, ikm_len, prk, hash_type);

	// Expand
	HKDFExpand(prk, hash_size, info, info_len, okm, okm_len, hash_type);

	// Clear PRK
	CryptoSecureZero(prk, hash_size);
}

// ============================================================================
// TLS 1.3 SPECIFIC FUNCTIONS
// ============================================================================

// TLS 1.3 uses HKDF-Expand-Label for key derivation
// HKDF-Expand-Label(Secret, Label, Context, Length) =
//     HKDF-Expand(Secret, HkdfLabel, Length)
//
// Where HkdfLabel is:
//   struct {
//       uint16 length = Length;
//       opaque label<7..255> = "tls13 " + Label;
//       opaque context<0..255> = Context;
//   } HkdfLabel;

U0 HKDFExpandLabel(U8 *secret, I64 secret_len,
                   U8 *label, I64 label_len,
                   U8 *context, I64 context_len,
                   U8 *output, I64 output_len,
                   I64 hash_type)
{
	U8 hkdf_label[512];
	I64 hkdf_label_len;
	I64 pos;

	// Validate lengths
	if (label_len > 248)  // 255 - 7 ("tls13 ")
	{
		NetErr("HKDF-Expand-Label: Label too long");
		return;
	}
	if (context_len > 255)
	{
		NetErr("HKDF-Expand-Label: Context too long");
		return;
	}

	pos = 0;

	// Length (2 bytes, big-endian)
	hkdf_label[pos++] = (output_len >> 8) & 0xFF;
	hkdf_label[pos++] = output_len & 0xFF;

	// Label: length prefix + "tls13 " + label
	hkdf_label[pos++] = 6 + label_len;  // Length of "tls13 " + label
	MemCopy(hkdf_label + pos, "tls13 ", 6);
	pos += 6;
	if (label_len > 0)
	{
		MemCopy(hkdf_label + pos, label, label_len);
		pos += label_len;
	}

	// Context: length prefix + context
	hkdf_label[pos++] = context_len;
	if (context_len > 0)
	{
		MemCopy(hkdf_label + pos, context, context_len);
		pos += context_len;
	}

	hkdf_label_len = pos;

	// Expand
	HKDFExpand(secret, secret_len, hkdf_label, hkdf_label_len, output, output_len, hash_type);

	// Clear label buffer
	CryptoSecureZero(hkdf_label, hkdf_label_len);
}

// TLS 1.3 Derive-Secret function
// Derive-Secret(Secret, Label, Messages) =
//     HKDF-Expand-Label(Secret, Label, Transcript-Hash(Messages), Hash.length)
U0 TLSDeriveSecret(U8 *secret, I64 secret_len,
                   U8 *label, I64 label_len,
                   U8 *transcript_hash, I64 hash_len,
                   U8 *output,
                   I64 hash_type)
{
	HKDFExpandLabel(secret, secret_len,
	                label, label_len,
	                transcript_hash, hash_len,
	                output, hash_len,
	                hash_type);
}

// ============================================================================
// HKDF TEST VECTORS (RFC 5869)
// ============================================================================

U0 HKDFTest()
{
	U8 prk[64];
	U8 okm[128];
	U8 expected[128];
	I64 i;
	Bool pass;

	"$$LTBLUE$$HKDF Test Vectors (RFC 5869):$$FG$$\n\n";

	// Test Case 1: Basic HKDF-SHA256
	"Test 1: HKDF-SHA256 basic case\n";

	// IKM  = 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b (22 bytes)
	// Salt = 0x000102030405060708090a0b0c (13 bytes)
	// Info = 0xf0f1f2f3f4f5f6f7f8f9 (10 bytes)
	// L    = 42

	U8 ikm1[22];
	U8 salt1[13];
	U8 info1[10];

	MemSet(ikm1, 0x0B, 22);
	for (i = 0; i < 13; i++)
		salt1[i] = i;
	for (i = 0; i < 10; i++)
		info1[i] = 0xF0 + i;

	// First test Extract
	HKDFExtract(salt1, 13, ikm1, 22, prk, HASH_SHA256);

	// Expected PRK: 077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5
	"  PRK:      ";
	for (i = 0; i < 32; i++)
		"%02X", prk[i];
	"\n";

	expected[0]  = 0x07; expected[1]  = 0x77; expected[2]  = 0x09; expected[3]  = 0x36;
	expected[4]  = 0x2C; expected[5]  = 0x2E; expected[6]  = 0x32; expected[7]  = 0xDF;
	expected[8]  = 0x0D; expected[9]  = 0xDC; expected[10] = 0x3F; expected[11] = 0x0D;
	expected[12] = 0xC4; expected[13] = 0x7B; expected[14] = 0xBA; expected[15] = 0x63;
	expected[16] = 0x90; expected[17] = 0xB6; expected[18] = 0xC7; expected[19] = 0x3B;
	expected[20] = 0xB5; expected[21] = 0x0F; expected[22] = 0x9C; expected[23] = 0x31;
	expected[24] = 0x22; expected[25] = 0xEC; expected[26] = 0x84; expected[27] = 0x4A;
	expected[28] = 0xD7; expected[29] = 0xC2; expected[30] = 0xB3; expected[31] = 0xE5;

	pass = TRUE;
	for (i = 0; i < 32; i++)
	{
		if (prk[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}
	if (pass)
		"  PRK:      $$GREEN$$PASS$$FG$$\n";
	else
		"  PRK:      $$RED$$FAIL$$FG$$\n";

	// Test Expand
	HKDFExpand(prk, 32, info1, 10, okm, 42, HASH_SHA256);

	// Expected OKM (42 bytes):
	// 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf
	// 34007208d5b887185865
	expected[0]  = 0x3C; expected[1]  = 0xB2; expected[2]  = 0x5F; expected[3]  = 0x25;
	expected[4]  = 0xFA; expected[5]  = 0xAC; expected[6]  = 0xD5; expected[7]  = 0x7A;
	expected[8]  = 0x90; expected[9]  = 0x43; expected[10] = 0x4F; expected[11] = 0x64;
	expected[12] = 0xD0; expected[13] = 0x36; expected[14] = 0x2F; expected[15] = 0x2A;
	expected[16] = 0x2D; expected[17] = 0x2D; expected[18] = 0x0A; expected[19] = 0x90;
	expected[20] = 0xCF; expected[21] = 0x1A; expected[22] = 0x5A; expected[23] = 0x4C;
	expected[24] = 0x5D; expected[25] = 0xB0; expected[26] = 0x2D; expected[27] = 0x56;
	expected[28] = 0xEC; expected[29] = 0xC4; expected[30] = 0xC5; expected[31] = 0xBF;
	expected[32] = 0x34; expected[33] = 0x00; expected[34] = 0x72; expected[35] = 0x08;
	expected[36] = 0xD5; expected[37] = 0xB8; expected[38] = 0x87; expected[39] = 0x18;
	expected[40] = 0x58; expected[41] = 0x65;

	pass = TRUE;
	for (i = 0; i < 42; i++)
	{
		if (okm[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  OKM:      ";
	for (i = 0; i < 42; i++)
		"%02X", okm[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 42; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test Case 2: HKDF with longer inputs
	"Test 2: HKDF-SHA256 with longer inputs (L=82)\n";

	// IKM = 80 bytes of 0x00-0x4f
	// Salt = 80 bytes of 0x60-0xaf
	// Info = 80 bytes of 0xb0-0xff
	// L = 82

	U8 ikm2[80];
	U8 salt2[80];
	U8 info2[80];

	for (i = 0; i < 80; i++)
	{
		ikm2[i]  = i;
		salt2[i] = 0x60 + i;
		info2[i] = 0xB0 + i;
	}

	HKDF(salt2, 80, ikm2, 80, info2, 80, okm, 82, HASH_SHA256);

	// Expected OKM (82 bytes):
	// b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c
	// 59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71
	// cc30c58179ec3e87c14c01d5c1f3434f1d87
	expected[0]  = 0xB1; expected[1]  = 0x1E; expected[2]  = 0x39; expected[3]  = 0x8D;
	expected[4]  = 0xC8; expected[5]  = 0x03; expected[6]  = 0x27; expected[7]  = 0xA1;
	expected[8]  = 0xC8; expected[9]  = 0xE7; expected[10] = 0xF7; expected[11] = 0x8C;
	expected[12] = 0x59; expected[13] = 0x6A; expected[14] = 0x49; expected[15] = 0x34;
	expected[16] = 0x4F; expected[17] = 0x01; expected[18] = 0x2E; expected[19] = 0xDA;
	expected[20] = 0x2D; expected[21] = 0x4E; expected[22] = 0xFA; expected[23] = 0xD8;
	expected[24] = 0xA0; expected[25] = 0x50; expected[26] = 0xCC; expected[27] = 0x4C;
	expected[28] = 0x19; expected[29] = 0xAF; expected[30] = 0xA9; expected[31] = 0x7C;
	expected[32] = 0x59; expected[33] = 0x04; expected[34] = 0x5A; expected[35] = 0x99;
	expected[36] = 0xCA; expected[37] = 0xC7; expected[38] = 0x82; expected[39] = 0x72;
	expected[40] = 0x71; expected[41] = 0xCB; expected[42] = 0x41; expected[43] = 0xC6;
	expected[44] = 0x5E; expected[45] = 0x59; expected[46] = 0x0E; expected[47] = 0x09;
	expected[48] = 0xDA; expected[49] = 0x32; expected[50] = 0x75; expected[51] = 0x60;
	expected[52] = 0x0C; expected[53] = 0x2F; expected[54] = 0x09; expected[55] = 0xB8;
	expected[56] = 0x36; expected[57] = 0x77; expected[58] = 0x93; expected[59] = 0xA9;
	expected[60] = 0xAC; expected[61] = 0xA3; expected[62] = 0xDB; expected[63] = 0x71;
	expected[64] = 0xCC; expected[65] = 0x30; expected[66] = 0xC5; expected[67] = 0x81;
	expected[68] = 0x79; expected[69] = 0xEC; expected[70] = 0x3E; expected[71] = 0x87;
	expected[72] = 0xC1; expected[73] = 0x4C; expected[74] = 0x01; expected[75] = 0xD5;
	expected[76] = 0xC1; expected[77] = 0xF3; expected[78] = 0x43; expected[79] = 0x4F;
	expected[80] = 0x1D; expected[81] = 0x87;

	pass = TRUE;
	for (i = 0; i < 82; i++)
	{
		if (okm[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 82; i++)
		"%02X", okm[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test Case 3: HKDF with zero-length salt and info
	"Test 3: HKDF-SHA256 with zero-length salt and info\n";

	// IKM  = 0x0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b (22 bytes)
	// Salt = (none)
	// Info = (none)
	// L    = 42

	HKDF(NULL, 0, ikm1, 22, NULL, 0, okm, 42, HASH_SHA256);

	// Expected OKM (42 bytes):
	// 8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d
	// 9d201395faa4b61a96c8
	expected[0]  = 0x8D; expected[1]  = 0xA4; expected[2]  = 0xE7; expected[3]  = 0x75;
	expected[4]  = 0xA5; expected[5]  = 0x63; expected[6]  = 0xC1; expected[7]  = 0x8F;
	expected[8]  = 0x71; expected[9]  = 0x5F; expected[10] = 0x80; expected[11] = 0x2A;
	expected[12] = 0x06; expected[13] = 0x3C; expected[14] = 0x5A; expected[15] = 0x31;
	expected[16] = 0xB8; expected[17] = 0xA1; expected[18] = 0x1F; expected[19] = 0x5C;
	expected[20] = 0x5E; expected[21] = 0xE1; expected[22] = 0x87; expected[23] = 0x9E;
	expected[24] = 0xC3; expected[25] = 0x45; expected[26] = 0x4E; expected[27] = 0x5F;
	expected[28] = 0x3C; expected[29] = 0x73; expected[30] = 0x8D; expected[31] = 0x2D;
	expected[32] = 0x9D; expected[33] = 0x20; expected[34] = 0x13; expected[35] = 0x95;
	expected[36] = 0xFA; expected[37] = 0xA4; expected[38] = 0xB6; expected[39] = 0x1A;
	expected[40] = 0x96; expected[41] = 0xC8;

	pass = TRUE;
	for (i = 0; i < 42; i++)
	{
		if (okm[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 42; i++)
		"%02X", okm[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 42; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	"HKDF tests complete.\n";
}
