	0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694,
	0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65,
	0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5,
	0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4,
	0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x06CA6351E003826F, 0x142929670A0E6E70,
	0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF,
	0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B,
	0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30,
	0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8,
	0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8,
	0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3,
	0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC,
	0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B,
	0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178,
	0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B,
	0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C,
	0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817
};

// ============================================================================
// SHA-512 HELPER FUNCTIONS
// ============================================================================

// Logical functions for SHA-512
#define SHA512_CH(x, y, z)  (((x) & (y)) ^ (~(x) & (z)))
#define SHA512_MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
#define SHA512_EP0(x)       (ROTR64(x, 28) ^ ROTR64(x, 34) ^ ROTR64(x, 39))
#define SHA512_EP1(x)       (ROTR64(x, 14) ^ ROTR64(x, 18) ^ ROTR64(x, 41))
#define SHA512_SIG0(x)      (ROTR64(x, 1) ^ ROTR64(x, 8) ^ ((x) >> 7))
#define SHA512_SIG1(x)      (ROTR64(x, 19) ^ ROTR64(x, 61) ^ ((x) >> 6))

// ============================================================================
// SHA-512 TRANSFORM (process one 128-byte block)
// ============================================================================

U0 SHA512Transform(CSHA512Context *ctx, U8 *block)
{
	U64 a, b, c, d, e, f, g, h;
	U64 t1, t2;
	U64 w[80];
	I64 i;

	// Prepare the message schedule
	for (i = 0; i < 16; i++)
	{
		w[i] = BE64_LOAD(block + i * 8);
	}
	for (i = 16; i < 80; i++)
	{
		w[i] = SHA512_SIG1(w[i - 2]) + w[i - 7] + SHA512_SIG0(w[i - 15]) + w[i - 16];
	}

	// Initialize working variables
	a = ctx->state[0];
	b = ctx->state[1];
	c = ctx->state[2];
	d = ctx->state[3];
	e = ctx->state[4];
	f = ctx->state[5];
	g = ctx->state[6];
	h = ctx->state[7];

	// Main loop (80 rounds)
	for (i = 0; i < 80; i++)
	{
		t1 = h + SHA512_EP1(e) + SHA512_CH(e, f, g) + sha512_k[i] + w[i];
		t2 = SHA512_EP0(a) + SHA512_MAJ(a, b, c);
		h = g;
		g = f;
		f = e;
		e = d + t1;
		d = c;
		c = b;
		b = a;
		a = t1 + t2;
	}

	// Add compressed chunk to current hash value
	ctx->state[0] += a;
	ctx->state[1] += b;
	ctx->state[2] += c;
	ctx->state[3] += d;
	ctx->state[4] += e;
	ctx->state[5] += f;
	ctx->state[6] += g;
	ctx->state[7] += h;
}

// ============================================================================
// SHA-512 PUBLIC API
// ============================================================================

// Initialize SHA-512 context
U0 SHA512Init(CSHA512Context *ctx)
{
	I64 i;
	for (i = 0; i < 8; i++)
		ctx->state[i] = sha512_h0[i];
	ctx->count_lo = 0;
	ctx->count_hi = 0;
	ctx->buffer_len = 0;
}

// Update hash with data
U0 SHA512Update(CSHA512Context *ctx, U8 *data, I64 length)
{
	I64 fill;

	if (length == 0)
		return;

	// Process any data remaining in buffer
	if (ctx->buffer_len > 0)
	{
		fill = SHA512_BLOCK_SIZE - ctx->buffer_len;
		if (length < fill)
		{
			MemCopy(ctx->buffer + ctx->buffer_len, data, length);
			ctx->buffer_len += length;
			return;
		}
		MemCopy(ctx->buffer + ctx->buffer_len, data, fill);
		SHA512Transform(ctx, ctx->buffer);
		ctx->count_lo += SHA512_BLOCK_SIZE * 8;
		if (ctx->count_lo < SHA512_BLOCK_SIZE * 8)
			ctx->count_hi++;  // Overflow
		data += fill;
		length -= fill;
		ctx->buffer_len = 0;
	}

	// Process full blocks
	while (length >= SHA512_BLOCK_SIZE)
	{
		SHA512Transform(ctx, data);
		ctx->count_lo += SHA512_BLOCK_SIZE * 8;
		if (ctx->count_lo < SHA512_BLOCK_SIZE * 8)
			ctx->count_hi++;  // Overflow
		data += SHA512_BLOCK_SIZE;
		length -= SHA512_BLOCK_SIZE;
	}

	// Store remaining data in buffer
	if (length > 0)
	{
		MemCopy(ctx->buffer, data, length);
		ctx->buffer_len = length;
	}
}

// Finalize SHA-512 and output digest
U0 SHA512Final(CSHA512Context *ctx, U8 *digest)
{
	U64 total_bits_lo, total_bits_hi;
	I64 pad_len;
	U8 pad[144];  // Maximum padding: 128 + 16 bytes
	I64 i;

	// Calculate total bits processed
	total_bits_lo = ctx->count_lo + (ctx->buffer_len * 8);
	total_bits_hi = ctx->count_hi;
	if (total_bits_lo < ctx->buffer_len * 8)
		total_bits_hi++;  // Overflow

	// Determine padding length
	// We need: buffer_len + pad_len + 16 = 128 (or 256 if buffer_len >= 112)
	if (ctx->buffer_len < 112)
		pad_len = 112 - ctx->buffer_len;
	else
		pad_len = 240 - ctx->buffer_len;  // Need extra block

	// Create padding: 0x80 followed by zeros, then 128-bit length
	MemSet(pad, 0, pad_len + 16);
	pad[0] = 0x80;

	// Append length in bits (big-endian, 128-bit)
	BE64_STORE(pad + pad_len, total_bits_hi);
	BE64_STORE(pad + pad_len + 8, total_bits_lo);

	// Process final block(s)
	SHA512Update(ctx, pad, pad_len + 16);

	// Output hash (big-endian)
	for (i = 0; i < 8; i++)
	{
		BE64_STORE(digest + i * 8, ctx->state[i]);
	}

	// Clear sensitive data
	CryptoSecureZero(ctx, sizeof(CSHA512Context));
}

// One-shot SHA-512 hash function
U0 SHA512(U8 *data, I64 length, U8 *digest)
{
	CSHA512Context ctx;
	SHA512Init(&ctx);
	SHA512Update(&ctx, data, length);
	SHA512Final(&ctx, digest);
}

// ============================================================================
// SHA-384 PUBLIC API
// ============================================================================

// Initialize SHA-384 context
U0 SHA384Init(CSHA512Context *ctx)
{
	I64 i;
	for (i = 0; i < 8; i++)
		ctx->state[i] = sha384_h0[i];
	ctx->count_lo = 0;
	ctx->count_hi = 0;
	ctx->buffer_len = 0;
}

// Update SHA-384 (same as SHA-512)
U0 SHA384Update(CSHA512Context *ctx, U8 *data, I64 length)
{
	SHA512Update(ctx, data, length);
}

// Finalize SHA-384 and output digest (truncated to 384 bits)
U0 SHA384Final(CSHA512Context *ctx, U8 *digest)
{
	U8 full_digest[64];
	SHA512Final(ctx, full_digest);
	// SHA-384 output is first 48 bytes of SHA-512 output
	MemCopy(digest, full_digest, 48);
	CryptoSecureZero(full_digest, 64);
}

// One-shot SHA-384 hash function
U0 SHA384(U8 *data, I64 length, U8 *digest)
{
	CSHA512Context ctx;
	SHA384Init(&ctx);
	SHA384Update(&ctx, data, length);
	SHA384Final(&ctx, digest);
}

// ============================================================================
// SHA-512/384 TEST VECTORS
// ============================================================================

U0 SHA512Test()
{
	U8 digest[64];
	U8 expected[64];
	I64 i;
	Bool pass;

	"$$LTBLUE$$SHA-512 Test Vectors:$$FG$$\n\n";

	// Test 1: SHA-512("abc")
	"Test 1: SHA512(\"abc\")\n";
	SHA512("abc", 3, digest);

	// Expected: DDAF35A1 93617ABA CC417349 AE204131 12E6FA4E 89A97EA2 0A9EEEE6 4B55D39A
	//           2192992A 274FC1A8 36BA3C23 A3FEEBBD 454D4423 643CE80E 2A9AC94F A54CA49F
	expected[0]  = 0xDD; expected[1]  = 0xAF; expected[2]  = 0x35; expected[3]  = 0xA1;
	expected[4]  = 0x93; expected[5]  = 0x61; expected[6]  = 0x7A; expected[7]  = 0xBA;
	expected[8]  = 0xCC; expected[9]  = 0x41; expected[10] = 0x73; expected[11] = 0x49;
	expected[12] = 0xAE; expected[13] = 0x20; expected[14] = 0x41; expected[15] = 0x31;
	expected[16] = 0x12; expected[17] = 0xE6; expected[18] = 0xFA; expected[19] = 0x4E;
	expected[20] = 0x89; expected[21] = 0xA9; expected[22] = 0x7E; expected[23] = 0xA2;
	expected[24] = 0x0A; expected[25] = 0x9E; expected[26] = 0xEE; expected[27] = 0xE6;
	expected[28] = 0x4B; expected[29] = 0x55; expected[30] = 0xD3; expected[31] = 0x9A;
	expected[32] = 0x21; expected[33] = 0x92; expected[34] = 0x99; expected[35] = 0x2A;
	expected[36] = 0x27; expected[37] = 0x4F; expected[38] = 0xC1; expected[39] = 0xA8;
	expected[40] = 0x36; expected[41] = 0xBA; expected[42] = 0x3C; expected[43] = 0x23;
	expected[44] = 0xA3; expected[45] = 0xFE; expected[46] = 0xEB; expected[47] = 0xBD;
	expected[48] = 0x45; expected[49] = 0x4D; expected[50] = 0x44; expected[51] = 0x23;
	expected[52] = 0x64; expected[53] = 0x3C; expected[54] = 0xE8; expected[55] = 0x0E;
	expected[56] = 0x2A; expected[57] = 0x9A; expected[58] = 0xC9; expected[59] = 0x4F;
	expected[60] = 0xA5; expected[61] = 0x4C; expected[62] = 0xA4; expected[63] = 0x9F;

	pass = TRUE;
	for (i = 0; i < 64; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 64; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 64; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test 2: SHA-512("")
	"Test 2: SHA512(\"\")\n";
	SHA512("", 0, digest);

	// Expected: CF83E135 7EEFB8BD F1542850 D66D8007 D620E405 0B5715DC 83F4A921 D36CE9CE
	//           47D0D13C 5D85F2B0 FF8318D2 877EEC2F 63B931BD 47417A81 A538327A F927DA3E
	expected[0]  = 0xCF; expected[1]  = 0x83; expected[2]  = 0xE1; expected[3]  = 0x35;
	expected[4]  = 0x7E; expected[5]  = 0xEF; expected[6]  = 0xB8; expected[7]  = 0xBD;
	expected[8]  = 0xF1; expected[9]  = 0x54; expected[10] = 0x28; expected[11] = 0x50;
	expected[12] = 0xD6; expected[13] = 0x6D; expected[14] = 0x80; expected[15] = 0x07;
	expected[16] = 0xD6; expected[17] = 0x20; expected[18] = 0xE4; expected[19] = 0x05;
	expected[20] = 0x0B; expected[21] = 0x57; expected[22] = 0x15; expected[23] = 0xDC;
	expected[24] = 0x83; expected[25] = 0xF4; expected[26] = 0xA9; expected[27] = 0x21;
	expected[28] = 0xD3; expected[29] = 0x6C; expected[30] = 0xE9; expected[31] = 0xCE;
	expected[32] = 0x47; expected[33] = 0xD0; expected[34] = 0xD1; expected[35] = 0x3C;
	expected[36] = 0x5D; expected[37] = 0x85; expected[38] = 0xF2; expected[39] = 0xB0;
	expected[40] = 0xFF; expected[41] = 0x83; expected[42] = 0x18; expected[43] = 0xD2;
	expected[44] = 0x87; expected[45] = 0x7E; expected[46] = 0xEC; expected[47] = 0x2F;
	expected[48] = 0x63; expected[49] = 0xB9; expected[50] = 0x31; expected[51] = 0xBD;
	expected[52] = 0x47; expected[53] = 0x41; expected[54] = 0x7A; expected[55] = 0x81;
	expected[56] = 0xA5; expected[57] = 0x38; expected[58] = 0x32; expected[59] = 0x7A;
	expected[60] = 0xF9; expected[61] = 0x27; expected[62] = 0xDA; expected[63] = 0x3E;

	pass = TRUE;
	for (i = 0; i < 64; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 64; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 64; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	"SHA-512 tests complete.\n\n";
}

U0 SHA384Test()
{
	U8 digest[48];
	U8 expected[48];
	I64 i;
	Bool pass;

	"$$LTBLUE$$SHA-384 Test Vectors:$$FG$$\n\n";

	// Test 1: SHA-384("abc")
	"Test 1: SHA384(\"abc\")\n";
	SHA384("abc", 3, digest);

	// Expected: CB00753F 45A35E8B B5A03D69 9AC65007 272C32AB 0EDED163
