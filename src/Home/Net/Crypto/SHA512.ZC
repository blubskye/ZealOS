// SHA512.ZC - SHA-512 and SHA-384 Hash Functions for ZealOS
// Implementation based on FIPS 180-4
// https://csrc.nist.gov/publications/detail/fips/180/4/final
//
// SHA-384 is SHA-512 with different initial values and truncated output

// ============================================================================
// SHA-512 CONSTANTS
// ============================================================================

// Initial hash values for SHA-512
// (first 64 bits of fractional parts of square roots of first 8 primes)
U64 sha512_h0[8] = {
	0x6A09E667F3BCC908, 0xBB67AE8584CAA73B,
	0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1,
	0x510E527FADE682D1, 0x9B05688C2B3E6C1F,
	0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179
};

// Initial hash values for SHA-384
// (first 64 bits of fractional parts of square roots of 9th through 16th primes)
U64 sha384_h0[8] = {
	0xCBBB9D5DC1059ED8, 0x629A292A367CD507,
	0x9159015A3070DD17, 0x152FECD8F70E5939,
	0x67332667FFC00B31, 0x8EB44A8768581511,
	0xDB0C2E0D64F98FA7, 0x47B5481DBEFA4FA4
};

// Round constants for SHA-512 (first 64 bits of fractional parts of cube roots of first 80 primes)
U64 sha512_k[80] = {
	0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC,
	0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118,
