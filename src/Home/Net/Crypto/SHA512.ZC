	expected[4]  = 0x51; expected[5]  = 0xAC; expected[6]  = 0x96; expected[7]  = 0x38;
	expected[8]  = 0x4C; expected[9]  = 0xD9; expected[10] = 0x32; expected[11] = 0x7E;
