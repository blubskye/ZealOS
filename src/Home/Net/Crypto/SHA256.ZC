// SHA256.ZC - SHA-256 Hash Function for ZealOS
// Implementation based on FIPS 180-4
// https://csrc.nist.gov/publications/detail/fips/180/4/final

// ============================================================================
// SHA-256 CONSTANTS
// ============================================================================

// Initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
U32 sha256_h0[8] = {
	0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
	0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19
};

// Round constants (first 32 bits of fractional parts of cube roots of first 64 primes)
U32 sha256_k[64] = {
	0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
	0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
	0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
	0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
	0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
	0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
	0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
	0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
	0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
	0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
	0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
	0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
	0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
	0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
	0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
	0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
};

// ============================================================================
// SHA-256 HELPER FUNCTIONS
// ============================================================================

// Logical functions for SHA-256
#define SHA256_CH(x, y, z)  (((x) & (y)) ^ (~(x) & (z)))
#define SHA256_MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
#define SHA256_EP0(x)       (ROTR32(x, 2) ^ ROTR32(x, 13) ^ ROTR32(x, 22))
#define SHA256_EP1(x)       (ROTR32(x, 6) ^ ROTR32(x, 11) ^ ROTR32(x, 25))
#define SHA256_SIG0(x)      (ROTR32(x, 7) ^ ROTR32(x, 18) ^ ((x) >> 3))
#define SHA256_SIG1(x)      (ROTR32(x, 17) ^ ROTR32(x, 19) ^ ((x) >> 10))

// ============================================================================
// SHA-256 TRANSFORM (process one 64-byte block)
// ============================================================================

U0 SHA256Transform(CSHA256Context *ctx, U8 *block)
{
	U32 a, b, c, d, e, f, g, h;
	U32 t1, t2;
	U32 w[64];
	I64 i;

	// Prepare the message schedule
	for (i = 0; i < 16; i++)
	{
		w[i] = BE32_LOAD(block + i * 4);
	}
	for (i = 16; i < 64; i++)
	{
		w[i] = SHA256_SIG1(w[i - 2]) + w[i - 7] + SHA256_SIG0(w[i - 15]) + w[i - 16];
	}

	// Initialize working variables
	a = ctx->state[0];
	b = ctx->state[1];
	c = ctx->state[2];
	d = ctx->state[3];
	e = ctx->state[4];
	f = ctx->state[5];
	g = ctx->state[6];
	h = ctx->state[7];

	// Main loop (64 rounds)
	for (i = 0; i < 64; i++)
	{
		t1 = h + SHA256_EP1(e) + SHA256_CH(e, f, g) + sha256_k[i] + w[i];
		t2 = SHA256_EP0(a) + SHA256_MAJ(a, b, c);
		h = g;
		g = f;
		f = e;
		e = d + t1;
		d = c;
		c = b;
		b = a;
		a = t1 + t2;
	}

	// Add compressed chunk to current hash value
	ctx->state[0] += a;
	ctx->state[1] += b;
	ctx->state[2] += c;
	ctx->state[3] += d;
	ctx->state[4] += e;
	ctx->state[5] += f;
	ctx->state[6] += g;
	ctx->state[7] += h;
}

// ============================================================================
// SHA-256 PUBLIC API
// ============================================================================

// Initialize SHA-256 context
U0 SHA256Init(CSHA256Context *ctx)
{
	ctx->state[0] = sha256_h0[0];
	ctx->state[1] = sha256_h0[1];
	ctx->state[2] = sha256_h0[2];
	ctx->state[3] = sha256_h0[3];
	ctx->state[4] = sha256_h0[4];
	ctx->state[5] = sha256_h0[5];
	ctx->state[6] = sha256_h0[6];
	ctx->state[7] = sha256_h0[7];
	ctx->count = 0;
	ctx->buffer_len = 0;
}

// Update hash with data
U0 SHA256Update(CSHA256Context *ctx, U8 *data, I64 length)
{
	I64 i;
	I64 fill;

	if (length == 0)
		return;

	// Process any data remaining in buffer
	if (ctx->buffer_len > 0)
	{
		fill = SHA256_BLOCK_SIZE - ctx->buffer_len;
		if (length < fill)
		{
			MemCopy(ctx->buffer + ctx->buffer_len, data, length);
			ctx->buffer_len += length;
			return;
		}
		MemCopy(ctx->buffer + ctx->buffer_len, data, fill);
		SHA256Transform(ctx, ctx->buffer);
		ctx->count += SHA256_BLOCK_SIZE * 8;
		data += fill;
		length -= fill;
		ctx->buffer_len = 0;
	}

	// Process full blocks
	while (length >= SHA256_BLOCK_SIZE)
	{
		SHA256Transform(ctx, data);
		ctx->count += SHA256_BLOCK_SIZE * 8;
		data += SHA256_BLOCK_SIZE;
		length -= SHA256_BLOCK_SIZE;
	}

	// Store remaining data in buffer
	if (length > 0)
	{
		MemCopy(ctx->buffer, data, length);
		ctx->buffer_len = length;
	}
}

// Finalize and output digest
U0 SHA256Final(CSHA256Context *ctx, U8 *digest)
{
	U64 total_bits;
	I64 pad_len;
	U8 pad[72];  // Maximum padding: 64 + 8 bytes
	I64 i;

	// Calculate total bits processed
	total_bits = ctx->count + (ctx->buffer_len * 8);

	// Determine padding length
	// We need: buffer_len + pad_len + 8 = 64 (or 128 if buffer_len >= 56)
	if (ctx->buffer_len < 56)
		pad_len = 56 - ctx->buffer_len;
	else
		pad_len = 120 - ctx->buffer_len;  // Need extra block

	// Create padding: 0x80 followed by zeros, then 64-bit length
	MemSet(pad, 0, pad_len + 8);
	pad[0] = 0x80;

	// Append length in bits (big-endian)
	BE64_STORE(pad + pad_len, total_bits);

	// Process final block(s)
	SHA256Update(ctx, pad, pad_len + 8);

	// Output hash (big-endian)
	for (i = 0; i < 8; i++)
	{
		BE32_STORE(digest + i * 4, ctx->state[i]);
	}

	// Clear sensitive data
	CryptoSecureZero(ctx, sizeof(CSHA256Context));
}

// One-shot hash function
U0 SHA256(U8 *data, I64 length, U8 *digest)
{
	CSHA256Context ctx;
	SHA256Init(&ctx);
	SHA256Update(&ctx, data, length);
	SHA256Final(&ctx, digest);
}

// ============================================================================
// SHA-256 TEST VECTORS (FIPS 180-4)
// ============================================================================

U0 SHA256Test()
{
	U8 digest[32];
	U8 expected[32];
	I64 i;
	Bool pass;

	"$$LTBLUE$$SHA-256 Test Vectors:$$FG$$\n\n";

	// Test 1: "abc"
	"Test 1: SHA256(\"abc\")\n";
	SHA256("abc", 3, digest);

	// Expected: BA7816BF 8F01CFEA 414140DE 5DAE2223 B00361A3 96177A9C B410FF61 F20015AD
	expected[0]  = 0xBA; expected[1]  = 0x78; expected[2]  = 0x16; expected[3]  = 0xBF;
	expected[4]  = 0x8F; expected[5]  = 0x01; expected[6]  = 0xCF; expected[7]  = 0xEA;
	expected[8]  = 0x41; expected[9]  = 0x41; expected[10] = 0x40; expected[11] = 0xDE;
	expected[12] = 0x5D; expected[13] = 0xAE; expected[14] = 0x22; expected[15] = 0x23;
	expected[16] = 0xB0; expected[17] = 0x03; expected[18] = 0x61; expected[19] = 0xA3;
	expected[20] = 0x96; expected[21] = 0x17; expected[22] = 0x7A; expected[23] = 0x9C;
	expected[24] = 0xB4; expected[25] = 0x10; expected[26] = 0xFF; expected[27] = 0x61;
	expected[28] = 0xF2; expected[29] = 0x00; expected[30] = 0x15; expected[31] = 0xAD;

	pass = TRUE;
	for (i = 0; i < 32; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 32; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 32; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test 2: Empty string ""
	"Test 2: SHA256(\"\")\n";
	SHA256("", 0, digest);

	// Expected: E3B0C442 98FC1C14 9AFBF4C8 996FB924 27AE41E4 649B934C A495991B 7852B855
	expected[0]  = 0xE3; expected[1]  = 0xB0; expected[2]  = 0xC4; expected[3]  = 0x42;
	expected[4]  = 0x98; expected[5]  = 0xFC; expected[6]  = 0x1C; expected[7]  = 0x14;
	expected[8]  = 0x9A; expected[9]  = 0xFB; expected[10] = 0xF4; expected[11] = 0xC8;
	expected[12] = 0x99; expected[13] = 0x6F; expected[14] = 0xB9; expected[15] = 0x24;
	expected[16] = 0x27; expected[17] = 0xAE; expected[18] = 0x41; expected[19] = 0xE4;
	expected[20] = 0x64; expected[21] = 0x9B; expected[22] = 0x93; expected[23] = 0x4C;
	expected[24] = 0xA4; expected[25] = 0x95; expected[26] = 0x99; expected[27] = 0x1B;
	expected[28] = 0x78; expected[29] = 0x52; expected[30] = 0xB8; expected[31] = 0x55;

	pass = TRUE;
	for (i = 0; i < 32; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 32; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 32; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test 3: 448 bits (56 bytes) - tests padding edge case
	"Test 3: SHA256(\"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")\n";
	SHA256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", 56, digest);

	// Expected: 248D6A61 D20638B8 E5C02693 0C3E6039 A33CE459 64FF2167 F6ECEDD4 19DB06C1
	expected[0]  = 0x24; expected[1]  = 0x8D; expected[2]  = 0x6A; expected[3]  = 0x61;
	expected[4]  = 0xD2; expected[5]  = 0x06; expected[6]  = 0x38; expected[7]  = 0xB8;
	expected[8]  = 0xE5; expected[9]  = 0xC0; expected[10] = 0x26; expected[11] = 0x93;
	expected[12] = 0x0C; expected[13] = 0x3E; expected[14] = 0x60; expected[15] = 0x39;
	expected[16] = 0xA3; expected[17] = 0x3C; expected[18] = 0xE4; expected[19] = 0x59;
	expected[20] = 0x64; expected[21] = 0xFF; expected[22] = 0x21; expected[23] = 0x67;
	expected[24] = 0xF6; expected[25] = 0xEC; expected[26] = 0xED; expected[27] = 0xD4;
	expected[28] = 0x19; expected[29] = 0xDB; expected[30] = 0x06; expected[31] = 0xC1;

	pass = TRUE;
	for (i = 0; i < 32; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 32; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 32; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	// Test 4: Multi-block update test
	"Test 4: SHA256 incremental update (\"abc\" in 3 updates)\n";
	CSHA256Context ctx;
	SHA256Init(&ctx);
	SHA256Update(&ctx, "a", 1);
	SHA256Update(&ctx, "b", 1);
	SHA256Update(&ctx, "c", 1);
	SHA256Final(&ctx, digest);

	// Should match Test 1
	expected[0]  = 0xBA; expected[1]  = 0x78; expected[2]  = 0x16; expected[3]  = 0xBF;
	expected[4]  = 0x8F; expected[5]  = 0x01; expected[6]  = 0xCF; expected[7]  = 0xEA;
	expected[8]  = 0x41; expected[9]  = 0x41; expected[10] = 0x40; expected[11] = 0xDE;
	expected[12] = 0x5D; expected[13] = 0xAE; expected[14] = 0x22; expected[15] = 0x23;
	expected[16] = 0xB0; expected[17] = 0x03; expected[18] = 0x61; expected[19] = 0xA3;
	expected[20] = 0x96; expected[21] = 0x17; expected[22] = 0x7A; expected[23] = 0x9C;
	expected[24] = 0xB4; expected[25] = 0x10; expected[26] = 0xFF; expected[27] = 0x61;
	expected[28] = 0xF2; expected[29] = 0x00; expected[30] = 0x15; expected[31] = 0xAD;

	pass = TRUE;
	for (i = 0; i < 32; i++)
	{
		if (digest[i] != expected[i])
		{
			pass = FALSE;
			break;
		}
	}

	"  Result:   ";
	for (i = 0; i < 32; i++)
		"%02X", digest[i];
	"\n";
	"  Expected: ";
	for (i = 0; i < 32; i++)
		"%02X", expected[i];
	"\n";

	if (pass)
		"  $$GREEN$$PASS$$FG$$\n\n";
	else
		"  $$RED$$FAIL$$FG$$\n\n";

	"SHA-256 tests complete.\n";
}
